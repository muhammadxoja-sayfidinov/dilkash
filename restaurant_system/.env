# ==============================================================================
# RESTORAN TIZIMI — ASOSIY SOZLAMALAR VA API TOKENLAR (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO XAVFSIZLIK VA REJIM SOZLAMALARI
# ------------------------------------------------------------------------------
# Production uchun alohida murakkab kalit o'rnating (masalan: pwgen yoki openssl orqali)
DJANGO_SECRET_KEY=django-insecure-your-secret-key-here
DJANGO_DEBUG=True

# ------------------------------------------------------------------------------
# 2. TELEGRAM BUYURTMA BOTI (Mijozlar buyurtma beradigan asosiy bot)
# ------------------------------------------------------------------------------
# @BotFather dan olingan bot tokeni (Hozirgi ulangan token):
TELEGRAM_BOT_TOKEN=1574987467:AAFvXaSfQBjagl4LmcY171Kw-gDiHco2v8Y

# Yangi buyurtmalar kelib tushadigan guruh yoki xodimlar Telegram Chat ID'lari:
# (Chat ID'ni @userinfobot orqali bilib olishingiz mumkin)
CHEF_CHAT_ID=7557043455
ADMIN_CHAT_ID=1517715653

# ------------------------------------------------------------------------------
# 3. RESTORANNING JOYLASHUVI (GPS Koordinatalari)
# ------------------------------------------------------------------------------
# Dastavka masofasi va narxini aniq hisoblash uchun Dilkash restoranining lokatsiyasi:
STORE_LAT=40.665236
STORE_LON=72.563908

# ------------------------------------------------------------------------------
# 4. TELEGRAM MINI APP (WEB APP) HAVOLASI
# ------------------------------------------------------------------------------
# start.py ishga tushganda Cloudflare yoki ngrok orqali avtomatik toza HTTPS oladi.
# Agar o'z domeningiz bo'lsa (masalan: https://dilkash.uz/menu/) bu yerga yozing:
WEB_APP_URL=http://127.0.0.1:8000/menu/

# ------------------------------------------------------------------------------
# 5. CLICK TO'LOV TIZIMI (Click Merchant API)
# ------------------------------------------------------------------------------
# Click.uz shartnomasi tuzilgach, kabinetingizdan olinadigan ma'lumotlar:
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ------------------------------------------------------------------------------
# 6. PAYME TO'LOV TIZIMI (Payme Merchant API / JSON-RPC)
# ------------------------------------------------------------------------------
# Payme Business kabinetingizdan olinadigan merchant ID va Maxfiy kalit (Key):
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
