<Application x:Class="DilkashPos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dilkash Emerald Brand Color Palette -->
        <Color x:Key="BrandPrimaryColor">#0D6B4E</Color>
        <Color x:Key="BrandDarkColor">#084935</Color>
        <Color x:Key="BrandLightColor">#E6F4EA</Color>
        <Color x:Key="AccentGoldColor">#D97706</Color>
        <Color x:Key="DangerRedColor">#EF4444</Color>
        <Color x:Key="SuccessGreenColor">#10B981</Color>
        <Color x:Key="BgDarkColor">#0F172A</Color>
        <Color x:Key="CardDarkColor">#1E293B</Color>

        <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
        <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDarkColor}" />
        <SolidColorBrush x:Key="BrandLightBrush" Color="{StaticResource BrandLightColor}" />
        <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGoldColor}" />
        <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRedColor}" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}" />
        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
        <SolidColorBrush x:Key="CardDarkBrush" Color="{StaticResource CardDarkColor}" />

        <!-- Sensorli Ekranga Mos Katta Tugma Stili (Touch Button) -->
        <Style x:Key="TouchButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Katta Sensorli Chiqish/Xavfli Tugma -->
        <Style x:Key="TouchDangerButton" TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerRedBrush}" />
        </Style>

        <!-- Oltin/Oshxona Tugmasi -->
        <Style x:Key="TouchGoldButton" TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentGoldBrush}" />
        </Style>
    </Application.Resources>
</Application>
