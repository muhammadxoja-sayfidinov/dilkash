<Application x:Class="DilkashPos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Active Theme Palette (Light Default, swappable via ThemeManager) -->
                <ResourceDictionary Source="Resources/Theme/Tokens.Light.xaml" />
                <!-- Official Dilkash Design System (Tokens -> Typography -> Icons -> Controls) -->
                <ResourceDictionary Source="Resources/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
