<UserControl x:Class="DilkashPos.Controls.CartLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DilkashPos.Controls"
             MinHeight="72">
    <Border Background="{DynamicResource BrushBg}"
            BorderBrush="{DynamicResource BrushBorderSubtle}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusSm}"
            Padding="12,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Name + Line Total -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ProductName}"
                           Style="{StaticResource TextBodyBold}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LineTotalFormatted}"
                           Style="{StaticResource TextAmount}"
                           FontSize="16"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Row 1: Optional Notes in Amber 13px -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNotes}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <local:Icon Data="{StaticResource IconEdit}" Size="13" Foreground="{DynamicResource BrushAmberBright}" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Notes}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BrushAmberBright}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Row 2: Unit Price + Note IconButton + Stepper (48px targets) -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding UnitPriceFormatted}"
                           Style="{StaticResource TextCaption}"
                           Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}"
                            Width="48" Height="48"
                            Margin="0,0,8,0"
                            ToolTip="Izoh qoʻshish"
                            Click="OnEditNoteClick">
                        <local:Icon Data="{StaticResource IconEdit}" Size="18" Foreground="{DynamicResource BrushTextSecondary}" />
                    </Button>

                    <local:Stepper x:Name="LineStepper"
                                   Value="{Binding Quantity, Mode=OneWay}"
                                   IncrementClicked="OnIncrementClick"
                                   DecrementClicked="OnDecrementClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
