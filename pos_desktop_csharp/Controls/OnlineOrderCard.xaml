<UserControl x:Class="DilkashPos.Controls.OnlineOrderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DilkashPos.Controls"
             xmlns:vm="clr-namespace:DilkashPos.ViewModels">
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            Padding="20,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Header + Customer + Items (max 3 + "+N yana") -->
            <StackPanel Grid.Column="0">
                <!-- Header row: Order # + Service pill + Source + Age Timer -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="{Binding OrderNumber}"
                               Style="{StaticResource TextTitle}"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <local:StatusPill Tone="Info"
                                      IconData="{StaticResource IconOnline}"
                                      Text="{Binding ServiceTypeLabel}"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />

                    <Border Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusFull}"
                            Padding="10,4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                    </Border>

                    <!-- Age Timer (amber >=3m, red >=7m) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:Icon Data="{StaticResource IconClock}" Size="14" Margin="0,0,5,0" VerticalAlignment="Center">
                            <local:Icon.Style>
                                <Style TargetType="{x:Type local:Icon}" BasedOn="{StaticResource {x:Type local:Icon}}">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AgeUrgency}" Value="{x:Static vm:OrderAgeUrgency.Warning}">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAmberBright}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AgeUrgency}" Value="{x:Static vm:OrderAgeUrgency.Urgent}">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushErrorBright}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:Icon.Style>
                        </local:Icon>
                        <TextBlock Text="{Binding AgeText}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextTimer}">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AgeUrgency}" Value="{x:Static vm:OrderAgeUrgency.Warning}">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAmberBright}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AgeUrgency}" Value="{x:Static vm:OrderAgeUrgency.Urgent}">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushErrorBright}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </WrapPanel>

                <!-- Customer -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                    <local:Icon Data="{StaticResource IconUser}" Size="15" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CustomerInfo}" Style="{StaticResource TextBody}" Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>

                <!-- Up to 3 Item Lines -->
                <ItemsControl ItemsSource="{Binding PreviewLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Style="{StaticResource TextBody}"
                                       Typography.NumeralAlignment="Tabular"
                                       Margin="0,0,0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- "+N yana" if >3 lines -->
                <TextBlock Text="{Binding ExtraItemsText}"
                           Foreground="{DynamicResource BrushAmberBright}"
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextLabel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasExtraItems}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Right: Total + Primary Accept Button -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="JAMI" Style="{StaticResource TextLabelCaps}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding TotalFormatted}"
                           Style="{StaticResource TextKpi}"
                           FontSize="22"
                           Foreground="{DynamicResource BrushPrimaryBright}"
                           HorizontalAlignment="Right"
                           Margin="0,2,0,12" />

                <Button Style="{StaticResource PrimaryButton}"
                        MinHeight="48"
                        Padding="18,10"
                        Click="OnAcceptClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:Icon Data="{StaticResource IconCheck}" Size="17" Foreground="{DynamicResource BrushTextOnPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Qabul qilish va chop etish" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextOnPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
