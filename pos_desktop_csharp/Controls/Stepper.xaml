<UserControl x:Class="DilkashPos.Controls.Stepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DilkashPos.Controls">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Minus / Decrement Button -->
        <Button x:Name="DecrementBtn"
                Width="44" Height="44" MinWidth="44" MinHeight="44" Padding="0"
                Style="{StaticResource SecondaryButton}"
                Click="OnDecrementClick">
            <local:Icon Data="{StaticResource IconMinus}" Size="16" />
        </Button>

        <!-- Tabular Quantity -->
        <TextBlock x:Name="QuantityText"
                   Text="1"
                   Width="32"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource TextAmount}"
                   FontWeight="SemiBold" />

        <!-- Plus / Increment Button -->
        <Button x:Name="IncrementBtn"
                Width="44" Height="44" MinWidth="44" MinHeight="44" Padding="0"
                Style="{StaticResource SecondaryButton}"
                Click="OnIncrementClick">
            <local:Icon Data="{StaticResource IconPlus}" Size="16" />
        </Button>
    </StackPanel>
</UserControl>
