<UserControl x:Class="DilkashPos.Controls.StatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DilkashPos.Controls">
    <Border x:Name="PillBorder"
            Background="{DynamicResource BrushPrimaryTint}"
            BorderBrush="{DynamicResource BrushPrimaryBright}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusFull}"
            Padding="10,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <local:Icon x:Name="PillIcon"
                        Size="14"
                        Margin="0,0,6,0"
                        Foreground="{DynamicResource BrushPrimaryBright}"
                        Visibility="Collapsed" />
            <TextBlock x:Name="PillText"
                       Style="{StaticResource TextCaption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushPrimaryBright}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
