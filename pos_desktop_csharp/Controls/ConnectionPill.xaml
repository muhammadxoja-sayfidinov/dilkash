<UserControl x:Class="DilkashPos.Controls.ConnectionPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DilkashPos.Controls">
    <Border x:Name="PillBorder"
            Background="{DynamicResource BrushPrimaryTint}"
            BorderBrush="{DynamicResource BrushPrimary}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusFull}"
            Padding="12,6"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot"
                     Width="8" Height="8"
                     Fill="{DynamicResource BrushPrimaryBright}"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center" />
            <local:Icon x:Name="StatusIcon"
                        Data="{StaticResource IconWifi}"
                        Size="15"
                        Foreground="{DynamicResource BrushPrimaryBright}"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText"
                       Text="Onlayn"
                       Style="{StaticResource TextLabel}"
                       Foreground="{DynamicResource BrushPrimaryBright}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="MetaText"
                       Text=""
                       Style="{StaticResource TextCaption}"
                       Typography.NumeralAlignment="Tabular"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
