<UserControl x:Class="DilkashPos.Controls.PrinterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DilkashPos.Controls">
    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            Padding="14,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Department Icon Plate -->
            <Border Grid.Column="0"
                    Width="44" Height="44"
                    CornerRadius="12"
                    Background="{DynamicResource BrushSurfaceElevated}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <local:Icon Size="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <local:Icon.Style>
                        <Style TargetType="{x:Type local:Icon}" BasedOn="{StaticResource {x:Type local:Icon}}">
                            <Setter Property="Data" Value="{StaticResource IconBowl}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryBright}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Code}" Value="kassa">
                                    <Setter Property="Data" Value="{StaticResource IconReceipt}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Code}" Value="shashlik">
                                    <Setter Property="Data" Value="{StaticResource IconGrill}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrushAmberBright}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Code}" Value="somsa">
                                    <Setter Property="Data" Value="{StaticResource IconChef}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrushAmberBright}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Code}" Value="fastfood">
                                    <Setter Property="Data" Value="{StaticResource IconBurger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Code}" Value="bar">
                                    <Setter Property="Data" Value="{StaticResource IconCoffee}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrushReservedText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:Icon.Style>
                </local:Icon>
            </Border>

            <!-- Name + Live Status Dot + Paper Width -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TextBodyBold}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusXs}"
                            Padding="6,1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding DepartmentLabel}" Style="{StaticResource TextCaption}" FontSize="11.5" />
                    </Border>
                    <Border Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusXs}"
                            Padding="6,1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding PaperWidthLabel}" Style="{StaticResource TextCaptionMuted}" FontSize="11.5" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="{x:Type Ellipse}">
                                <Setter Property="Fill" Value="{DynamicResource BrushErrorBright}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource BrushPrimaryBright}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusLabel}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextCaption}">
                                <Setter Property="Foreground" Value="{DynamicResource BrushErrorBright}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryBright}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Subtitle, StringFormat=' · {0}'}"
                               Style="{StaticResource TextCaptionMuted}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <!-- IP:Port Field -->
            <TextBox Grid.Column="4"
                     Text="{Binding PrinterIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="44"
                     Padding="10,7"
                     HorizontalContentAlignment="Center"
                     Typography.NumeralAlignment="Tabular"
                     VerticalAlignment="Center"
                     TextChanged="OnIpTextChanged" />

            <!-- Actions: Test Print + Edit + Delete -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Sinov cheki"
                        Style="{StaticResource SecondaryButton}"
                        MinHeight="44"
                        Padding="12,8"
                        Margin="0,0,6,0"
                        Click="OnTestPrintClick" />
                <Button Style="{StaticResource SecondaryButton}"
                        MinHeight="44"
                        Padding="10,8"
                        Margin="0,0,6,0"
                        ToolTip="Printerni tahrirlash"
                        Click="OnEditClick">
                    <local:Icon Data="{StaticResource IconEdit}" Size="16" Foreground="{DynamicResource BrushTextPrimary}" />
                </Button>
                <Button Style="{StaticResource DangerButton}"
                        MinHeight="44"
                        Padding="10,8"
                        ToolTip="Printerni oʻchirish"
                        Click="OnDeleteClick">
                    <local:Icon Data="{StaticResource IconTrash}" Size="16" Foreground="{DynamicResource BrushTextOnError}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
