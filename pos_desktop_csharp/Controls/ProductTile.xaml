<UserControl x:Class="DilkashPos.Controls.ProductTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DilkashPos.Controls"
             MinWidth="200"
             Height="152">
    <Button x:Name="TileButton"
            Click="OnTileClick"
            IsEnabled="{Binding IsAvailable}"
            Padding="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            FocusVisualStyle="{x:Null}"
            Stylus.IsPressAndHoldEnabled="False"
            Stylus.IsFlicksEnabled="False"
            Stylus.IsTapFeedbackEnabled="False"
            Stylus.IsTouchFeedbackEnabled="False">
        <Button.Template>
            <ControlTemplate TargetType="{x:Type Button}">
                <Grid RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="pressScale" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Border x:Name="cardBorder"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            ClipToBounds="True">
                        <ContentPresenter />
                    </Border>
                    <Border x:Name="focusRing"
                            Margin="-1"
                            BorderBrush="{DynamicResource BrushFocusRing}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource RadiusMd}"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasInCartQty}" Value="True">
                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimaryBright}" />
                        <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource BrushSurfaceElevated}" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}" />
                        <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource BrushSurfaceElevated}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="{StaticResource DurationPress}" EasingFunction="{StaticResource EaseOut}" />
                                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="{StaticResource DurationPress}" EasingFunction="{StaticResource EaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="{StaticResource DurationPress}" EasingFunction="{StaticResource EaseOut}" />
                                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="{StaticResource DurationPress}" EasingFunction="{StaticResource EaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="cardBorder" Property="Opacity" Value="0.52" />
                        <Setter Property="Cursor" Value="No" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="focusRing" Property="Visibility" Value="Visible" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top 16:9-style Media / Department Placeholder -->
            <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceElevated}" ClipToBounds="True">
                <Grid>
                    <!-- Department tint + monoline icon placeholder -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{DynamicResource BrushPrimaryTint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Department}" Value="shashlik">
                                        <Setter Property="Background" Value="{DynamicResource BrushAmberTintSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Department}" Value="somsa">
                                        <Setter Property="Background" Value="{DynamicResource BrushAmberTintSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Department}" Value="bar">
                                        <Setter Property="Background" Value="{DynamicResource BrushReservedTint}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <local:Icon Size="28" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9">
                            <local:Icon.Style>
                                <Style TargetType="{x:Type local:Icon}" BasedOn="{StaticResource {x:Type local:Icon}}">
                                    <Setter Property="Data" Value="{StaticResource IconBowl}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryBright}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Department}" Value="shashlik">
                                            <Setter Property="Data" Value="{StaticResource IconGrill}" />
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAmberBright}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Department}" Value="somsa">
                                            <Setter Property="Data" Value="{StaticResource IconChef}" />
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAmberBright}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Department}" Value="fastfood">
                                            <Setter Property="Data" Value="{StaticResource IconBurger}" />
                                            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryBright}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Department}" Value="bar">
                                            <Setter Property="Data" Value="{StaticResource IconCoffee}" />
                                            <Setter Property="Foreground" Value="{DynamicResource BrushReservedText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:Icon.Style>
                        </local:Icon>
                    </Border>

                    <!-- Product Image when ImageUrl is provided -->
                    <Image x:Name="ProductImage"
                           Stretch="UniformToFill"
                           ImageFailed="OnImageFailed"
                           Visibility="Collapsed" />

                    <!-- Category Tag (Top-Left) -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="7"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusXs}"
                            Padding="6,2"
                            Opacity="0.94">
                        <TextBlock Text="{Binding CategoryName}"
                                   Style="{StaticResource TextCaption}"
                                   FontSize="12"
                                   MaxWidth="126"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Quantity Badge (Top-Right when in cart) -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="7"
                            MinWidth="26" Height="24"
                            Background="{DynamicResource BrushAmber}"
                            CornerRadius="{StaticResource RadiusFull}"
                            Padding="7,1">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInCartQty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding InCartBadgeText}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextOnAmber}"
                                   Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Product Name (2 lines max, 14 SemiBold) -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Name}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       LineHeight="18"
                       MaxHeight="38"
                       Margin="10,8,10,2"
                       VerticalAlignment="Top" />

            <!-- Price + Stop-list Pill -->
            <Grid Grid.Row="2" Margin="10,0,10,10">
                <TextBlock Text="{Binding PriceFormatted}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushPrimaryBright}"
                           Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center" />

                <local:StatusPill HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Tone="Error"
                                  IconData="{StaticResource IconStop}"
                                  Text="Stop-list">
                    <local:StatusPill.Style>
                        <Style TargetType="{x:Type local:StatusPill}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStopListed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:StatusPill.Style>
                </local:StatusPill>
            </Grid>
        </Grid>
    </Button>
</UserControl>
