<UserControl x:Class="DilkashPos.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DilkashPos.Controls">
    <Grid>
        <Border x:Name="OuterBorder"
                Background="{DynamicResource BrushInput}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}"
                MinHeight="48">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimaryBright}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=(local:ControlAssist.HasError), RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushErrorBright}" />
                            <Setter Property="BorderThickness" Value="1.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Leading Search Icon -->
                <local:Icon Grid.Column="0"
                            Data="{StaticResource IconSearch}"
                            Size="18"
                            Foreground="{DynamicResource BrushTextMuted}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                <!-- Input TextBox -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PlaceholderText"
                               Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource TextBody}"
                               Foreground="{DynamicResource BrushTextMuted}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBox x:Name="InputBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,10"
                             MinHeight="46"
                             TextChanged="OnInputTextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="{TemplateBinding Padding}" />
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>

                <!-- Trailing Clear Button (48x48 touch target when non-empty) -->
                <Button x:Name="ClearBtn"
                        Grid.Column="2"
                        Style="{StaticResource GhostButton}"
                        Width="48" Height="48" MinHeight="48" Padding="0"
                        Visibility="Collapsed"
                        Click="OnClearClick">
                    <local:Icon Data="{StaticResource IconClose}" Size="16" Foreground="{DynamicResource BrushTextSecondary}" />
                </Button>
            </Grid>
        </Border>
        <Border x:Name="FocusRing"
                Margin="-1"
                BorderBrush="{DynamicResource BrushFocusRing}"
                BorderThickness="2"
                CornerRadius="{StaticResource RadiusSm}"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
