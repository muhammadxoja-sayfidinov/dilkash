<UserControl x:Class="DilkashPos.Controls.CategoryTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DilkashPos.Controls"
             MinWidth="200"
             Height="152">
    <Button x:Name="TileButton"
            Click="OnTileClick"
            Padding="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            FocusVisualStyle="{x:Null}"
            Stylus.IsPressAndHoldEnabled="False"
            Stylus.IsFlicksEnabled="False"
            Stylus.IsTapFeedbackEnabled="False"
            Stylus.IsTouchFeedbackEnabled="False">
        <Button.Template>
            <ControlTemplate TargetType="{x:Type Button}">
                <Grid RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="pressScale" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Border x:Name="cardBorder"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            ClipToBounds="True">
                        <ContentPresenter />
                    </Border>
                    <Border x:Name="focusRing"
                            Margin="-1"
                            BorderBrush="{DynamicResource BrushFocusRing}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource RadiusMd}"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimaryBright}" />
                        <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource BrushSurfaceElevated}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="{StaticResource DurationPress}" EasingFunction="{StaticResource EaseOut}" />
                                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="{StaticResource DurationPress}" EasingFunction="{StaticResource EaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="{StaticResource DurationPress}" EasingFunction="{StaticResource EaseOut}" />
                                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="{StaticResource DurationPress}" EasingFunction="{StaticResource EaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="focusRing" Property="Visibility" Value="Visible" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Row: Department Icon Plate + Chevron -->
            <Grid Grid.Row="0">
                <Border Width="44" Height="44"
                        CornerRadius="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="{DynamicResource BrushPrimaryTint}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Department}" Value="shashlik">
                                    <Setter Property="Background" Value="{DynamicResource BrushAmberTintSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Department}" Value="somsa">
                                    <Setter Property="Background" Value="{DynamicResource BrushAmberTintSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Department}" Value="bar">
                                    <Setter Property="Background" Value="{DynamicResource BrushReservedTint}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <local:Icon Size="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Icon.Style>
                            <Style TargetType="{x:Type local:Icon}" BasedOn="{StaticResource {x:Type local:Icon}}">
                                <Setter Property="Data" Value="{StaticResource IconBowl}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryBright}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Department}" Value="shashlik">
                                        <Setter Property="Data" Value="{StaticResource IconGrill}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushAmberBright}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Department}" Value="somsa">
                                        <Setter Property="Data" Value="{StaticResource IconChef}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushAmberBright}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Department}" Value="fastfood">
                                        <Setter Property="Data" Value="{StaticResource IconBurger}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryBright}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Department}" Value="bar">
                                        <Setter Property="Data" Value="{StaticResource IconCoffee}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushReservedText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:Icon.Style>
                    </local:Icon>
                </Border>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{DynamicResource BrushSurfaceElevated}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusFull}"
                        Width="30" Height="30">
                    <local:Icon Data="{StaticResource IconChevronRight}"
                                Size="15"
                                Foreground="{DynamicResource BrushTextSecondary}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Middle: Category Name -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Name}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       LineHeight="20"
                       MaxHeight="42"
                       VerticalAlignment="Center"
                       Margin="0,8,0,4" />

            <!-- Bottom: Count Pill + Department Label -->
            <Grid Grid.Row="2">
                <TextBlock Text="{Binding CountLabel}"
                           Style="{StaticResource TextCaption}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushPrimaryBright}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding DepartmentLabel}"
                           Style="{StaticResource TextCaptionMuted}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Button>
</UserControl>
