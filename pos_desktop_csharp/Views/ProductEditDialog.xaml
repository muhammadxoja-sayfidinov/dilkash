<Window x:Class="DilkashPos.Views.ProductEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Taom qoʻshish"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <controls:DialogChrome x:Name="Chrome" Title="Yangi taom" Subtitle="Menyu va QR / Telegram / Ofitsiantlar uchun">
        <StackPanel Margin="24,20">
            <TextBlock x:Name="ErrorBanner"
                       Foreground="{DynamicResource BrushError}"
                       Style="{StaticResource TextLabel}"
                       Margin="0,0,0,12"
                       Visibility="Collapsed" />

            <controls:Field Label="Taom nomi" Margin="0,0,0,14">
                <TextBox x:Name="NameBox" />
            </controls:Field>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:Field Grid.Column="0" Label="Guruh (Kategoriya)">
                    <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name" SelectedValuePath="Id" />
                </controls:Field>

                <controls:Field Grid.Column="2" Label="Narxi (soʻm)">
                    <TextBox x:Name="PriceBox" Typography.NumeralAlignment="Tabular" />
                </controls:Field>
            </Grid>

            <controls:Field Label="Tavsif / Tarkibi (ixtiyoriy)" Margin="0,0,0,14">
                <TextBox x:Name="DescriptionBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,10" />
            </controls:Field>

            <!-- Taom rasmi + Oldindan ko'rish -->
            <Border Background="{DynamicResource BrushSurfaceElevated}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Padding="10"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="64" Height="64"
                            CornerRadius="{StaticResource RadiusXs}"
                            Background="{DynamicResource BrushBg}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <controls:Icon x:Name="PreviewPlaceholderIcon"
                                           Data="{StaticResource IconBowl}"
                                           Size="24"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            <Image x:Name="PreviewImage"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Taom rasmi (baza bilan sinxron)" Style="{StaticResource TextLabel}" />
                        <TextBlock x:Name="ImageFileText"
                                   Text="Rasm tanlanmagan (ixtiyoriy)"
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Rasm tanlash" Style="{StaticResource SecondaryButton}" MinHeight="42" Padding="12,6" Click="OnPickImageClick" />
                        <Button x:Name="ClearImageBtn"
                                Style="{StaticResource GhostButton}"
                                MinHeight="42"
                                Padding="10,6"
                                Margin="6,0,0,0"
                                ToolTip="Rasmni oʻchirish"
                                Visibility="Collapsed"
                                Click="OnClearImageClick">
                            <controls:Icon Data="{StaticResource IconTrash}" Size="16" Foreground="{DynamicResource BrushErrorBright}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <CheckBox x:Name="IsAvailableCheck"
                      Style="{StaticResource ToggleSwitch}"
                      Content="Sotuvda mavjud (oʻchirilsa Stop-listga tushadi)"
                      IsChecked="True" />
        </StackPanel>

        <controls:DialogChrome.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Bekor qilish" Style="{StaticResource GhostButton}" MinHeight="50" Padding="20,10" Click="OnCancelClick" />
                <Button Grid.Column="2" Content="Saqlash" Style="{StaticResource PrimaryButton}" MinHeight="50" Click="OnConfirmClick" />
            </Grid>
        </controls:DialogChrome.FooterContent>
    </controls:DialogChrome>
</Window>
