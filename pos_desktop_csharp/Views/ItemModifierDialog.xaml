<Window x:Class="DilkashPos.Views.ItemModifierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Taomga izoh"
        Width="672"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <controls:DialogChrome x:Name="Chrome" Title="Taom izohi" Subtitle="Oshxona uchun maxsus tayyorlash talablarini belgilang">
        <StackPanel Margin="24,20">
            <TextBlock Text="Tezkor talablar" Style="{StaticResource TextLabel}" Margin="0,0,0,10" />

            <!-- Multi-select Toggle Chips -->
            <WrapPanel x:Name="QuickChipsPanel" Margin="0,0,0,18">
                <ToggleButton Content="Piyozi boʻlmasin" Style="{StaticResource ChipToggle}" Margin="0,0,8,8" Click="OnQuickChipToggle" Tag="Piyozi boʻlmasin" />
                <ToggleButton Content="Piyozi koʻproq boʻlsin" Style="{StaticResource ChipToggle}" Margin="0,0,8,8" Click="OnQuickChipToggle" Tag="Piyozi koʻproq boʻlsin" />
                <ToggleButton Content="Achchiq boʻlmasin" Style="{StaticResource ChipToggle}" Margin="0,0,8,8" Click="OnQuickChipToggle" Tag="Achchiq boʻlmasin" />
                <ToggleButton Content="Achchiq boʻlsin" Style="{StaticResource ChipToggle}" Margin="0,0,8,8" Click="OnQuickChipToggle" Tag="Achchiq boʻlsin" />
                <ToggleButton Content="Sous koʻproq" Style="{StaticResource ChipToggle}" Margin="0,0,8,8" Click="OnQuickChipToggle" Tag="Sous koʻproq" />
                <ToggleButton Content="Oldin tortilsin" Style="{StaticResource ChipToggle}" Margin="0,0,8,8" Click="OnQuickChipToggle" Tag="Oldin tortilsin" />
                <ToggleButton Content="Qarsildoq qiling" Style="{StaticResource ChipToggle}" Margin="0,0,8,8" Click="OnQuickChipToggle" Tag="Qarsildoq qiling" />
                <ToggleButton Content="Limon bilan" Style="{StaticResource ChipToggle}" Margin="0,0,8,8" Click="OnQuickChipToggle" Tag="Limon bilan" />
            </WrapPanel>

            <!-- Free-text Note Field -->
            <controls:Field Label="Qoʻshimcha izoh" HelperText="Oshxona chekida taom ostida chop etiladi">
                <TextBox x:Name="NotesBox"
                         MinHeight="88"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         TextChanged="OnNotesTextChanged" />
            </controls:Field>
        </StackPanel>

        <controls:DialogChrome.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Bekor qilish"
                        Style="{StaticResource GhostButton}"
                        MinHeight="52"
                        Padding="20,10"
                        Click="OnCancelClick" />
                <Button Grid.Column="2"
                        Content="Saqlash"
                        Style="{StaticResource PrimaryButton}"
                        MinHeight="52"
                        Click="OnSaveClick" />
            </Grid>
        </controls:DialogChrome.FooterContent>
    </controls:DialogChrome>
</Window>
