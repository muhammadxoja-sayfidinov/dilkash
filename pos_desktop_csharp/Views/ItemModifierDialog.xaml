<Window x:Class="DilkashPos.Views.ItemModifierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taomga Izoh / Modifikator" Height="480" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    <Border BorderBrush="{StaticResource BrandPrimaryBrush}" BorderThickness="2" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Sarlavha -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="ItemTitleText" Text="Taom Izohi" FontSize="20" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Oshxonaga maxsus talab yoki tayyorlash usulini belgilang" FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Tezkor Izohlar (Touch Chips) -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Tezkor talablar:" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8" />
                <WrapPanel Margin="0,0,0,16">
                    <Button Content="Piyozi bo'lmasin" Margin="3" Padding="12,8" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnQuickTagClick" Tag="Piyozi bo'lmasin" />
                    <Button Content="Achchiq bo'lmasin" Margin="3" Padding="12,8" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnQuickTagClick" Tag="Achchiq bo'lmasin" />
                    <Button Content="Sous ko'proq" Margin="3" Padding="12,8" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnQuickTagClick" Tag="Sous ko'proq" />
                    <Button Content="Oldin tortilsin" Margin="3" Padding="12,8" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnQuickTagClick" Tag="Oldin tortilsin" />
                    <Button Content="Qarsildoq qiling" Margin="3" Padding="12,8" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnQuickTagClick" Tag="Qarsildoq qiling" />
                    <Button Content="Limon bilan" Margin="3" Padding="12,8" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnQuickTagClick" Tag="Limon bilan" />
                </WrapPanel>

                <TextBlock Text="Kiritilgan izoh:" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,4" />
                <TextBox x:Name="NotesBox" Height="70" Padding="8" FontSize="15" TextWrapping="Wrap"
                         Background="#1E293B" Foreground="White" BorderBrush="#334155" />
            </StackPanel>

            <!-- Tugmalar -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="BEKOR QILISH" Style="{StaticResource TouchDangerButton}" Click="OnCancelClick" />
                <Button Grid.Column="2" Content="SAQLASH" Style="{StaticResource TouchButtonStyle}" Click="OnSaveClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
