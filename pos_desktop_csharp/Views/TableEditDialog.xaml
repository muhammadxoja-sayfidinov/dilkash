<Window x:Class="DilkashPos.Views.TableEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Stol qoʻshish"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <controls:DialogChrome x:Name="Chrome" Title="Yangi stol" Subtitle="Zal, Terrasa yoki VIP xona stoli">
        <StackPanel Margin="24,20">
            <TextBlock x:Name="ErrorBanner"
                       Foreground="{DynamicResource BrushError}"
                       Style="{StaticResource TextLabel}"
                       Margin="0,0,0,12"
                       Visibility="Collapsed" />

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:Field Grid.Column="0" Label="Stol raqami" HelperText="1-6 Zal, 7-9 Terrasa, 10+ VIP">
                    <TextBox x:Name="NumberBox" Typography.NumeralAlignment="Tabular" />
                </controls:Field>
                <controls:Field Grid.Column="2" Label="Oʻrinlar soni">
                    <TextBox x:Name="CapacityBox" Text="4" Typography.NumeralAlignment="Tabular" />
                </controls:Field>
            </Grid>

            <controls:Field Label="Stol nomi" HelperText="Masalan: Asosiy Zal 1 yoki VIP Kabina" Margin="0,0,0,14">
                <TextBox x:Name="NameBox" />
            </controls:Field>

            <CheckBox x:Name="IsActiveCheck"
                      Style="{StaticResource ToggleSwitch}"
                      Content="Faol stol"
                      IsChecked="True" />
        </StackPanel>

        <controls:DialogChrome.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Bekor qilish" Style="{StaticResource GhostButton}" MinHeight="50" Padding="20,10" Click="OnCancelClick" />
                <Button Grid.Column="2" Content="Saqlash" Style="{StaticResource PrimaryButton}" MinHeight="50" Click="OnConfirmClick" />
            </Grid>
        </controls:DialogChrome.FooterContent>
    </controls:DialogChrome>
</Window>
