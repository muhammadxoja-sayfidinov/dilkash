<Window x:Class="DilkashPos.Views.StaffEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Xodim qoʻshish"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <controls:DialogChrome x:Name="Chrome" Title="Yangi xodim" Subtitle="Ofitsiant va Kuryer mobil ilovasi uchun kirish">
        <StackPanel Margin="24,20">
            <TextBlock x:Name="ErrorBanner"
                       Foreground="{DynamicResource BrushError}"
                       Style="{StaticResource TextLabel}"
                       Margin="0,0,0,12"
                       Visibility="Collapsed" />

            <controls:Field Label="Xodim roli" Margin="0,0,0,14">
                <ComboBox x:Name="RoleCombo" SelectionChanged="OnRoleChanged">
                    <ComboBoxItem Content="Ofitsiant (Zal xodimi)" Tag="waiter" IsSelected="True" />
                    <ComboBoxItem Content="Kuryer (Yetkazib beruvchi)" Tag="courier" />
                </ComboBox>
            </controls:Field>

            <controls:Field Label="Ism va familiya" Margin="0,0,0,14">
                <TextBox x:Name="NameBox" />
            </controls:Field>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:Field Grid.Column="0" Label="Telefon raqami" HelperText="Masalan: +998901234567">
                    <TextBox x:Name="PhoneBox" Text="+998" />
                </controls:Field>

                <controls:Field x:Name="PinField" Grid.Column="2" Label="Kirish PIN-kodi" HelperText="Kamida 4 ta raqam">
                    <TextBox x:Name="PinBox" MaxLength="8" Text="1234" Typography.NumeralAlignment="Tabular" />
                </controls:Field>
            </Grid>

            <controls:Field x:Name="VehicleField" Label="Transport (Kuryer uchun)" HelperText="Masalan: Skuter, Nexia 01A123BC" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBox x:Name="VehicleBox" />
            </controls:Field>

            <CheckBox x:Name="IsActiveCheck"
                      Style="{StaticResource ToggleSwitch}"
                      Content="Smenada faol (mobil ilovaga kirishi ruxsat etilgan)"
                      IsChecked="True" />
        </StackPanel>

        <controls:DialogChrome.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Bekor qilish" Style="{StaticResource GhostButton}" MinHeight="50" Padding="20,10" Click="OnCancelClick" />
                <Button Grid.Column="2" Content="Saqlash" Style="{StaticResource PrimaryButton}" MinHeight="50" Click="OnConfirmClick" />
            </Grid>
        </controls:DialogChrome.FooterContent>
    </controls:DialogChrome>
</Window>
