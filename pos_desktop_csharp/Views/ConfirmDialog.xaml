<Window x:Class="DilkashPos.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Tasdiqlash"
        Width="512"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <controls:DialogChrome x:Name="Chrome" Title="Tasdiqlash">
        <StackPanel Margin="24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border x:Name="IconBadge"
                        Width="44" Height="44"
                        CornerRadius="22"
                        Background="{DynamicResource BrushAmberTintSoft}"
                        BorderBrush="{DynamicResource BrushAmber}"
                        BorderThickness="1"
                        VerticalAlignment="Top"
                        Margin="0,0,14,0">
                    <controls:Icon x:Name="DialogIcon"
                                   Data="{StaticResource IconAlert}"
                                   Size="22"
                                   Foreground="{DynamicResource BrushAmberBright}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="MessageText"
                           Style="{StaticResource TextBody}"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <controls:DialogChrome.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelBtn"
                        Grid.Column="0"
                        Content="Bekor qilish"
                        Style="{StaticResource SecondaryButton}"
                        MinHeight="52"
                        Click="OnCancelClick" />
                <Button x:Name="ConfirmBtn"
                        Grid.Column="2"
                        Content="Tasdiqlash"
                        Style="{StaticResource PrimaryButton}"
                        MinHeight="52"
                        Click="OnConfirmClick" />
            </Grid>
        </controls:DialogChrome.FooterContent>
    </controls:DialogChrome>
</Window>
