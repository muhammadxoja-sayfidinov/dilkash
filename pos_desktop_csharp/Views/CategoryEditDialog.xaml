<Window x:Class="DilkashPos.Views.CategoryEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Guruh (Kategoriya)"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <controls:DialogChrome x:Name="Chrome" Title="Yangi guruh" Subtitle="Taomlar kategoriyasi va printer boʻlimi">
        <StackPanel Margin="24,20">
            <TextBlock x:Name="ErrorBanner"
                       Foreground="{DynamicResource BrushError}"
                       Style="{StaticResource TextLabel}"
                       Margin="0,0,0,12"
                       Visibility="Collapsed" />

            <controls:Field Label="Guruh (Kategoriya) nomi" Margin="0,0,0,14">
                <TextBox x:Name="NameBox" />
            </controls:Field>

            <controls:Field Label="Chiqish printeri boʻlimi" HelperText="Ushbu guruhdagi taomlar cheki qaysi boʻlim printeriga chiqadi" Margin="0,0,0,14">
                <ComboBox x:Name="DepartmentCombo">
                    <ComboBoxItem Content="Issiq oshxona (Milliy taomlar)" Tag="kitchen" IsSelected="True" />
                    <ComboBoxItem Content="Shashlikxona / Mangal" Tag="shashlik" />
                    <ComboBoxItem Content="Somsaxona / Tandir" Tag="somsa" />
                    <ComboBoxItem Content="Fast-Food &amp; Burger" Tag="fastfood" />
                    <ComboBoxItem Content="Bar &amp; Ichimliklar &amp; Desert" Tag="bar" />
                    <ComboBoxItem Content="Kassa (Umumiy)" Tag="kassa" />
                </ComboBox>
            </controls:Field>

            <controls:Field Label="Tavsif (ixtiyoriy)" Margin="0,0,0,14">
                <TextBox x:Name="DescriptionBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,10" />
            </controls:Field>

            <CheckBox x:Name="IsActiveCheck"
                      Style="{StaticResource ToggleSwitch}"
                      Content="Menyuda faol (mijozlar va ofitsiantlarga koʻrinadi)"
                      IsChecked="True" />
        </StackPanel>

        <controls:DialogChrome.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Bekor qilish" Style="{StaticResource GhostButton}" MinHeight="50" Padding="20,10" Click="OnCancelClick" />
                <Button Grid.Column="2" Content="Saqlash" Style="{StaticResource PrimaryButton}" MinHeight="50" Click="OnConfirmClick" />
            </Grid>
        </controls:DialogChrome.FooterContent>
    </controls:DialogChrome>
</Window>
