<Window x:Class="DilkashPos.Views.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="To'lov Qabul Qilish" Height="680" Width="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    <Border BorderBrush="{StaticResource BrandPrimaryBrush}" BorderThickness="2" CornerRadius="12" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Sarlavha va Umumiy Summa -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="OrderInfoText" Text="Buyurtma To'lovi" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock x:Name="TableInfoText" Text="Stol: #1 | Mehmonlar: 2" FontSize="14" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="TO'LANISHI KERAK:" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Right" />
                    <TextBlock x:Name="TotalSumText" Text="125 000 so'm" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <!-- Asosiy Qism: To'lov usullari va Raqamlar paneli -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Chap tomon: To'lov usullari va Summa ko'rsatkichlari -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="To'lov usulini tanlang:" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10" />

                    <!-- Usullar tugmalari -->
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Button x:Name="BtnCash" Content="💵 NAQD" Height="60" Margin="2" FontSize="14" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Click="OnMethodSelected" Tag="naqd" />
                        <Button x:Name="BtnCard" Content="💳 KARTA" Height="60" Margin="2" FontSize="14" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnMethodSelected" Tag="karta" />
                        <Button x:Name="BtnSplit" Content="⚖ ARALASH" Height="60" Margin="2" FontSize="14" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnMethodSelected" Tag="aralash" />
                    </UniformGrid>

                    <!-- Berilgan Pul va Qaytim hisoblagichi -->
                    <Border Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Berilgan naqd pul:" FontSize="13" Foreground="#94A3B8" />
                            <TextBlock x:Name="GivenCashText" Text="0 so'm" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,10" />

                            <TextBlock Text="Qaytim summasi:" FontSize="13" Foreground="#94A3B8" />
                            <TextBlock x:Name="ChangeText" Text="0 so'm" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Tezkor kupyuralar -->
                    <TextBlock Text="Tezkor kupyuralar:" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,6" />
                    <UniformGrid Columns="2">
                        <Button Content="Aniq Summa" Height="46" Margin="2" Background="#334155" Style="{StaticResource TouchButtonStyle}" Click="OnQuickExactClick" />
                        <Button Content="50 000" Height="46" Margin="2" Background="#334155" Style="{StaticResource TouchButtonStyle}" Click="OnQuickCashClick" Tag="50000" />
                        <Button Content="100 000" Height="46" Margin="2" Background="#334155" Style="{StaticResource TouchButtonStyle}" Click="OnQuickCashClick" Tag="100000" />
                        <Button Content="200 000" Height="46" Margin="2" Background="#334155" Style="{StaticResource TouchButtonStyle}" Click="OnQuickCashClick" Tag="200000" />
                    </UniformGrid>
                </StackPanel>

                <!-- O'ng tomon: Sensorli Numpad -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Numpad Displeyi -->
                    <Border Grid.Row="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <TextBlock x:Name="NumpadDisplayText" Text="0" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" />
                    </Border>

                    <!-- Raqamlar Tugmalari (4x3 Grid) -->
                    <UniformGrid Grid.Row="1" Columns="3" Rows="4">
                        <Button Content="7" Margin="4" FontSize="26" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNumpadDigitClick" Tag="7" />
                        <Button Content="8" Margin="4" FontSize="26" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNumpadDigitClick" Tag="8" />
                        <Button Content="9" Margin="4" FontSize="26" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNumpadDigitClick" Tag="9" />

                        <Button Content="4" Margin="4" FontSize="26" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNumpadDigitClick" Tag="4" />
                        <Button Content="5" Margin="4" FontSize="26" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNumpadDigitClick" Tag="5" />
                        <Button Content="6" Margin="4" FontSize="26" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNumpadDigitClick" Tag="6" />

                        <Button Content="1" Margin="4" FontSize="26" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNumpadDigitClick" Tag="1" />
                        <Button Content="2" Margin="4" FontSize="26" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNumpadDigitClick" Tag="2" />
                        <Button Content="3" Margin="4" FontSize="26" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNumpadDigitClick" Tag="3" />

                        <Button Content="C" Margin="4" FontSize="24" FontWeight="Bold" Style="{StaticResource TouchDangerButton}" Click="OnNumpadClearClick" />
                        <Button Content="0" Margin="4" FontSize="26" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNumpadDigitClick" Tag="0" />
                        <Button Content="000" Margin="4" FontSize="22" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNumpadDigitClick" Tag="000" />
                    </UniformGrid>
                </Grid>
            </Grid>

            <!-- Pastki Tugmalar: Bekor qilish va To'lash -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="ErrorHintText"
                           Text=""
                           Foreground="{DynamicResource BrushErrorBright}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Visibility="Collapsed" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="BEKOR QILISH" Height="64" FontSize="18" Style="{StaticResource TouchDangerButton}" Click="OnCancelClick" />
                    <Button Grid.Column="2" Content="TO'LASH VA CHEK CHIQARISH" Height="64" FontSize="20" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource SuccessGreenBrush}" Click="OnPayConfirmClick" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>

