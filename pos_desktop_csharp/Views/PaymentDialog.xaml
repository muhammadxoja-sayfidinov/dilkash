<Window x:Class="DilkashPos.Views.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Toʻlov qabul qilish"
        Width="936"
        Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <controls:DialogChrome x:Name="Chrome" Title="Toʻlov qabul qilish" Subtitle="Buyurtma #D-2026">
        <Grid Margin="24,18">
            <!-- 1. ACTIVE PAYMENT ENTRY VIEW -->
            <Grid x:Name="PaymentEntryGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Summary + Method Segmented + Received/Change + Quick Bills -->
                <StackPanel Grid.Column="0">
                    <!-- Total Due Card -->
                    <Border Background="{DynamicResource BrushBg}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16,12"
                            Margin="0,0,0,10">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOʻLANISHI KERAK" Style="{StaticResource TextLabelCaps}" />
                                <TextBlock x:Name="TableInfoText"
                                           Text="Stol #4 · 4 mehmon"
                                           Style="{StaticResource TextCaption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="TotalSumText"
                                       Text="285&#160;000&#160;soʻm"
                                       Style="{StaticResource TextKpi}"
                                       Foreground="{DynamicResource BrushPrimaryBright}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Segmented Payment Method -->
                    <TextBlock Text="Toʻlov usuli" Style="{StaticResource TextLabel}" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource BrushInput}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="4"
                            Margin="0,0,0,10">
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="BtnCash" GroupName="PaymentMethod" Style="{StaticResource SegmentedItem}" IsChecked="True" Click="OnMethodSelected" Tag="naqd">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource IconCash}" Size="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Naqd" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="BtnCard" GroupName="PaymentMethod" Style="{StaticResource SegmentedItem}" Click="OnMethodSelected" Tag="karta">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource IconCard}" Size="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Karta" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="BtnSplit" GroupName="PaymentMethod" Style="{StaticResource SegmentedItem}" Click="OnMethodSelected" Tag="aralash">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource IconSplit}" Size="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Aralash" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <!-- Received & Change Card -->
                    <Border Background="{DynamicResource BrushBg}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16,12"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="GivenLabelText" Text="Qabul qilingan" Style="{StaticResource TextCaption}" />
                                <TextBlock x:Name="GivenCashText"
                                           Text="285&#160;000&#160;soʻm"
                                           Style="{StaticResource TextTitle}"
                                           Typography.NumeralAlignment="Tabular"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="ChangeLabelText" Text="Qaytim" Style="{StaticResource TextCaption}" />
                                <TextBlock x:Name="ChangeText"
                                           Text="0&#160;soʻm"
                                           Style="{StaticResource TextTitle}"
                                           Foreground="{DynamicResource BrushAmberBright}"
                                           Typography.NumeralAlignment="Tabular"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quick-Bill Chips (Aniq summa + 10k / 20k / 50k / 100k / 200k) -->
                    <TextBlock Text="Tezkor kupyuralar" Style="{StaticResource TextLabel}" Margin="0,0,0,8" />
                    <UniformGrid x:Name="QuickBillsPanel" Columns="3" Margin="-4,0,-4,0">
                        <Button Content="Aniq summa" Margin="4" Padding="8,8" Style="{StaticResource ChipButton}" Click="OnQuickExactClick" />
                        <Button Content="10&#160;000" Margin="4" Padding="8,8" Style="{StaticResource ChipButton}" Typography.NumeralAlignment="Tabular" Click="OnQuickCashClick" Tag="10000" />
                        <Button Content="20&#160;000" Margin="4" Padding="8,8" Style="{StaticResource ChipButton}" Typography.NumeralAlignment="Tabular" Click="OnQuickCashClick" Tag="20000" />
                        <Button Content="50&#160;000" Margin="4" Padding="8,8" Style="{StaticResource ChipButton}" Typography.NumeralAlignment="Tabular" Click="OnQuickCashClick" Tag="50000" />
                        <Button Content="100&#160;000" Margin="4" Padding="8,8" Style="{StaticResource ChipButton}" Typography.NumeralAlignment="Tabular" Click="OnQuickCashClick" Tag="100000" />
                        <Button Content="200&#160;000" Margin="4" Padding="8,8" Style="{StaticResource ChipButton}" Typography.NumeralAlignment="Tabular" Click="OnQuickCashClick" Tag="200000" />
                    </UniformGrid>
                </StackPanel>

                <!-- RIGHT COLUMN: Display + 72px Numpad -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Display -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BrushInput}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="18,14"
                            Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="Kiritilgan summa"
                                       Style="{StaticResource TextCaption}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="NumpadDisplayText"
                                           Text="285&#160;000"
                                           Style="{StaticResource TextKpi}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="&#160;soʻm"
                                           Style="{StaticResource TextBody}"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,4" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Inline Error Hint (replaces MessageBox) -->
                    <TextBlock x:Name="ErrorHintText"
                               Grid.Row="1"
                               Text=""
                               Style="{StaticResource TextLabel}"
                               Foreground="{DynamicResource BrushErrorBright}"
                               Margin="4,0,0,8"
                               Visibility="Collapsed" />

                    <!-- 72px Numpad (4x3) -->
                    <UniformGrid x:Name="NumpadGrid" Grid.Row="2" Columns="3" Rows="4" Margin="-4">
                        <Button Content="7" Margin="4" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="7" />
                        <Button Content="8" Margin="4" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="8" />
                        <Button Content="9" Margin="4" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="9" />

                        <Button Content="4" Margin="4" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="4" />
                        <Button Content="5" Margin="4" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="5" />
                        <Button Content="6" Margin="4" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="6" />

                        <Button Content="1" Margin="4" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="1" />
                        <Button Content="2" Margin="4" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="2" />
                        <Button Content="3" Margin="4" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="3" />

                        <Button Content="C" Margin="4" Style="{StaticResource NumpadKey}" Foreground="{DynamicResource BrushErrorBright}" Click="OnNumpadClearClick" />
                        <Button Content="0" Margin="4" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="0" />
                        <Button Content="000" Margin="4" Style="{StaticResource NumpadKey}" FontSize="20" Click="OnNumpadDigitClick" Tag="000" />
                    </UniformGrid>
                </Grid>
            </Grid>

            <!-- 2. CONFIRMATION SUCCESS VIEW -->
            <StackPanel x:Name="PaymentSuccessView"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Border Width="88" Height="88"
                        CornerRadius="44"
                        Background="{DynamicResource BrushPrimaryTint}"
                        BorderBrush="{DynamicResource BrushPrimaryBright}"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                    <controls:Icon Data="{StaticResource IconCheck}"
                                   Size="40"
                                   Foreground="{DynamicResource BrushPrimaryBright}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Toʻlov qabul qilindi"
                           Style="{StaticResource TextSection}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="SuccessSummaryText"
                           Text="Naqd · 285&#160;000&#160;soʻm"
                           Style="{StaticResource TextTitle}"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           Typography.NumeralAlignment="Tabular"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />

                <Border x:Name="SuccessChangeBadge"
                        Background="{DynamicResource BrushAmberTintSoft}"
                        BorderBrush="{DynamicResource BrushAmber}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="24,14"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Qaytim: "
                                   Style="{StaticResource TextTitle}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="SuccessChangeAmountText"
                                   Text="15&#160;000&#160;soʻm"
                                   Style="{StaticResource TextKpi}"
                                   Foreground="{DynamicResource BrushAmberBright}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <controls:DialogChrome.FooterContent>
            <Grid>
                <!-- Entry Footer -->
                <Grid x:Name="EntryFooterGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Bekor qilish"
                            Style="{StaticResource GhostButton}"
                            MinHeight="56"
                            Padding="24,12"
                            Click="OnCancelClick" />

                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="50"
                            MinWidth="260"
                            Padding="20,10"
                            Click="OnPayConfirmClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon Data="{StaticResource IconReceipt}" Size="17" Foreground="{DynamicResource BrushTextOnPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Toʻlash va chek chiqarish" Style="{StaticResource TextBodyBold}" Foreground="{DynamicResource BrushTextOnPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Success Footer -->
                <Grid x:Name="SuccessFooterGrid" Visibility="Collapsed">
                    <Button Content="Tayyor"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="56"
                            Width="240"
                            HorizontalAlignment="Center"
                            Click="OnSuccessDoneClick" />
                </Grid>
            </Grid>
        </controls:DialogChrome.FooterContent>
    </controls:DialogChrome>
</Window>
