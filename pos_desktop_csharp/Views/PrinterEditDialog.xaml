<Window x:Class="DilkashPos.Views.PrinterEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Printer qoʻshish"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <controls:DialogChrome x:Name="Chrome" Title="Yangi printer" Subtitle="LAN (TCP 9100) termal chek printeri">
        <StackPanel Margin="24,20">
            <TextBlock x:Name="ErrorBanner"
                       Foreground="{DynamicResource BrushError}"
                       Style="{StaticResource TextLabel}"
                       Margin="0,0,0,12"
                       Visibility="Collapsed" />

            <controls:Field Label="Printer nomi" HelperText="Masalan: Kassa asosiy printeri yoki Bar 2-qavat" Margin="0,0,0,14">
                <TextBox x:Name="NameBox" />
            </controls:Field>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:Field Grid.Column="0" Label="Boʻlim">
                    <ComboBox x:Name="DepartmentCombo">
                        <ComboBoxItem Content="Kassa (Hisob cheki)" Tag="kassa" />
                        <ComboBoxItem Content="Issiq oshxona" Tag="kitchen" IsSelected="True" />
                        <ComboBoxItem Content="Shashlikxona / Mangal" Tag="shashlik" />
                        <ComboBoxItem Content="Somsaxona / Tandir" Tag="somsa" />
                        <ComboBoxItem Content="Fast-Food &amp; Burger" Tag="fastfood" />
                        <ComboBoxItem Content="Bar &amp; Ichimliklar &amp; Desert" Tag="bar" />
                    </ComboBox>
                </controls:Field>

                <controls:Field Grid.Column="2" Label="Chek qogʻozi">
                    <ComboBox x:Name="PaperWidthCombo">
                        <ComboBoxItem Content="80 mm (standart)" Tag="80" IsSelected="True" />
                        <ComboBoxItem Content="58 mm (tor)" Tag="58" />
                    </ComboBox>
                </controls:Field>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:Field Grid.Column="0" Label="Printer IP manzili" HelperText="Masalan: 192.168.1.100">
                    <TextBox x:Name="IpBox" Typography.NumeralAlignment="Tabular" />
                </controls:Field>

                <controls:Field Grid.Column="2" Label="Port">
                    <TextBox x:Name="PortBox" Text="9100" Typography.NumeralAlignment="Tabular" />
                </controls:Field>
            </Grid>

            <controls:Field Label="Izoh / Tavsif (ixtiyoriy)" Margin="0,0,0,14">
                <TextBox x:Name="SubtitleBox" />
            </controls:Field>

            <CheckBox x:Name="IsActiveCheck"
                      Style="{StaticResource ToggleSwitch}"
                      Content="Faol printer (buyurtmalarda chek chiqaradi)"
                      IsChecked="True" />
        </StackPanel>

        <controls:DialogChrome.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Bekor qilish" Style="{StaticResource GhostButton}" MinHeight="50" Padding="20,10" Click="OnCancelClick" />
                <Button Grid.Column="2" Content="Saqlash" Style="{StaticResource PrimaryButton}" MinHeight="50" Click="OnConfirmClick" />
            </Grid>
        </controls:DialogChrome.FooterContent>
    </controls:DialogChrome>
</Window>
