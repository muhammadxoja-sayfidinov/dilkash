<Window x:Class="DilkashPos.Views.SupplierEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Taʼminotchi"
        Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <controls:DialogChrome x:Name="Chrome" Title="Yangi taʼminotchi" Subtitle="Xomashyo yetkazib beruvchi korxona yoki shaxs">
        <StackPanel Margin="24,20">
            <TextBlock x:Name="ErrorBanner"
                       Foreground="{DynamicResource BrushError}"
                       Style="{StaticResource TextLabel}"
                       Margin="0,0,0,12"
                       Visibility="Collapsed" />

            <controls:Field Label="Taʼminotchi / Firma nomi" Margin="0,0,0,14">
                <TextBox x:Name="NameBox" />
            </controls:Field>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:Field Grid.Column="0" Label="Telefon raqami">
                    <TextBox x:Name="PhoneBox" Typography.NumeralAlignment="Tabular" />
                </controls:Field>

                <controls:Field Grid.Column="2" Label="Masʼul shaxs ismi">
                    <TextBox x:Name="ContactPersonBox" />
                </controls:Field>
            </Grid>

            <controls:Field Label="Manzil yoki yetkazib berish sharti" Margin="0,0,0,14">
                <TextBox x:Name="AddressBox" />
            </controls:Field>

            <controls:Field Label="Izoh yoki eslatma (ixtiyoriy)" Margin="0,0,0,14">
                <TextBox x:Name="NotesBox" Height="50" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,8" />
            </controls:Field>

            <CheckBox x:Name="IsActiveCheck"
                      Style="{StaticResource ToggleSwitch}"
                      Content="Faol hamkor (kirim roʻyxatida koʻrinadi)"
                      IsChecked="True" />
        </StackPanel>

        <controls:DialogChrome.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Bekor qilish" Style="{StaticResource GhostButton}" MinHeight="48" Padding="20,10" Click="OnCancelClick" />
                <Button Grid.Column="2" Content="Saqlash" Style="{StaticResource PrimaryButton}" MinHeight="48" Click="OnSaveClick" />
            </Grid>
        </controls:DialogChrome.FooterContent>
    </controls:DialogChrome>
</Window>