<Window x:Class="DilkashPos.Views.ShiftReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Smena hisoboti"
        Width="672"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <controls:DialogChrome x:Name="Chrome" Title="Kassa smenasi hisoboti" Subtitle="Smena maʻlumotlari">
        <StackPanel Margin="24,20">
            <!-- 1. Hero Total First -->
            <Border Background="{DynamicResource BrushBg}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="20,16"
                    Margin="0,0,0,14">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="JAMI TUSHUM" Style="{StaticResource TextLabelCaps}" />
                        <TextBlock x:Name="TotalRevenueText"
                                   Text="0&#160;soʻm"
                                   Style="{StaticResource TextKpi}"
                                   Foreground="{DynamicResource BrushPrimaryBright}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusFull}"
                            Padding="12,6">
                        <TextBlock x:Name="TotalOrdersCountText"
                                   Text="0 ta chek"
                                   Style="{StaticResource TextLabel}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   Typography.NumeralAlignment="Tabular" />
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Payment Split Rows + Thin Proportion Bar -->
            <Border Background="{DynamicResource BrushBg}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="20,16"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="TOʻLOV TURLARI BOʻYICHA TAQSIMOT" Style="{StaticResource TextLabelCaps}" Margin="0,0,0,12" />

                    <!-- Thin Proportion Bar -->
                    <Border Height="8" CornerRadius="4" Background="{DynamicResource BrushSurfaceElevated}" ClipToBounds="True" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CashBarCol" Width="6*" />
                                <ColumnDefinition x:Name="CardBarCol" Width="3*" />
                                <ColumnDefinition x:Name="OnlineBarCol" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource BrushPrimaryBright}" />
                            <Border Grid.Column="1" Background="{DynamicResource BrushInfo}" />
                            <Border Grid.Column="2" Background="{DynamicResource BrushAmberBright}" />
                        </Grid>
                    </Border>

                    <!-- Cash Row -->
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushPrimaryBright}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <controls:Icon Data="{StaticResource IconCash}" Size="16" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Naqd pul" Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="CashRevenueText" Text="0&#160;soʻm" Style="{StaticResource TextAmount}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Card Row -->
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushInfo}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <controls:Icon Data="{StaticResource IconCard}" Size="16" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Karta / Terminal" Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="CardRevenueText" Text="0&#160;soʻm" Style="{StaticResource TextAmount}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Online Row -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushAmberBright}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <controls:Icon Data="{StaticResource IconOnline}" Size="16" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Onlayn toʻlovlar" Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="OnlineRevenueText" Text="0&#160;soʻm" Style="{StaticResource TextAmount}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Secondary Stats (Service Fee & Discounts) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BrushBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Xizmat haqi" Style="{StaticResource TextCaption}" />
                        <TextBlock x:Name="ServiceFeeText" Text="0&#160;soʻm" Style="{StaticResource TextAmount}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource BrushBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Chegirmalar" Style="{StaticResource TextCaption}" />
                        <TextBlock x:Name="DiscountText" Text="0&#160;soʻm" Style="{StaticResource TextAmount}" Foreground="{DynamicResource BrushAmberBright}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <controls:DialogChrome.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource SecondaryButton}"
                        MinHeight="54"
                        Click="OnPrintXReportClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:Icon Data="{StaticResource IconPrinter}" Size="18" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="X-hisobot (Oraliq)" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource GoldButton}"
                        MinHeight="50"
                        Click="OnPrintZReportClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:Icon Data="{StaticResource IconLock}" Size="17" Foreground="{DynamicResource BrushTextOnAmber}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Z-hisobot (Smenani yopish)" Style="{StaticResource TextLabel}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextOnAmber}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </controls:DialogChrome.FooterContent>
    </controls:DialogChrome>
</Window>
