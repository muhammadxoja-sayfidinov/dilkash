<Window x:Class="DilkashPos.Views.DiscountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Chegirma qoʻllash"
        Width="512"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <controls:DialogChrome x:Name="Chrome" Title="Chegirma qoʻllash" Subtitle="Buyurtmaga foizli chegirma belgilang">
        <StackPanel Margin="24,18">
            <!-- Segmented Preset Percentages (0 / 5 / 10 / 15%) -->
            <Border Background="{DynamicResource BrushInput}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Padding="4"
                    Margin="0,0,0,14">
                <UniformGrid Columns="4">
                    <RadioButton x:Name="Seg0" GroupName="DiscountPreset" Content="0%" Style="{StaticResource SegmentedItem}" Click="OnPresetClick" Tag="0" />
                    <RadioButton x:Name="Seg5" GroupName="DiscountPreset" Content="5%" Style="{StaticResource SegmentedItem}" Click="OnPresetClick" Tag="5" />
                    <RadioButton x:Name="Seg10" GroupName="DiscountPreset" Content="10%" Style="{StaticResource SegmentedItem}" Click="OnPresetClick" Tag="10" />
                    <RadioButton x:Name="Seg15" GroupName="DiscountPreset" Content="15%" Style="{StaticResource SegmentedItem}" Click="OnPresetClick" Tag="15" />
                </UniformGrid>
            </Border>

            <!-- Live Percentage & Discount Amount Preview Card -->
            <Border Background="{DynamicResource BrushBg}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="16,12"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Chegirma summasi" Style="{StaticResource TextCaption}" />
                        <TextBlock x:Name="DiscountPreviewAmountText"
                                   Text="-41&#160;800&#160;soʻm"
                                   Style="{StaticResource TextAmountHero}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="FOIZ" Style="{StaticResource TextLabelCaps}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="SelectedPercentText"
                                   Text="10%"
                                   Style="{StaticResource TextKpi}"
                                   Foreground="{DynamicResource BrushAmberBright}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Compact Touch Numpad (4x3) for Custom % -->
            <UniformGrid Columns="3" Margin="-4,0,-4,0">
                <Button Content="7" Margin="4" Height="56" MinHeight="56" FontSize="20" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="7" />
                <Button Content="8" Margin="4" Height="56" MinHeight="56" FontSize="20" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="8" />
                <Button Content="9" Margin="4" Height="56" MinHeight="56" FontSize="20" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="9" />

                <Button Content="4" Margin="4" Height="56" MinHeight="56" FontSize="20" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="4" />
                <Button Content="5" Margin="4" Height="56" MinHeight="56" FontSize="20" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="5" />
                <Button Content="6" Margin="4" Height="56" MinHeight="56" FontSize="20" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="6" />

                <Button Content="1" Margin="4" Height="56" MinHeight="56" FontSize="20" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="1" />
                <Button Content="2" Margin="4" Height="56" MinHeight="56" FontSize="20" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="2" />
                <Button Content="3" Margin="4" Height="56" MinHeight="56" FontSize="20" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="3" />

                <Button Content="C" Margin="4" Height="56" MinHeight="56" FontSize="18" Style="{StaticResource SecondaryButton}" Foreground="{DynamicResource BrushErrorBright}" Click="OnNumpadClearClick" />
                <Button Content="0" Margin="4" Height="56" MinHeight="56" FontSize="20" Style="{StaticResource NumpadKey}" Click="OnNumpadDigitClick" Tag="0" />
                <Button Content="⌫" Margin="4" Height="56" MinHeight="56" FontSize="18" Style="{StaticResource SecondaryButton}" Click="OnNumpadBackspaceClick" />
            </UniformGrid>
        </StackPanel>

        <controls:DialogChrome.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Bekor qilish"
                        Style="{StaticResource GhostButton}"
                        MinHeight="52"
                        Padding="20,10"
                        Click="OnCancelClick" />
                <Button Grid.Column="2"
                        Content="Qoʻllash"
                        Style="{StaticResource GoldButton}"
                        MinHeight="52"
                        Click="OnApplyClick" />
            </Grid>
        </controls:DialogChrome.FooterContent>
    </controls:DialogChrome>
</Window>
