<Window x:Class="DilkashPos.Views.OpenTableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stolni Ochish" Height="500" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    <Border BorderBrush="{StaticResource BrandPrimaryBrush}" BorderThickness="2" CornerRadius="12" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Sarlavha -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="TitleText" Text="Stol #1 Ochish" 
                           FontSize="24" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Mehmonlar soni va ofitsiantni tanlang" 
                           FontSize="14" Foreground="#94A3B8" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Mehmonlar Soni Sensorli Tanlash (Touch grid) -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Mehmonlar soni:" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8" />
                
                <WrapPanel x:Name="GuestButtonsPanel" Margin="0,0,0,16">
                    <!-- 1 dan 12 gacha mehmon tugmalari kodi orqali yoki XAML da -->
                </WrapPanel>

                <TextBlock Text="Tanlangan mehmonlar:" FontSize="13" Foreground="#94A3B8" />
                <TextBlock x:Name="SelectedGuestCountText" Text="2 kishi" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" Margin="0,2,0,16" />

                <TextBlock Text="Ofitsiant ismi:" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8" />
                <TextBox x:Name="WaiterNameBox" FontSize="16" Height="44" Padding="8,10" 
                         Background="#1E293B" Foreground="White" BorderBrush="#334155" />
            </StackPanel>

            <!-- Tugmalar -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="BEKOR QILISH" Style="{StaticResource TouchDangerButton}" 
                        Click="OnCancelClick" />
                <Button Grid.Column="2" Content="STOLNI OCHISH" Style="{StaticResource TouchButtonStyle}" 
                        Click="OnConfirmClick" />
            </Grid>
        </Grid>
    </Border>
</Window>

