<Window x:Class="DilkashPos.Views.OpenTableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Stolni ochish"
        Width="512"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <controls:DialogChrome x:Name="Chrome" Title="Stol #1" Subtitle="Mehmonlar soni va ofitsiantni tanlang">
        <StackPanel Margin="24,20">
            <!-- Guest Count Header -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="Mehmonlar soni" Style="{StaticResource TextLabel}" VerticalAlignment="Center" />
                <TextBlock x:Name="SelectedGuestCountText"
                           Text="2 kishi"
                           Style="{StaticResource TextAmount}"
                           Foreground="{DynamicResource BrushPrimaryBright}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 6x2 Grid of 56px Numeric Chips (1..12) -->
            <UniformGrid x:Name="GuestButtonsGrid" Columns="6" Rows="2" Margin="-4,0,-4,18" />

            <!-- Waiter Field -->
            <controls:Field Label="Ofitsiant ismi" HelperText="Buyurtma chekida koʻrinadi">
                <TextBox x:Name="WaiterNameBox" />
            </controls:Field>
        </StackPanel>

        <controls:DialogChrome.FooterContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Bekor qilish"
                        Style="{StaticResource GhostButton}"
                        MinHeight="52"
                        Padding="20,10"
                        Click="OnCancelClick" />
                <Button Grid.Column="2"
                        Content="Stolni ochish"
                        Style="{StaticResource PrimaryButton}"
                        MinHeight="52"
                        Click="OnConfirmClick" />
            </Grid>
        </controls:DialogChrome.FooterContent>
    </controls:DialogChrome>
</Window>
