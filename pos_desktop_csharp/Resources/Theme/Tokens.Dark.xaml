<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- ========================================================= -->
    <!-- DILKASH CALM SLATE DARK PALETTE (NIGHT SHIFT)             -->
    <!-- ========================================================= -->

    <!-- Surfaces & Borders (Soft Charcoal Slate, no harsh neon black-green) -->
    <Color x:Key="ColorBg">#13161B</Color>
    <Color x:Key="ColorSurface">#1B1F26</Color>
    <Color x:Key="ColorSurfaceElevated">#242933</Color>
    <Color x:Key="ColorInput">#15181E</Color>
    <Color x:Key="ColorBorder">#2E3542</Color>
    <Color x:Key="ColorBorderSubtle">#242A35</Color>
    <Color x:Key="ColorBorderHover">#414B5C</Color>

    <!-- Ink & On-Fill Text -->
    <Color x:Key="ColorTextPrimary">#F1F5F9</Color>
    <Color x:Key="ColorTextSecondary">#A3B1C2</Color>
    <Color x:Key="ColorTextMuted">#8A99AD</Color>
    <Color x:Key="ColorTextOnPrimary">#FFFFFF</Color>
    <Color x:Key="ColorTextOnAmber">#FFFFFF</Color>
    <Color x:Key="ColorTextOnError">#FFFFFF</Color>

    <!-- Calm Emerald / Sage -->
    <Color x:Key="ColorPrimary">#0E7C5B</Color>
    <Color x:Key="ColorPrimaryBright">#34D399</Color>
    <Color x:Key="ColorPrimaryPressed">#0A6147</Color>
    <Color x:Key="ColorPrimaryTint">#132B24</Color>

    <!-- Warm Amber -->
    <Color x:Key="ColorAmber">#B45309</Color>
    <Color x:Key="ColorAmberBright">#FBBF24</Color>
    <Color x:Key="ColorAmberTint">#78350F</Color>
    <Color x:Key="ColorAmberTintSoft">#2B2214</Color>
    <Color x:Key="ColorBrandDot">#F59E0B</Color>

    <!-- Semantic States -->
    <Color x:Key="ColorSuccess">#0E7C5B</Color>
    <Color x:Key="ColorError">#DC2626</Color>
    <Color x:Key="ColorErrorBright">#FCA5A5</Color>
    <Color x:Key="ColorErrorTintSoft">#31181C</Color>
    <Color x:Key="ColorInfo">#3B82F6</Color>
    <Color x:Key="ColorReserved">#8B5CF6</Color>
    <Color x:Key="ColorReservedTint">#251E3A</Color>
    <Color x:Key="ColorReservedText">#DDD6FE</Color>
    <Color x:Key="ColorShadow">#000000</Color>

    <!-- Frozen SolidColorBrushes -->
    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushSurfaceElevated" Color="{StaticResource ColorSurfaceElevated}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushInput" Color="{StaticResource ColorInput}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushBorderHover" Color="{StaticResource ColorBorderHover}" po:Freeze="True" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushTextOnPrimary" Color="{StaticResource ColorTextOnPrimary}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushTextOnAmber" Color="{StaticResource ColorTextOnAmber}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushTextOnError" Color="{StaticResource ColorTextOnError}" po:Freeze="True" />

    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushPrimaryBright" Color="{StaticResource ColorPrimaryBright}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushPrimaryPressed" Color="{StaticResource ColorPrimaryPressed}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushPrimaryTint" Color="{StaticResource ColorPrimaryTint}" po:Freeze="True" />

    <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource ColorAmber}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushAmberBright" Color="{StaticResource ColorAmberBright}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushAmberTint" Color="{StaticResource ColorAmberTint}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushAmberTintSoft" Color="{StaticResource ColorAmberTintSoft}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushBrandDot" Color="{StaticResource ColorBrandDot}" po:Freeze="True" />

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushErrorBright" Color="{StaticResource ColorErrorBright}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushErrorTintSoft" Color="{StaticResource ColorErrorTintSoft}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushReserved" Color="{StaticResource ColorReserved}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushReservedTint" Color="{StaticResource ColorReservedTint}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushReservedText" Color="{StaticResource ColorReservedText}" po:Freeze="True" />

    <SolidColorBrush x:Key="BrushFocusRing" Color="#FBBF24" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushScrim" Color="#B8080A0E" po:Freeze="True" />

    <!-- Subtle Brand Girih Lattice Motif -->
    <DrawingBrush x:Key="BrushGirihLattice" TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute" Opacity="0.028" po:Freeze="True">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,64,64" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource BrushPrimaryBright}" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="64,64" />
                            <LineGeometry StartPoint="64,0" EndPoint="0,64" />
                            <LineGeometry StartPoint="32,0" EndPoint="64,32" />
                            <LineGeometry StartPoint="64,32" EndPoint="32,64" />
                            <LineGeometry StartPoint="32,64" EndPoint="0,32" />
                            <LineGeometry StartPoint="0,32" EndPoint="32,0" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
