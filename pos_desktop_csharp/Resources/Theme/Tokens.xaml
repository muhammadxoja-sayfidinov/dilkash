<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ========================================================= -->
    <!-- DILKASH DESIGN SYSTEM TOKENS (DARK THEME)                 -->
    <!-- Canonical source: packages/dilkash_design_system/tokens/  -->
    <!-- ========================================================= -->

    <!-- 1. Color Values -->
    <Color x:Key="ColorBg">#09100C</Color>
    <Color x:Key="ColorSurface">#111D17</Color>
    <Color x:Key="ColorSurfaceElevated">#182820</Color>
    <Color x:Key="ColorInput">#0D1712</Color>
    <Color x:Key="ColorBorder">#1E3529</Color>
    <Color x:Key="ColorBorderSubtle">#14241C</Color>
    <Color x:Key="ColorBorderHover">#2B4B3B</Color>

    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <!-- #8494A7 verified >= 4.97:1 on SurfaceElevated, 5.59:1 on Surface, 6.21:1 on Bg -->
    <Color x:Key="ColorTextMuted">#8494A7</Color>
    <!-- Pure white for semantic solid fills like Error (#E11D48 -> 4.70:1) -->
    <Color x:Key="ColorTextOnError">#FFFFFF</Color>

    <Color x:Key="ColorPrimary">#0D6B4E</Color>
    <Color x:Key="ColorPrimaryBright">#10B981</Color>
    <Color x:Key="ColorPrimaryPressed">#0A5840</Color>
    <Color x:Key="ColorPrimaryTint">#063628</Color>

    <Color x:Key="ColorAmber">#D97706</Color>
    <Color x:Key="ColorAmberBright">#F59E0B</Color>
    <Color x:Key="ColorAmberTint">#78350F</Color>
    <!-- 35% amber tint over Surface for readable AmberBright text (7.14:1) -->
    <Color x:Key="ColorAmberTintSoft">#36200D</Color>

    <Color x:Key="ColorSuccess">#059669</Color>
    <Color x:Key="ColorError">#E11D48</Color>
    <Color x:Key="ColorErrorBright">#FB7185</Color>
    <Color x:Key="ColorErrorTintSoft">#36121C</Color>
    <Color x:Key="ColorInfo">#2563EB</Color>
    <Color x:Key="ColorReserved">#8B5CF6</Color>
    <Color x:Key="ColorReservedTint">#2A1B4E</Color>
    <Color x:Key="ColorReservedText">#DDD6FE</Color>

    <!-- 2. Frozen SolidColorBrushes -->
    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushSurfaceElevated" Color="{StaticResource ColorSurfaceElevated}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushInput" Color="{StaticResource ColorInput}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushBorderHover" Color="{StaticResource ColorBorderHover}" po:Freeze="True" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushTextOnError" Color="{StaticResource ColorTextOnError}" po:Freeze="True" />

    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushPrimaryBright" Color="{StaticResource ColorPrimaryBright}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushPrimaryPressed" Color="{StaticResource ColorPrimaryPressed}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushPrimaryTint" Color="{StaticResource ColorPrimaryTint}" po:Freeze="True" />

    <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource ColorAmber}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushAmberBright" Color="{StaticResource ColorAmberBright}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushAmberTint" Color="{StaticResource ColorAmberTint}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushAmberTintSoft" Color="{StaticResource ColorAmberTintSoft}" po:Freeze="True" />

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushErrorBright" Color="{StaticResource ColorErrorBright}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushErrorTintSoft" Color="{StaticResource ColorErrorTintSoft}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushReserved" Color="{StaticResource ColorReserved}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushReservedTint" Color="{StaticResource ColorReservedTint}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrushReservedText" Color="{StaticResource ColorReservedText}" po:Freeze="True" />

    <!-- Keyboard Focus Ring Brush -->
    <SolidColorBrush x:Key="BrushFocusRing" Color="{StaticResource ColorAmberBright}" po:Freeze="True" />

    <!-- Scrim Backdrop Brush -->
    <SolidColorBrush x:Key="BrushScrim" Color="#CC050A07" po:Freeze="True" />

    <!-- 3. Corner Radii -->
    <CornerRadius x:Key="RadiusXs">6</CornerRadius>
    <CornerRadius x:Key="RadiusSm">10</CornerRadius>
    <CornerRadius x:Key="RadiusMd">14</CornerRadius>
    <CornerRadius x:Key="RadiusLg">18</CornerRadius>
    <CornerRadius x:Key="RadiusXl">24</CornerRadius>
    <CornerRadius x:Key="RadiusFull">16</CornerRadius>

    <!-- 4. Spacing Numbers (4/8 grid) -->
    <sys:Double x:Key="Space2">2</sys:Double>
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space20">20</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>
    <sys:Double x:Key="Space40">40</sys:Double>

    <!-- 5. Motion Durations & Easings -->
    <Duration x:Key="DurationPress">0:0:0.090</Duration>
    <Duration x:Key="DurationHover">0:0:0.140</Duration>
    <Duration x:Key="DurationModal">0:0:0.220</Duration>
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

    <!-- 6. Faint Brand Girih Lattice Motif (max 4% opacity) -->
    <DrawingBrush x:Key="BrushGirihLattice" TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute" Opacity="0.035" po:Freeze="True">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,64,64" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource BrushPrimaryBright}" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="64,64" />
                            <LineGeometry StartPoint="64,0" EndPoint="0,64" />
                            <LineGeometry StartPoint="32,0" EndPoint="64,32" />
                            <LineGeometry StartPoint="64,32" EndPoint="32,64" />
                            <LineGeometry StartPoint="32,64" EndPoint="0,32" />
                            <LineGeometry StartPoint="0,32" EndPoint="32,0" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
