<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ========================================================= -->
    <!-- DILKASH SHARED STRUCTURAL TOKENS (Radii, Spacing, Motion) -->
    <!-- Color palettes live in Tokens.Light.xaml / Tokens.Dark.xaml -->
    <!-- ========================================================= -->

    <!-- Corner Radii -->
    <CornerRadius x:Key="RadiusXs">6</CornerRadius>
    <CornerRadius x:Key="RadiusSm">10</CornerRadius>
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <CornerRadius x:Key="RadiusXl">20</CornerRadius>
    <CornerRadius x:Key="RadiusFull">16</CornerRadius>

    <!-- Spacing Numbers (4/8 grid) -->
    <sys:Double x:Key="Space2">2</sys:Double>
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space20">20</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>
    <sys:Double x:Key="Space40">40</sys:Double>

    <!-- Neutral Shadow Color (Available across all themes) -->
    <Color x:Key="ColorShadow">#0F172A</Color>

    <!-- Motion Durations & Easings -->
    <Duration x:Key="DurationPress">0:0:0.090</Duration>
    <Duration x:Key="DurationHover">0:0:0.140</Duration>
    <Duration x:Key="DurationModal">0:0:0.220</Duration>
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

</ResourceDictionary>
