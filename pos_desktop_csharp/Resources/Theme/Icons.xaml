    <!-- Vector Brand Monogram: Geometric "D" inside an emerald rounded square with one saffron dot -->
    <DrawingGroup x:Key="DrawingBrandMonogram">
        <!-- Rounded Square Container -->
        <GeometryDrawing Brush="{DynamicResource BrushPrimary}">
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="0,0,48,48" RadiusX="12" RadiusY="12" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- Subtle Border -->
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Brush="{DynamicResource BrushPrimaryBright}" Thickness="1.5" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="0,0,48,48" RadiusX="12" RadiusY="12" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- Geometric Letter D -->
        <GeometryDrawing Brush="{DynamicResource BrushTextPrimary}">
            <GeometryDrawing.Geometry>
                <PathGeometry Figures="M14 12 h8 a12 12 0 0 1 0 24 h-8 z M18 16 v16 h4 a8 8 0 0 0 0-16 z" FillRule="Nonzero" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- Saffron Attention Dot -->
        <GeometryDrawing Brush="{DynamicResource BrushAmberBright}">
            <GeometryDrawing.Geometry>
                <EllipseGeometry Center="36,12" RadiusX="3.5" RadiusY="3.5" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <!-- General Vector Icon Style for Path -->
    <Style x:Key="MonolineIconStyle" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

</ResourceDictionary>

