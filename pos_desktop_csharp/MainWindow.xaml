<Window x:Class="DilkashPos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Dilkash POS"
        Height="1080" Width="1920"
        MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BrushBg}"
        Loaded="OnWindowLoaded"
        SizeChanged="OnWindowSizeChanged"
        KeyDown="OnWindowKeyDown">
    <Grid>
        <!-- Main Workspace Shell (lightly blurred ONLY when locked) -->
        <Grid x:Name="WorkspaceShellGrid">
            <Grid.ColumnDefinitions>
                <!-- 1. Left Navigation Rail (88px >=1366, 80px <1366) -->
                <ColumnDefinition x:Name="RailColumn" Width="88" />
                <!-- 2. Main Workspace Canvas -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- LEFT NAVIGATION RAIL (88px / 80px)                        -->
            <!-- ========================================================= -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand Monogram Plate with faint Girih lattice -->
                    <Border Grid.Row="0"
                            Height="72"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Rectangle Fill="{DynamicResource BrushGirihLattice}" IsHitTestVisible="False" />
                            <Image Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image.Source>
                                    <DrawingImage Drawing="{StaticResource DrawingBrandMonogram}" />
                                </Image.Source>
                            </Image>
                        </Grid>
                    </Border>

                    <!-- Primary Navigation Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8">
                        <StackPanel>
                            <!-- 1. Stollar (F1) -->
                            <RadioButton x:Name="NavTablesBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="True"
                                         Click="OnNavClicked"
                                         Tag="tables">
                                <Grid>
                                    <Border x:Name="NavTablesCountBorder"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-2,2,0"
                                            Background="{DynamicResource BrushPrimary}"
                                            CornerRadius="{StaticResource RadiusFull}"
                                            Padding="6,1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="NavTablesCountBadge"
                                                   Text="0"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </Border>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                        <controls:Icon Data="{StaticResource IconTables}"
                                                       Size="22"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Stollar"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 2. Tezkor savdo (F2) -->
                            <RadioButton x:Name="NavQuickPosBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         Click="OnNavClicked"
                                         Tag="quick_pos">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                        <controls:Icon Data="{StaticResource IconQuickSale}"
                                                       Size="22"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Tezkor savdo"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   LineHeight="15"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 3. Stop-list -->
                            <RadioButton x:Name="NavStopListBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         Click="OnNavClicked"
                                         Tag="stop_list">
                                <Grid>
                                    <Border x:Name="NavStopListBadgeBorder"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-2,2,0"
                                            Background="{DynamicResource BrushError}"
                                            CornerRadius="{StaticResource RadiusFull}"
                                            Padding="6,1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="NavStopListCountBadge"
                                                   Text="0"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextOnError}"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </Border>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                        <controls:Icon Data="{StaticResource IconStop}"
                                                       Size="22"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Stop-list"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 4. Onlayn -->
                            <RadioButton x:Name="NavOnlineBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         Click="OnNavClicked"
                                         Tag="online">
                                <Grid>
                                    <Border x:Name="NavOnlineBadgeBorder"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-2,2,0"
                                            Background="{DynamicResource BrushAmber}"
                                            CornerRadius="{StaticResource RadiusFull}"
                                            Padding="6,1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="NavOnlineBadgeText"
                                                   Text="0"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushBg}"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </Border>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                        <controls:Icon Data="{StaticResource IconOnline}"
                                                       Size="22"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Onlayn"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 5. Smena -->
                            <RadioButton x:Name="NavShiftBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         Click="OnNavClicked"
                                         Tag="shift">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                        <controls:Icon Data="{StaticResource IconReport}"
                                                       Size="22"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Smena"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 6. Sozlamalar -->
                            <RadioButton x:Name="NavSettingsBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         Click="OnNavClicked"
                                         Tag="settings">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                        <controls:Icon Data="{StaticResource IconSettings}"
                                                       Size="22"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Sozlamalar"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextAlignment="Center"
                                                   TextTrimming="None"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom System Actions: Lock & Kiosk (F11) -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="0,1,0,0"
                            Padding="6,10">
                        <StackPanel>
                            <Button Style="{StaticResource GhostButton}"
                                    MinHeight="48"
                                    Padding="4,8"
                                    Margin="0,0,0,8"
                                    Click="OnLockAppClick"
                                    ToolTip="Ekranni qulflash">
                                <StackPanel>
                                    <controls:Icon Data="{StaticResource IconLock}" Size="20" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Qulf" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}"
                                    MinHeight="48"
                                    Padding="4,8"
                                    Click="OnToggleKioskClick"
                                    ToolTip="Kiosk rejimi (F11)">
                                <StackPanel>
                                    <controls:Icon Data="{StaticResource IconFullscreen}" Size="20" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="F11" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- RIGHT COLUMN: TOP BAR + OFFLINE STRIP + WORKSPACE CANVAS  -->
            <!-- ========================================================= -->
            <Grid Grid.Column="1" Background="{DynamicResource BrushBg}">
                <Grid.RowDefinitions>
                    <!-- Top Bar (64px) -->
                    <RowDefinition Height="64" />
                    <!-- Persistent Offline Amber Strip (Auto, collapsed when online) -->
                    <RowDefinition Height="Auto" />
                    <!-- Active Tab Workspace (*) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- TOP BAR (64px) -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,0,0,1"
                        Padding="20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Screen Title + Shift Chip -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ScreenTitleText"
                                       Text="Stollar"
                                       Style="{StaticResource TextSection}"
                                       VerticalAlignment="Center" />

                            <Border Background="{DynamicResource BrushSurfaceElevated}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusFull}"
                                    Padding="12,6"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:Icon Data="{StaticResource IconClock}"
                                                   Size="14"
                                                   Foreground="{DynamicResource BrushAmberBright}"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock x:Name="ShiftChipText"
                                               Text="Smena: 08:30 dan · 09:50"
                                               Style="{StaticResource TextTimer}"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: ConnectionPill + Clock + Cashier Avatar -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:ConnectionPill x:Name="TopConnectionPill" />

                            <Border Width="1" Height="28" Background="{DynamicResource BrushBorder}" Margin="16,0" VerticalAlignment="Center" />

                            <!-- Clock & Uzbek Date -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ClockText"
                                           Text="18:20"
                                           Style="{StaticResource TextTitle}"
                                           Typography.NumeralAlignment="Tabular"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DateText"
                                           Text="10-noyabr, seshanba"
                                           Style="{StaticResource TextCaption}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Width="1" Height="28" Background="{DynamicResource BrushBorder}" Margin="16,0" VerticalAlignment="Center" />

                            <!-- Cashier Avatar + Name -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34"
                                        CornerRadius="17"
                                        Background="{DynamicResource BrushPrimaryTint}"
                                        BorderBrush="{DynamicResource BrushPrimary}"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <controls:Icon Data="{StaticResource IconUser}"
                                                   Size="16"
                                                   Foreground="{DynamicResource BrushPrimaryBright}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="SidebarCashierNameText"
                                           Text="Jasur Rahimov"
                                           Style="{StaticResource TextLabel}"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PERSISTENT OFFLINE STRIP -->
                <Border x:Name="OfflineStrip"
                        Grid.Row="1"
                        Background="{DynamicResource BrushAmberTintSoft}"
                        BorderBrush="{DynamicResource BrushAmber}"
                        BorderThickness="0,0,0,1"
                        Padding="20,10"
                        Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon Data="{StaticResource IconWifiOff}"
                                           Size="18"
                                           Foreground="{DynamicResource BrushAmberBright}"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="Oflayn rejim — buyurtmalar lokal keshda saqlanmoqda"
                                       Style="{StaticResource TextLabel}"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{DynamicResource BrushAmber}"
                                CornerRadius="{StaticResource RadiusFull}"
                                Padding="12,4">
                            <TextBlock x:Name="OfflineStripQueueText"
                                       Text="Navbat: 0 ta"
                                       Style="{StaticResource TextCaption}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushBg}"
                                       Typography.NumeralAlignment="Tabular" />
                        </Border>
                    </Grid>
                </Border>

                <!-- WORKSPACE CANVAS -->
                <Grid Grid.Row="2" Background="{DynamicResource BrushBg}" Margin="16,14,16,14">

            <!-- ===================================================== -->
            <!-- 1. TAB: STOLLAR XARITASI (TABLES MAP VIEW)            -->
            <!-- ===================================================== -->
            <Grid x:Name="TablesTab" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Zone Segmented Filter (left) & Status Filter Chips (right) -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Segmented Zone Filter -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FilterAllBtn"
                                         GroupName="TableZoneFilter"
                                         Content="Barchasi (12)"
                                         Style="{StaticResource SegmentedItem}"
                                         IsChecked="True"
                                         Click="OnTableFilterAll" />
                            <RadioButton x:Name="FilterZalBtn"
                                         GroupName="TableZoneFilter"
                                         Content="Asosiy zal (6)"
                                         Style="{StaticResource SegmentedItem}"
                                         Click="OnTableFilterZal" />
                            <RadioButton x:Name="FilterTerrasaBtn"
                                         GroupName="TableZoneFilter"
                                         Content="Terrasa (3)"
                                         Style="{StaticResource SegmentedItem}"
                                         Click="OnTableFilterTerrasa" />
                            <RadioButton x:Name="FilterVipBtn"
                                         GroupName="TableZoneFilter"
                                         Content="VIP (3)"
                                         Style="{StaticResource SegmentedItem}"
                                         Click="OnTableFilterVip" />
                        </StackPanel>
                    </Border>

                    <!-- Status Filter Chips with Live Counts -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="StatusFilterEmptyChip"
                                      Style="{StaticResource ChipToggle}"
                                      Margin="0,0,8,0"
                                      Click="OnStatusFilterChipClick"
                                      Tag="empty">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="EmptyChipLabel" Text="Boʻsh (0)" Style="{StaticResource TextLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="StatusFilterOccupiedChip"
                                      Style="{StaticResource ChipToggle}"
                                      Margin="0,0,8,0"
                                      Click="OnStatusFilterChipClick"
                                      Tag="occupied">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushPrimaryBright}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="OccupiedChipLabel" Text="Band (0)" Style="{StaticResource TextLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="StatusFilterBillChip"
                                      Style="{StaticResource ChipToggle}"
                                      Margin="0,0,8,0"
                                      Click="OnStatusFilterChipClick"
                                      Tag="bill_printed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushAmberBright}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="BillChipLabel" Text="Hisob berildi (0)" Style="{StaticResource TextLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="StatusFilterReservedChip"
                                      Style="{StaticResource ChipToggle}"
                                      Click="OnStatusFilterChipClick"
                                      Tag="reserved">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushReserved}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ReservedChipLabel" Text="Bron (0)" Style="{StaticResource TextLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>

                <!-- Tables Content Area: Zone Sections / Loading Skeleton / EmptyState -->
                <Grid Grid.Row="1">
                    <!-- Populated Zone Sections -->
                    <ScrollViewer x:Name="TablesScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TableZonesItemsControl" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,18">
                                        <!-- Zone Header -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding ZoneTitle}"
                                                       Style="{StaticResource TextLabelCaps}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource BrushSurface}"
                                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusFull}"
                                                    Padding="8,2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ZoneSummary}"
                                                           Style="{StaticResource TextCaption}"
                                                           Typography.NumeralAlignment="Tabular" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Responsive Grid of TableCards (3 at 1366, 4 at 1920) -->
                                        <ItemsControl ItemsSource="{Binding Tables}" Margin="0,0,-12,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding Columns}" VerticalAlignment="Top" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <controls:TableCard Margin="0,0,12,12"
                                                                        CardClicked="OnTableCardControlClicked"
                                                                        PreChekClicked="OnTablePreChekClicked"
                                                                        PayClicked="OnTablePayClicked" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Loading Skeleton Grid -->
                    <UniformGrid x:Name="TablesLoadingGrid"
                                 Columns="4"
                                 VerticalAlignment="Top"
                                 Margin="0,8,-12,0"
                                 Visibility="Collapsed">
                        <controls:SkeletonBox Height="160" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="160" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="160" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="160" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="160" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="160" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="160" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="160" Margin="0,0,12,12" />
                    </UniformGrid>

                    <!-- EmptyState -->
                    <controls:EmptyState x:Name="TablesEmptyState"
                                         IconData="{StaticResource IconTables}"
                                         Title="Bu filtr boʻyicha stollar topilmadi"
                                         Subtitle="Boshqa zona yoki holat filtrini tanlab koʻring."
                                         ActionLabel="Filtrni tozalash"
                                         ActionClicked="OnResetTableFilters"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- 2. TAB: TEZKOR SAVDO (2-COLUMN RESPONSIVE ORDER UI)   -->
            <!-- ===================================================== -->
            <Grid x:Name="QuickPosTab" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <!-- Left: Category Bar + Search + Product Grid (Flex) -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <!-- Right: Cart Panel (440px >=1600, 380px <1600) -->
                    <ColumnDefinition x:Name="CartColumn" Width="440" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: CATEGORIES + SEARCH + PRODUCTS -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 56px Horizontal Scrollable Category Chip Bar -->
                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  PanningMode="HorizontalOnly"
                                  VerticalAlignment="Center">
                        <ScrollViewer.Style>
                            <Style TargetType="{x:Type ScrollViewer}">
                                <Setter Property="PanningMode" Value="HorizontalOnly" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                            <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"
                                                                    CanHorizontallyScroll="True"
                                                                    CanVerticallyScroll="False" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Style>

                        <ItemsControl x:Name="CategoryChipsItemsControl" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="PosCategoryChips"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 MinHeight="48" Height="48"
                                                 Padding="14,8"
                                                 Margin="0,0,8,0"
                                                 Cursor="Hand"
                                                 FocusVisualStyle="{x:Null}"
                                                 Stylus.IsPressAndHoldEnabled="False"
                                                 Stylus.IsFlicksEnabled="False"
                                                 Stylus.IsTapFeedbackEnabled="False"
                                                 Stylus.IsTouchFeedbackEnabled="False"
                                                 Click="OnCategoryChipClicked"
                                                 Tag="{Binding}">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="{x:Type RadioButton}">
                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="pressScale" ScaleX="1" ScaleY="1" />
                                                    </Grid.RenderTransform>
                                                    <Border x:Name="chipBorder"
                                                            Background="{DynamicResource BrushSurface}"
                                                            BorderBrush="{DynamicResource BrushBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="24"
                                                            Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <controls:Icon Size="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <controls:Icon.Style>
                                                                    <Style TargetType="{x:Type controls:Icon}" BasedOn="{StaticResource {x:Type controls:Icon}}">
                                                                        <Setter Property="Data" Value="{StaticResource IconBowl}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Department}" Value="all">
                                                                                <Setter Property="Data" Value="{StaticResource IconTables}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Department}" Value="shashlik">
                                                                                <Setter Property="Data" Value="{StaticResource IconGrill}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Department}" Value="somsa">
                                                                                <Setter Property="Data" Value="{StaticResource IconChef}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Department}" Value="fastfood">
                                                                                <Setter Property="Data" Value="{StaticResource IconBurger}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Department}" Value="bar">
                                                                                <Setter Property="Data" Value="{StaticResource IconCoffee}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </controls:Icon.Style>
                                                            </controls:Icon>
                                                            <TextBlock x:Name="chipText"
                                                                       Text="{Binding DisplayLabel}"
                                                                       Style="{StaticResource TextLabel}"
                                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="focusRing"
                                                            Margin="-1"
                                                            BorderBrush="{DynamicResource BrushFocusRing}"
                                                            BorderThickness="2"
                                                            CornerRadius="24"
                                                            Visibility="Collapsed"
                                                            IsHitTestVisible="False" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource BrushPrimary}" />
                                                        <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimaryBright}" />
                                                        <Setter TargetName="chipText" Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True" />
                                                            <Condition Property="IsChecked" Value="False" />
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource BrushSurfaceElevated}" />
                                                        <Setter TargetName="chipText" Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                                                    </MultiTrigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="{StaticResource DurationPress}" EasingFunction="{StaticResource EaseOut}" />
                                                                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="{StaticResource DurationPress}" EasingFunction="{StaticResource EaseOut}" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="{StaticResource DurationPress}" EasingFunction="{StaticResource EaseOut}" />
                                                                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="{StaticResource DurationPress}" EasingFunction="{StaticResource EaseOut}" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="focusRing" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Search Field -->
                    <controls:SearchBox x:Name="ProductSearchBox"
                                        Grid.Row="1"
                                        Placeholder="Taom nomi boʻyicha qidirish..."
                                        Margin="0,10,0,12"
                                        TextChanged="OnProductSearchChanged" />

                    <!-- Product Grid / EmptyState -->
                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="ProductsScrollViewer" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ProductsItemsControl" Margin="0,0,-12,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding ProductColumns, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:ProductTile Margin="0,0,12,12" TileClicked="OnProductTileClicked" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <controls:EmptyState x:Name="ProductsEmptyState"
                                             IconData="{StaticResource IconSearch}"
                                             Title="Taom topilmadi"
                                             Subtitle="Qidiruv soʻzini oʻzgartiring yoki boshqa toifani tanlang."
                                             ActionLabel="Filtrni tozalash"
                                             ActionClicked="OnResetProductFilter"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- RIGHT COLUMN: CART PANEL -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 1. Context Header + Ghost Clear -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="CartTitleText"
                                           Text="Saboy"
                                           Style="{StaticResource TextTitle}" />
                                <TextBlock x:Name="CartSubtitleText"
                                           Text="Kassir: Jasur Rahimov"
                                           Style="{StaticResource TextCaption}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButton}"
                                    MinHeight="48"
                                    Padding="12,8"
                                    Click="OnClearCartClick"
                                    ToolTip="Savatchani tozalash">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource IconTrash}" Size="16" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Tozalash" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 2. Cart Lines (Scrollable) -->
                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="CartLinesScrollViewer" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CartLinesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:CartLine Margin="0,0,0,8"
                                                               IncrementClicked="OnCartLineIncrement"
                                                               DecrementClicked="OnCartLineDecrement"
                                                               EditNoteClicked="OnCartLineEditNote" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Quiet Empty Cart Placeholder -->
                            <StackPanel x:Name="CartEmptyHint"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource BrushBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <controls:Icon Data="{StaticResource IconQuickSale}" Size="24" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Savatcha boʻsh" Style="{StaticResource TextBodyBold}" HorizontalAlignment="Center" />
                                <TextBlock Text="Taom qoʻshish uchun chapdan tanlang" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- 3. Financial Summary -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource BrushBg}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="12,10"
                                Margin="0,8,0,10">
                            <StackPanel>
                                <!-- Taomlar summasi -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Taomlar summasi" Style="{StaticResource TextLabel}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CartSubtotalText" Text="0&#160;soʻm" Style="{StaticResource TextAmount}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Chegirma Pill (F4) -->
                                <Grid Margin="0,2,0,4">
                                    <Button x:Name="DiscountPillBtn"
                                            Style="{StaticResource SecondaryButton}"
                                            MinHeight="48" Height="48"
                                            Padding="12,6"
                                            HorizontalAlignment="Left"
                                            Click="OnDiscountPillClick">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:Icon Data="{StaticResource IconTag}" Size="15" Foreground="{DynamicResource BrushAmberBright}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DiscountBtnLabelText" Text="Chegirma: 0%" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource KeycapBadge}" Margin="8,0,0,0">
                                                <TextBlock Text="F4" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="CartDiscountText"
                                               Text="-0&#160;soʻm"
                                               Style="{StaticResource TextAmount}"
                                               FontSize="15"
                                               Foreground="{DynamicResource BrushAmberBright}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- Xizmat haqi -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="ServiceFeeLabelText" Text="Xizmat haqi (10%)" Style="{StaticResource TextLabel}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CartServiceFeeText" Text="0&#160;soʻm" Style="{StaticResource TextAmount}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Hairline -->
                                <Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,2,0,8" />

                                <!-- Jami (40px Grand Total) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Jami"
                                               Style="{StaticResource TextTitle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="CartTotalText"
                                                   Text="0&#160;soʻm"
                                                   Style="{StaticResource TextGrandTotal}" />
                                    </Viewbox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. Actions: Send + Hisob, then Full-Width 72px Primary Pay -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="0.85*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="48" Height="48"
                                        Padding="8,8"
                                        Click="OnSendToKitchenClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:Icon Data="{StaticResource IconSendToKitchen}" Size="15" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Boʻlimlarga yuborish" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="48" Height="48"
                                        Padding="8,8"
                                        Click="OnPrintPreChekClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:Icon Data="{StaticResource IconReceipt}" Size="15" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Hisob" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Button Grid.Row="2"
                                    Style="{StaticResource PrimaryButton}"
                                    MinHeight="72" Height="72"
                                    Padding="16,12"
                                    HorizontalContentAlignment="Stretch"
                                    Click="OnPayCartClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:Icon Data="{StaticResource IconCash}" Size="22" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="PayButtonText"
                                                       Text="Toʻlov · 0&#160;soʻm"
                                                       Style="{StaticResource TextAmount}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Viewbox>
                                    <Border Grid.Column="1" Style="{StaticResource KeycapBadge}" VerticalAlignment="Center">
                                        <TextBlock Text="F12" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- 3. TAB: STOP-LIST BOSHQARUVI                          -->
            <!-- ===================================================== -->
            <Grid x:Name="StopListTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Bar: Search + 3 Filter Chips (Hammasi / Mavjud / Stop-listda) -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="380" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:SearchBox x:Name="StopListSearchBox"
                                        Grid.Column="0"
                                        Placeholder="Taom nomi boʻyicha qidirish..."
                                        TextChanged="OnStopListSearchChanged" />

                    <Border Grid.Column="2"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="StopFilterAllBtn"
                                         GroupName="StopListFilter"
                                         Content="Hammasi (0)"
                                         Style="{StaticResource SegmentedItem}"
                                         IsChecked="True"
                                         Click="OnStopListFilterClick"
                                         Tag="all" />
                            <RadioButton x:Name="StopFilterAvailableBtn"
                                         GroupName="StopListFilter"
                                         Content="Mavjud (0)"
                                         Style="{StaticResource SegmentedItem}"
                                         Click="OnStopListFilterClick"
                                         Tag="available" />
                            <RadioButton x:Name="StopFilterStoppedBtn"
                                         GroupName="StopListFilter"
                                         Content="Stop-listda (0)"
                                         Style="{StaticResource SegmentedItem}"
                                         Click="OnStopListFilterClick"
                                         Tag="stopped" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Content: Grid / Loading Skeleton / EmptyState -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="StopListScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="StopListItemsControl" Margin="0,0,-12,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding StopListColumns, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="16,14"
                                            Margin="0,0,12,12">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStopListed}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushError}" />
                                                        <Setter Property="Background" Value="{DynamicResource BrushErrorTintSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource TextBodyBold}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryName}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                                                    <TextBlock Text=" · " Style="{StaticResource TextCaptionMuted}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PriceFormatted}" Style="{StaticResource TextCaption}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <CheckBox Grid.Column="2"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding IsAvailable, Mode=TwoWay}"
                                                      Click="OnStopListToggleClicked"
                                                      Tag="{Binding}"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <UniformGrid x:Name="StopListLoadingGrid" Columns="3" VerticalAlignment="Top" Margin="0,0,-12,0" Visibility="Collapsed">
                        <controls:SkeletonBox Height="84" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="84" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="84" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="84" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="84" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="84" Margin="0,0,12,12" />
                    </UniformGrid>

                    <controls:EmptyState x:Name="StopListEmptyState"
                                         IconData="{StaticResource IconStop}"
                                         Title="Taom topilmadi"
                                         Subtitle="Qidiruv yoki filtr shartini oʻzgartirib koʻring."
                                         ActionLabel="Filtrni tozalash"
                                         ActionClicked="OnResetStopListFilter"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- 4. TAB: ONLAYN BUYURTMALAR (TELEGRAM & MOBIL ILOVA)   -->
            <!-- ===================================================== -->
            <Grid x:Name="OnlineTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Telegram bot va mobil ilovadan kelgan buyurtmalar"
                                   Style="{StaticResource TextBody}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButton}"
                            MinHeight="48"
                            Padding="16,10"
                            Click="OnRefreshOnlineOrdersClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon Data="{StaticResource IconRefresh}" Size="16" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Yangilash" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource KeycapBadge}" Margin="8,0,0,0">
                                <TextBlock Text="F5" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Content: Order Cards / Loading / EmptyState -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="OnlineScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OnlineOrdersItemsControl" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:OnlineOrderCard Margin="0,0,0,12" AcceptClicked="OnAcceptOnlineOrderClicked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="OnlineLoadingStack" Visibility="Collapsed">
                        <controls:SkeletonBox Height="156" Margin="0,0,0,12" />
                        <controls:SkeletonBox Height="156" Margin="0,0,0,12" />
                        <controls:SkeletonBox Height="156" />
                    </StackPanel>

                    <controls:EmptyState x:Name="OnlineEmptyState"
                                         IconData="{StaticResource IconOnline}"
                                         Title="Onlayn buyurtmalar yoʻq"
                                         Subtitle="Telegram bot yoki ilovadan yangi buyurtma tushganda bu yerda koʻrinadi."
                                         ActionLabel="Yangilash"
                                         ActionClicked="OnRefreshOnlineOrdersEmptyAction"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- 5. TAB: SMENA VA Z-HISOBOT                           -->
            <!-- ===================================================== -->
            <Grid x:Name="ShiftReportTab" Visibility="Collapsed">
                <Grid x:Name="ShiftContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 1. Hero Card: Jami tushum + X-hisobot & Smenani yopish -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}"
                            Padding="24,22"
                            Margin="0,0,0,16">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="JAMI TUSHUM" Style="{StaticResource TextLabelCaps}" />
                                <TextBlock x:Name="ShiftTotalRevenueText"
                                           Text="0&#160;soʻm"
                                           Style="{StaticResource TextGrandTotal}"
                                           Margin="0,6,0,6" />
                                <TextBlock x:Name="ShiftHeaderInfoText"
                                           Text="Smena ochiq · 08:30 dan · Kassir: Jasur Rahimov"
                                           Style="{StaticResource TextCaption}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}"
                                        MinHeight="52"
                                        Padding="20,12"
                                        Click="OnPrintXReportDirect">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:Icon Data="{StaticResource IconPrinter}" Size="18" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="X-hisobot" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- >=16px gap around destructive action per §10 -->
                                <Button Style="{StaticResource DangerButton}"
                                        MinHeight="52"
                                        Padding="20,12"
                                        Margin="16,0,0,0"
                                        Click="OnCloseShiftDirect">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:Icon Data="{StaticResource IconLock}" Size="18" Foreground="{DynamicResource BrushTextOnError}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Smenani yopish" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextOnError}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. 3-Up Payment Breakdown Row (Neutral surfaces, icon color only) -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:KpiCard x:Name="KpiCashCard"
                                          Grid.Column="0"
                                          Label="Naqd pul"
                                          Value="0&#160;soʻm"
                                          Subtitle="Kassa qutisida"
                                          IconData="{StaticResource IconCash}"
                                          IconForeground="{DynamicResource BrushPrimaryBright}" />

                        <controls:KpiCard x:Name="KpiCardCard"
                                          Grid.Column="2"
                                          Label="Karta / Terminal"
                                          Value="0&#160;soʻm"
                                          Subtitle="Bank terminali orqali"
                                          IconData="{StaticResource IconCard}"
                                          IconForeground="{DynamicResource BrushInfo}" />

                        <controls:KpiCard x:Name="KpiOnlineCard"
                                          Grid.Column="4"
                                          Label="Onlayn toʻlovlar"
                                          Value="0&#160;soʻm"
                                          Subtitle="Bot va mobil ilova"
                                          IconData="{StaticResource IconOnline}"
                                          IconForeground="{DynamicResource BrushAmberBright}" />
                    </Grid>

                    <!-- 3. Compact Secondary Stats Row -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="20,16"
                            Margin="0,0,0,16">
                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Text="Cheklar soni" Style="{StaticResource TextCaption}" />
                                <TextBlock x:Name="ShiftOrdersCountText" Text="0 ta" Style="{StaticResource TextTitle}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Xizmat haqi" Style="{StaticResource TextCaption}" />
                                <TextBlock x:Name="ShiftServiceFeeText" Text="0&#160;soʻm" Style="{StaticResource TextTitle}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Chegirmalar" Style="{StaticResource TextCaption}" />
                                <TextBlock x:Name="ShiftDiscountsText" Text="0&#160;soʻm" Style="{StaticResource TextTitle}" Foreground="{DynamicResource BrushAmberBright}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Oʻrtacha chek" Style="{StaticResource TextCaption}" />
                                <TextBlock x:Name="ShiftAvgCheckText" Text="0&#160;soʻm" Style="{StaticResource TextTitle}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- 4. Proportional Payment Mix & Sales Channels -->
                    <Border Grid.Row="3"
                            VerticalAlignment="Top"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="20,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Toʻlov usullari ulushi" Style="{StaticResource TextBodyBold}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ShiftPaymentMixLabel"
                                           Text="Naqd 61% · Karta 29% · Onlayn 10%"
                                           Style="{StaticResource TextCaption}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Height="12" Margin="0,0,0,18" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ShiftCashShareCol" Width="61*" />
                                    <ColumnDefinition x:Name="ShiftCardShareCol" Width="29*" />
                                    <ColumnDefinition x:Name="ShiftOnlineShareCol" Width="10*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BrushPrimaryBright}" CornerRadius="6,0,0,6" />
                                <Border Grid.Column="1" Background="{DynamicResource BrushInfo}" Margin="2,0" />
                                <Border Grid.Column="2" Background="{DynamicResource BrushAmberBright}" CornerRadius="0,6,6,0" />
                            </Grid>

                            <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                <UniformGrid Columns="2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushPrimaryBright}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Zal ichida (Stollar):" Style="{StaticResource TextBody}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ShiftDineInText" Text="0&#160;soʻm" Style="{StaticResource TextBodyBold}" Typography.NumeralAlignment="Tabular" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushAmberBright}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Saboy va onlayn:" Style="{StaticResource TextBody}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ShiftTakeawayText" Text="0&#160;soʻm" Style="{StaticResource TextBodyBold}" Typography.NumeralAlignment="Tabular" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Shift Loading Skeleton -->
                <StackPanel x:Name="ShiftLoadingState" Visibility="Collapsed">
                    <controls:SkeletonBox Height="140" Margin="0,0,0,16" />
                    <UniformGrid Columns="3" Margin="0,0,-14,16">
                        <controls:SkeletonBox Height="124" Margin="0,0,14,0" />
                        <controls:SkeletonBox Height="124" Margin="0,0,14,0" />
                        <controls:SkeletonBox Height="124" Margin="0,0,14,0" />
                    </UniformGrid>
                    <controls:SkeletonBox Height="88" />
                </StackPanel>

                <!-- Shift Empty State (when 0 orders in shift) -->
                <controls:EmptyState x:Name="ShiftEmptyState"
                                     IconData="{StaticResource IconReport}"
                                     Title="Smenada hali savdo yoʻq"
                                     Subtitle="Birinchi toʻlov qabul qilingandan soʻng smena koʻrsatkichlari bu yerda koʻrinadi."
                                     ActionLabel="Tezkor savdoga oʻtish"
                                     ActionClicked="OnShiftEmptyAction"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Visibility="Collapsed" />
            </Grid>

            <!-- ===================================================== -->
            <!-- 6. TAB: SOZLAMALAR (2-COLUMN + STICKY SAVE BAR)       -->
            <!-- ===================================================== -->
            <Grid x:Name="SettingsTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: 6 Department PrinterCards + AutoPrint Toggle -->
                        <StackPanel Grid.Column="0">
                            <controls:SectionHeader Title="Boʻlim printerlari (LAN 9100)"
                                                    Subtitle="Jonli ulanish holati va sinov cheki" />

                            <ItemsControl x:Name="PrintersItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:PrinterCard Margin="0,0,0,10"
                                                              TestPrintClicked="OnPrinterCardTestClick"
                                                              IpChanged="OnSettingsInputChanged" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{DynamicResource BrushSurface}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="16,12"
                                    Margin="0,4,0,0">
                                <CheckBox x:Name="AutoPrintCheck"
                                          Style="{StaticResource ToggleSwitch}"
                                          Content="Buyurtmada boʻlim printerlariga avtomatik chek chiqarish"
                                          IsChecked="True"
                                          Click="OnSettingsCheckChanged" />
                            </Border>
                        </StackPanel>

                        <!-- Right: Server va xizmat haqi Fields -->
                        <StackPanel Grid.Column="2">
                            <controls:SectionHeader Title="Server va xizmat haqi"
                                                    Subtitle="Tarmoq ulanishi, zal xizmati va kassir" />

                            <Border Background="{DynamicResource BrushSurface}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="20">
                                <StackPanel>
                                    <controls:Field Label="Server manzili" HelperText="Lokal tarmoq yoki asosiy server manzili" Margin="0,0,0,16">
                                        <TextBox x:Name="ServerUrlBox" Text="http://127.0.0.1:8000" TextChanged="OnSettingsTextChanged" />
                                    </controls:Field>

                                    <controls:Field Label="Xizmat haqi turi" Margin="0,0,0,16">
                                        <ComboBox x:Name="ServiceFeeTypeCombo" SelectionChanged="OnSettingsComboChanged">
                                            <ComboBoxItem Content="Foizli (%)" IsSelected="True" Tag="percent" />
                                            <ComboBoxItem Content="Odam boshiga (soʻm)" Tag="per_person" />
                                            <ComboBoxItem Content="Xizmat haqi yoʻq (0%)" Tag="none" />
                                        </ComboBox>
                                    </controls:Field>

                                    <controls:Field Label="Xizmat haqi miqdori" HelperText="Foiz (%) yoki har bir mehmon uchun soʻm" Margin="0,0,0,16">
                                        <TextBox x:Name="ServiceFeeValueBox" Text="10" Typography.NumeralAlignment="Tabular" TextChanged="OnSettingsTextChanged" />
                                    </controls:Field>

                                    <controls:Field Label="Kassir ismi">
                                        <TextBox x:Name="CashierNameBox" Text="Jasur Rahimov" TextChanged="OnSettingsTextChanged" />
                                    </controls:Field>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Settings Loading Skeleton -->
                <Grid x:Name="SettingsLoadingState" Grid.Row="0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <controls:SkeletonBox Height="74" Margin="0,0,0,10" />
                        <controls:SkeletonBox Height="74" Margin="0,0,0,10" />
                        <controls:SkeletonBox Height="74" Margin="0,0,0,10" />
                        <controls:SkeletonBox Height="74" Margin="0,0,0,10" />
                    </StackPanel>
                    <controls:SkeletonBox Grid.Column="2" Height="360" />
                </Grid>

                <!-- Sticky Bottom Save Bar (Visible ONLY when dirty) -->
                <Border x:Name="SettingsDirtyBar"
                        Grid.Row="1"
                        Background="{DynamicResource BrushSurfaceElevated}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="20,12"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon Data="{StaticResource IconAlert}" Size="18" Foreground="{DynamicResource BrushAmberBright}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Sozlamalarda saqlanmagan oʻzgarishlar bor" Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Bekor qilish"
                                    Style="{StaticResource GhostButton}"
                                    MinHeight="48"
                                    Margin="0,0,8,0"
                                    Click="OnDiscardSettingsClick" />
                            <Button Content="Saqlash"
                                    Style="{StaticResource PrimaryButton}"
                                    MinHeight="48"
                                    Padding="24,10"
                                    Click="OnSaveSettingsClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- MODAL BACKDROP SCRIM -->
        <Border x:Name="ModalScrim"
                Background="{DynamicResource BrushScrim}"
                Visibility="Collapsed"
                IsHitTestVisible="True" />

        <!-- LOCK SCREEN OVERLAY -->
        <Grid x:Name="LockOverlay"
              Background="{DynamicResource BrushScrim}"
              Visibility="Collapsed"
              IsHitTestVisible="True">
            <Rectangle Fill="{DynamicResource BrushGirihLattice}" IsHitTestVisible="False" />
            <Border Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusXl}"
                    Padding="48,40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="380">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.6" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Image Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Image.Source>
                            <DrawingImage Drawing="{StaticResource DrawingBrandMonogram}" />
                        </Image.Source>
                    </Image>

                    <Border Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusFull}"
                            Padding="14,6"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconUser}" Size="15" Foreground="{DynamicResource BrushPrimaryBright}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="LockCashierNameText" Text="Jasur Rahimov" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Ekran qulflangan"
                               Style="{StaticResource TextSection}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Ishni davom ettirish uchun Ochish tugmasini bosing"
                               Style="{StaticResource TextBody}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28" />

                    <Button Content="Ochish"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="56"
                            Width="220"
                            HorizontalAlignment="Center"
                            Click="OnUnlockAppClick" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- TOAST HOST (Bottom-Center) -->
        <controls:ToastHost x:Name="MainToastHost" />
    </Grid>
</Window>