<Window x:Class="DilkashPos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dilkash Restaurant POS (Kassa Tizimi)" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BgDarkBrush}"
        Loaded="OnWindowLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- YUQORI STATUS VA NAVIGATSIYA PANELI (HEADER) -->
        <Border Grid.Row="0" Background="{StaticResource BrandDarkBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brend Logo va Nomi -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrandLightBrush}" CornerRadius="8" Width="44" Height="44" Margin="0,0,12,0">
                        <TextBlock Text="🍵" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DILKASH POS" FontSize="20" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="KASSA VA RESTORAN BOSHQARUVI" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Markaziy Navigatsiya Tugmalari (Asosiy Modullar) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="NavTablesBtn" Content="🍽 STOLLAR XARITASI" Margin="4,0" Padding="16,8" Style="{StaticResource TouchButtonStyle}" Click="OnNavClicked" Tag="tables" />
                    <Button x:Name="NavQuickPosBtn" Content="⚡ TEZKOR SABOY" Margin="4,0" Padding="16,8" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNavClicked" Tag="quick_pos" />
                    <Button x:Name="NavStopListBtn" Content="🛑 STOP-LIST" Margin="4,0" Padding="16,8" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNavClicked" Tag="stop_list" />
                    <Button x:Name="NavOnlineBtn" Content="📲 ONLINE BUYURTMALAR" Margin="4,0" Padding="16,8" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNavClicked" Tag="online" />
                    <Button x:Name="NavSettingsBtn" Content="⚙ PRINTER &amp; SOZLAMALAR" Margin="4,0" Padding="16,8" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNavClicked" Tag="settings" />
                </StackPanel>

                <!-- O'ng Tomon: Soat, Statuslar va Kiosk Rejimi -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Online / Offline Indikatori -->
                    <Border x:Name="StatusBadgeBorder" Background="{StaticResource SuccessGreenBrush}" CornerRadius="16" Padding="12,6" Margin="0,0,12,0">
                        <TextBlock x:Name="StatusBadgeText" Text="● ONLINE" FontSize="12" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <!-- Offline Queue Indikatori -->
                    <Border x:Name="QueueBadgeBorder" Background="{StaticResource AccentGoldBrush}" CornerRadius="16" Padding="10,6" Margin="0,0,12,0" Visibility="Collapsed">
                        <TextBlock x:Name="QueueBadgeText" Text="⏳ Navbat: 0" FontSize="12" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <!-- Soat -->
                    <TextBlock x:Name="ClockText" Text="20:00:00" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <!-- Kiosk / To'liq Ekran Tugmasi -->
                    <Button Content="⛶ KIOSK" Width="80" Height="40" FontSize="12" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnToggleKioskClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ASOSIY ISH MAYDONI (MAIN CONTENT HOST) -->
        <Grid Grid.Row="1" Margin="16">
            <!-- 1. TAB: STOLLAR XARITASI -->
            <Grid x:Name="TablesTab" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filtr paneli -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Zallar bo'yicha:" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Barcha Stollar" Style="{StaticResource TouchButtonStyle}" Height="40" Margin="0,0,8,0" Click="OnTableFilterAll" />
                    <Button Content="Asosiy Zal" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Height="40" Margin="0,0,8,0" Click="OnTableFilterZal" />
                    <Button Content="VIP Xonalar" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Height="40" Margin="0,0,8,0" Click="OnTableFilterVip" />
                    
                    <TextBlock x:Name="TablesSummaryText" Text="Jami: 12 ta | Band: 2 ta | Bo'sh: 10 ta" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="24,0,0,0" />
                </StackPanel>

                <!-- Stollar panjarasi (Scrollable Grid) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="TablesWrapPanel" Margin="0,0,0,20">
                        <!-- Stol kartochkalari kod orqali dinamik yaratiladi -->
                    </WrapPanel>
                </ScrollViewer>
            </Grid>

            <!-- 2. TAB: TEZKOR SABOY (QUICK TAKEAWAY POS) -->
            <Grid x:Name="QuickPosTab" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!-- Chap: Kategoriyalar -->
                <Border Grid.Column="0" Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="10" Margin="0,0,12,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CategoriesStackPanel">
                            <!-- Kategoriya tugmalari -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- O'rta: Taomlar panjarasi -->
                <Grid Grid.Column="1" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="ProductSearchBox" Grid.Row="0" Height="44" Padding="12,10" FontSize="15" 
                             Background="{StaticResource CardDarkBrush}" Foreground="White" BorderBrush="#334155"
                             Margin="0,0,0,12" TextChanged="OnProductSearchChanged" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ProductsWrapPanel">
                            <!-- Taomlar kartochkalari -->
                        </WrapPanel>
                    </ScrollViewer>
                </Grid>

                <!-- O'ng: Buyurtma Cheki Savatchasi (Receipt Cart) -->
                <Border Grid.Column="2" Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Chek Sarlavhasi -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock x:Name="CartTitleText" Text="TEZKOR SABOY #01" FontSize="18" FontWeight="Bold" Foreground="White" />
                            <Button Content="Tozalash" HorizontalAlignment="Right" Padding="10,4" Style="{StaticResource TouchDangerButton}" Height="34" FontSize="12" Click="OnClearCartClick" />
                        </Grid>

                        <!-- Elementlar ro'yxati -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CartItemsStackPanel">
                                <!-- Savatcha elementlari -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Hisob-kitob qismi -->
                        <Border Grid.Row="2" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="0,12,0,12" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Taomlar summasi:" FontSize="14" Foreground="#94A3B8" />
                                    <TextBlock x:Name="CartSubtotalText" Text="0 so'm" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Xizmat haqi:" FontSize="14" Foreground="#94A3B8" />
                                    <TextBlock x:Name="CartServiceFeeText" Text="0 so'm" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="JAMI TO'LOV:" FontSize="18" FontWeight="Bold" Foreground="White" />
                                    <TextBlock x:Name="CartTotalText" Text="0 so'm" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- To'lash Tugmasi -->
                        <Button Grid.Row="3" Content="TO'LASH VA CHEK CHIQARISH" Height="64" FontSize="18" FontWeight="Bold"
                                Style="{StaticResource TouchButtonStyle}" Background="{StaticResource SuccessGreenBrush}" Click="OnPayCartClick" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. TAB: STOP-LIST BOSHQARUVI -->
            <Grid x:Name="StopListTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="STOP-LIST: Tugagan taomlarni bitta bosish bilan o'chiring" FontSize="18" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="O'chirilgan taomlar darhol Telegram bot va mobil ilovada ham ko'rinmaydi" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,8" />
                    <TextBox x:Name="StopListSearchBox" Height="44" Padding="12,10" FontSize="15" 
                             Background="{StaticResource CardDarkBrush}" Foreground="White" BorderBrush="#334155"
                             TextChanged="OnStopListSearchChanged" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="StopListWrapPanel">
                        <!-- Stop-list kartochkalari -->
                    </WrapPanel>
                </ScrollViewer>
            </Grid>

            <!-- 4. TAB: ONLINE BUYURTMALAR -->
            <Grid x:Name="OnlineTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Telegram Bot va Mobil Ilovadan yangi buyurtmalar" FontSize="18" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Buyurtmani qabul qiling va oshxona printerlariga avtomatik chek chiqaring" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OnlineOrdersStackPanel">
                        <!-- Online buyurtmalar kartochkalari -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 5. TAB: PRINTERLAR VA SOZLAMALAR -->
            <Grid x:Name="SettingsTab" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Tarmoq Printerlari Sozlamalari (LAN ESC/POS IP: 9100)" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" />
                        <TextBlock Text="Har bir bo'limga tegishli printer IP manzilini kiriting va sinov chekini chiqarib ko'ring" FontSize="14" Foreground="#94A3B8" Margin="0,0,0,20" />

                        <!-- Printerlar ro'yxati -->
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Kassa Printeri -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🧾 Kassa Printeri IP:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="IpKassaBox" Grid.Column="1" Text="192.168.1.100:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnTestPrintKassa" />
                                </Grid>

                                <!-- Shashlikxona -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🥩 Shashlikxona IP:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="IpShashlikBox" Grid.Column="1" Text="192.168.1.101:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnTestPrintShashlik" />
                                </Grid>

                                <!-- Somsaxona -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🥟 Somsaxona IP:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="IpSomsaBox" Grid.Column="1" Text="192.168.1.102:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnTestPrintSomsa" />
                                </Grid>

                                <!-- Issiq Oshxona -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🍲 Issiq Oshxona IP:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="IpKitchenBox" Grid.Column="1" Text="192.168.1.103:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnTestPrintKitchen" />
                                </Grid>

                                <!-- Fast-Food -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🍔 Fast-Food IP:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="IpFastfoodBox" Grid.Column="1" Text="192.168.1.104:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnTestPrintFastfood" />
                                </Grid>

                                <!-- Bar & Desert -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="☕ Bar &amp; Desert IP:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="IpBarBox" Grid.Column="1" Text="192.168.1.105:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnTestPrintBar" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Server Manzili va Xizmat haqi -->
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Server va Xizmat Haqini Sozlash" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,14" />
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Django Server URL:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="ServerUrlBox" Grid.Column="1" Text="http://127.0.0.1:8000" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Xizmat haqi (Foizda):" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="ServiceFeePercentBox" Grid.Column="1" Text="10" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="SOZLAMALARNI SAQLASH" Height="56" FontSize="18" FontWeight="Bold"
                                Style="{StaticResource TouchButtonStyle}" Background="{StaticResource BrandPrimaryBrush}" Click="OnSaveSettingsClick" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
