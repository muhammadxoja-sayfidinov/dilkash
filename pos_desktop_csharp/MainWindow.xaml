<Window x:Class="DilkashPos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DilkashPos.Controls"
        Title="Dilkash POS"
        Icon="pack://application:,,,/Resources/App.ico"
        Height="1080" Width="1920"
        MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        TextElement.Foreground="{DynamicResource BrushTextPrimary}"
        Loaded="OnWindowLoaded"
        SizeChanged="OnWindowSizeChanged"
        KeyDown="OnWindowKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <!-- Main Workspace Shell (lightly blurred ONLY when locked) -->
        <Grid x:Name="WorkspaceShellGrid">
            <Grid.ColumnDefinitions>
                <!-- 1. Left Navigation Rail (88px >=1366, 80px <1366) -->
                <ColumnDefinition x:Name="RailColumn" Width="88" />
                <!-- 2. Main Workspace Canvas -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- LEFT NAVIGATION RAIL (88px / 80px)                        -->
            <!-- ========================================================= -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand Monogram Plate with faint Girih lattice -->
                    <Border Grid.Row="0"
                            Height="56"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Rectangle Fill="{DynamicResource BrushGirihLattice}" IsHitTestVisible="False" />
                            <Image Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image.Source>
                                    <DrawingImage Drawing="{StaticResource DrawingBrandMonogram}" />
                                </Image.Source>
                            </Image>
                        </Grid>
                    </Border>

                    <!-- Primary Navigation Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8">
                        <StackPanel>
                            <!-- 1. Stollar (F1) -->
                            <RadioButton x:Name="NavTablesBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         IsChecked="True"
                                         Click="OnNavClicked"
                                         Tag="tables">
                                <Grid>
                                    <Border x:Name="NavTablesCountBorder"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-2,2,0"
                                            Background="{DynamicResource BrushPrimary}"
                                            CornerRadius="{StaticResource RadiusFull}"
                                            Padding="6,1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="NavTablesCountBadge"
                                                   Text="0"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextOnPrimary}"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </Border>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3">
                                        <controls:Icon Data="{StaticResource IconTables}"
                                                       Size="20"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Stollar"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 2. Tezkor savdo (F2) -->
                            <RadioButton x:Name="NavQuickPosBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         Click="OnNavClicked"
                                         Tag="quick_pos">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3">
                                        <controls:Icon Data="{StaticResource IconQuickSale}"
                                                       Size="20"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Tezkor savdo"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   LineHeight="14"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 3. Stop-list -->
                            <RadioButton x:Name="NavStopListBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         Click="OnNavClicked"
                                         Tag="stop_list">
                                <Grid>
                                    <Border x:Name="NavStopListBadgeBorder"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-2,2,0"
                                            Background="{DynamicResource BrushError}"
                                            CornerRadius="{StaticResource RadiusFull}"
                                            Padding="6,1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="NavStopListCountBadge"
                                                   Text="0"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextOnError}"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </Border>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3">
                                        <controls:Icon Data="{StaticResource IconStop}"
                                                       Size="20"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Stop-list"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 4. Onlayn -->
                            <RadioButton x:Name="NavOnlineBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         Click="OnNavClicked"
                                         Tag="online">
                                <Grid>
                                    <Border x:Name="NavOnlineBadgeBorder"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-2,2,0"
                                            Background="{DynamicResource BrushAmber}"
                                            CornerRadius="{StaticResource RadiusFull}"
                                            Padding="6,1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="NavOnlineBadgeText"
                                                   Text="0"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextOnAmber}"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </Border>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3">
                                        <controls:Icon Data="{StaticResource IconOnline}"
                                                       Size="20"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Onlayn"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 5. Smena -->
                            <RadioButton x:Name="NavShiftBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         Click="OnNavClicked"
                                         Tag="shift">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3">
                                        <controls:Icon Data="{StaticResource IconReport}"
                                                       Size="20"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Smena"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 6. Boshqaruv (Taomlar, Guruhlar, Xodimlar, Stollar) -->
                            <RadioButton x:Name="NavManageBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         Click="OnNavClicked"
                                         Tag="manage">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3">
                                        <controls:Icon Data="{StaticResource IconEdit}"
                                                       Size="20"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Boshqaruv"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextAlignment="Center"
                                                   TextTrimming="None"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 7. Omborxona (Inventory & Tech-cards) -->
                            <RadioButton x:Name="NavInventoryBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         Click="OnNavClicked"
                                         Tag="inventory">
                                <Grid>
                                    <Border x:Name="NavInventoryLowStockBadgeBorder"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-2,2,0"
                                            Background="{DynamicResource BrushError}"
                                            CornerRadius="{StaticResource RadiusFull}"
                                            Padding="5,1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="NavInventoryLowStockBadgeText"
                                                   Text="0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextOnError}"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </Border>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3">
                                        <controls:Icon Data="{StaticResource IconWarehouse}"
                                                       Size="20"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Omborxona"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <!-- 8. Sozlamalar -->
                            <RadioButton x:Name="NavSettingsBtn"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavRailItem}"
                                         Click="OnNavClicked"
                                         Tag="settings">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3">
                                        <controls:Icon Data="{StaticResource IconSettings}"
                                                       Size="20"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                       HorizontalAlignment="Center" />
                                        <TextBlock Text="Sozlamalar"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   TextAlignment="Center"
                                                   TextTrimming="None"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom System Actions: Lock & Kiosk (F11) -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="0,1,0,0"
                            Padding="6,10">
                        <StackPanel>
                            <Button Style="{StaticResource GhostButton}"
                                    MinHeight="48"
                                    Padding="4,8"
                                    Margin="0,0,0,8"
                                    Click="OnLockAppClick"
                                    ToolTip="Ekranni qulflash">
                                <StackPanel>
                                    <controls:Icon Data="{StaticResource IconLock}" Size="20" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Qulf" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}"
                                    MinHeight="48"
                                    Padding="4,8"
                                    Click="OnToggleKioskClick"
                                    ToolTip="Kiosk rejimi (F11)">
                                <StackPanel>
                                    <controls:Icon Data="{StaticResource IconFullscreen}" Size="20" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="F11" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- RIGHT COLUMN: TOP BAR + OFFLINE STRIP + WORKSPACE CANVAS  -->
            <!-- ========================================================= -->
            <Grid Grid.Column="1" Background="{DynamicResource BrushBg}">
                <Grid.RowDefinitions>
                    <!-- Top Bar (56px) -->
                    <RowDefinition Height="56" />
                    <!-- Persistent Offline Amber Strip (Auto, collapsed when online) -->
                    <RowDefinition Height="Auto" />
                    <!-- Active Tab Workspace (*) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- TOP BAR (56px) -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,0,0,1"
                        Padding="18,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Screen Title + Shift Chip -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ScreenTitleText"
                                       Text="Stollar"
                                       Style="{StaticResource TextSection}"
                                       VerticalAlignment="Center" />

                            <Border Background="{DynamicResource BrushSurfaceElevated}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusFull}"
                                    Padding="12,6"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:Icon Data="{StaticResource IconClock}"
                                                   Size="14"
                                                   Foreground="{DynamicResource BrushAmberBright}"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock x:Name="ShiftChipText"
                                               Text="Smena: 08:30 dan · 09:50"
                                               Style="{StaticResource TextTimer}"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: Theme Toggle + ConnectionPill + Clock + Cashier Avatar -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ThemeToggleBtn"
                                    Style="{StaticResource SecondaryButton}"
                                    MinHeight="40" Height="40"
                                    Padding="12,6"
                                    Margin="0,0,10,0"
                                    Click="OnToggleThemeClick"
                                    ToolTip="Kunduzgi / Tungi mavzu">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:Icon x:Name="ThemeToggleIcon"
                                                   Data="{StaticResource IconMoon}"
                                                   Size="15"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock x:Name="ThemeToggleText"
                                               Text="Tun"
                                               Style="{StaticResource TextLabel}"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <controls:ConnectionPill x:Name="TopConnectionPill" />

                            <Border Width="1" Height="24" Background="{DynamicResource BrushBorder}" Margin="14,0" VerticalAlignment="Center" />

                            <!-- Clock & Uzbek Date -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ClockText"
                                           Text="18:20"
                                           Style="{StaticResource TextTitle}"
                                           Typography.NumeralAlignment="Tabular"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DateText"
                                           Text="10-noyabr, seshanba"
                                           Style="{StaticResource TextCaption}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Width="1" Height="24" Background="{DynamicResource BrushBorder}" Margin="14,0" VerticalAlignment="Center" />

                            <!-- Cashier Avatar + Name (Clickable -> Kassir Profili) -->
                            <Button x:Name="TopBarCashierBtn"
                                    Style="{StaticResource GhostButton}"
                                    MinHeight="40" Height="42"
                                    Padding="8,4"
                                    Click="OnTopBarCashierProfileClick"
                                    ToolTip="Kassir profili va shaxsiy sozlamalar">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="TopBarCashierAvatarBorder"
                                            Width="32" Height="32"
                                            CornerRadius="16"
                                            Background="{DynamicResource BrushPrimaryTint}"
                                            BorderBrush="{DynamicResource BrushPrimary}"
                                            BorderThickness="1"
                                            Margin="0,0,8,0">
                                        <TextBlock x:Name="TopBarCashierInitialsText"
                                                   Text="JR"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushPrimaryBright}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="SidebarCashierNameText"
                                                   Text="Jasur Rahimov"
                                                   Style="{StaticResource TextLabel}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock x:Name="TopBarCashierRoleText"
                                                   Text="Bosh kassir"
                                                   Style="{StaticResource TextCaptionMuted}"
                                                   FontSize="10.5" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PERSISTENT OFFLINE STRIP -->
                <Border x:Name="OfflineStrip"
                        Grid.Row="1"
                        Background="{DynamicResource BrushAmberTintSoft}"
                        BorderBrush="{DynamicResource BrushAmber}"
                        BorderThickness="0,0,0,1"
                        Padding="20,10"
                        Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon Data="{StaticResource IconWifiOff}"
                                           Size="18"
                                           Foreground="{DynamicResource BrushAmberBright}"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="Oflayn rejim — buyurtmalar lokal keshda saqlanmoqda"
                                       Style="{StaticResource TextLabel}"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{DynamicResource BrushAmber}"
                                CornerRadius="{StaticResource RadiusFull}"
                                Padding="12,4">
                            <TextBlock x:Name="OfflineStripQueueText"
                                       Text="Navbat: 0 ta"
                                       Style="{StaticResource TextCaption}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextOnAmber}"
                                       Typography.NumeralAlignment="Tabular" />
                        </Border>
                    </Grid>
                </Border>

                <!-- WORKSPACE CANVAS -->
                <Grid Grid.Row="2" Background="{DynamicResource BrushBg}" Margin="16,14,16,14">

            <!-- ===================================================== -->
            <!-- 1. TAB: STOLLAR XARITASI (TABLES MAP VIEW)            -->
            <!-- ===================================================== -->
            <Grid x:Name="TablesTab" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Zone Segmented Filter (left) & Status Filter Chips (right) -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Dynamic Segmented Hall Filter -->
                    <Border Grid.Column="0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="4"
                            VerticalAlignment="Center">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                            <ItemsControl x:Name="HallFilterItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="TableZoneFilter"
                                                     Content="{Binding DisplayLabel}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     Style="{StaticResource SegmentedItem}"
                                                     Tag="{Binding}"
                                                     Click="OnHallFilterClicked" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Status Filter Chips with Live Counts -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="StatusFilterEmptyChip"
                                      Style="{StaticResource ChipToggle}"
                                      Margin="0,0,8,0"
                                      Click="OnStatusFilterChipClick"
                                      Tag="empty">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="EmptyChipLabel" Text="Boʻsh (0)" Style="{StaticResource TextLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="StatusFilterOccupiedChip"
                                      Style="{StaticResource ChipToggle}"
                                      IsChecked="True"
                                      Margin="0,0,8,0"
                                      Click="OnStatusFilterChipClick"
                                      Tag="occupied">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushPrimaryBright}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="OccupiedChipLabel" Text="Band (0)" Style="{StaticResource TextLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="StatusFilterBillChip"
                                      Style="{StaticResource ChipToggle}"
                                      Margin="0,0,8,0"
                                      Click="OnStatusFilterChipClick"
                                      Tag="bill_printed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushAmberBright}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="BillChipLabel" Text="Hisob berildi (0)" Style="{StaticResource TextLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="StatusFilterReservedChip"
                                      Style="{StaticResource ChipToggle}"
                                      Click="OnStatusFilterChipClick"
                                      Tag="reserved">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushReserved}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ReservedChipLabel" Text="Bron (0)" Style="{StaticResource TextLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>

                <!-- Tables Content Area: Zone Sections / Loading Skeleton / EmptyState -->
                <Grid Grid.Row="1">
                    <!-- Populated Zone Sections -->
                    <ScrollViewer x:Name="TablesScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TableZonesItemsControl" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,18">
                                        <!-- Zone Header -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding ZoneTitle}"
                                                       Style="{StaticResource TextLabelCaps}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource BrushSurface}"
                                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusFull}"
                                                    Padding="8,2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ZoneSummary}"
                                                           Style="{StaticResource TextCaption}"
                                                           Typography.NumeralAlignment="Tabular" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Responsive Grid of TableCards (3 at 1366, 4 at 1920) -->
                                        <ItemsControl ItemsSource="{Binding Tables}" Margin="0,0,-12,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding Columns}" VerticalAlignment="Top" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <controls:TableCard Margin="0,0,12,12"
                                                                        CardClicked="OnTableCardControlClicked"
                                                                        PreChekClicked="OnTablePreChekClicked"
                                                                        PayClicked="OnTablePayClicked" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Loading Skeleton Grid -->
                    <UniformGrid x:Name="TablesLoadingGrid"
                                 Columns="4"
                                 VerticalAlignment="Top"
                                 Margin="0,8,-12,0"
                                 Visibility="Collapsed">
                        <controls:SkeletonBox Height="146" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="146" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="146" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="146" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="146" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="146" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="146" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="146" Margin="0,0,12,12" />
                    </UniformGrid>

                    <!-- EmptyState -->
                    <controls:EmptyState x:Name="TablesEmptyState"
                                         IconData="{StaticResource IconTables}"
                                         Title="Bu filtr boʻyicha stollar topilmadi"
                                         Subtitle="Boshqa zona yoki holat filtrini tanlab koʻring."
                                         ActionLabel="Filtrni tozalash"
                                         ActionClicked="OnResetTableFilters"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- 2. TAB: TEZKOR SAVDO (2-COLUMN RESPONSIVE ORDER UI)   -->
            <!-- ===================================================== -->
            <Grid x:Name="QuickPosTab" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <!-- Left: Category Bar + Search + Product Grid (Flex) -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <!-- Right: Cart Panel (400px >=1550, 356px <1550) -->
                    <ColumnDefinition x:Name="CartColumn" Width="400" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: BREADCRUMB + SEARCH + CATEGORY/PRODUCT DRILL-DOWN -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Category Drill-down Breadcrumb Bar (No "Barchasi" pill) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="8,6"
                            MinHeight="52">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="QuickPosBackBtn"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="40" Height="40"
                                        Padding="12,4"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Click="OnQuickPosBackClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:Icon Data="{StaticResource IconArrowLeft}" Size="16" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Orqaga" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="QuickPosRootBreadcrumbBtn"
                                        Style="{StaticResource GhostButton}"
                                        MinHeight="40" Height="40"
                                        Padding="12,4"
                                        Click="OnQuickPosBreadcrumbRootClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:Icon Data="{StaticResource IconLayers}" Size="16" Foreground="{DynamicResource BrushPrimaryBright}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Kategoriyalar" Style="{StaticResource TextBodyBold}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ScrollViewer Grid.Column="1"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center">
                                <ItemsControl x:Name="CategoryBreadcrumbItemsControl" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:Icon Data="{StaticResource IconChevronRight}" Size="14" Foreground="{DynamicResource BrushTextMuted}" Margin="4,0" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource GhostButton}"
                                                        MinHeight="38" Height="38"
                                                        Padding="10,4"
                                                        Tag="{Binding}"
                                                        Click="OnQuickPosBreadcrumbItemClick">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource BrushSurfaceElevated}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusFull}"
                                    Padding="10,4"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="QuickPosLevelCountText"
                                           Text="0 ta boʻlim"
                                           Style="{StaticResource TextCaption}"
                                           FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Search Field -->
                    <controls:SearchBox x:Name="ProductSearchBox"
                                        Grid.Row="1"
                                        Placeholder="Taom nomi boʻyicha qidirish..."
                                        Margin="0,10,0,12"
                                        TextChanged="OnProductSearchChanged" />

                    <!-- Categories & Products Drill-Down Grid / EmptyState -->
                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="ProductsScrollViewer" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,-12,16">
                                <!-- Category / Subcategory Tiles -->
                                <ItemsControl x:Name="CategoryTilesItemsControl" Visibility="Visible">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding ProductColumns, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         VerticalAlignment="Top" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:CategoryTile Margin="0,0,12,12" CategoryClicked="OnCategoryTileClicked" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Product Tiles inside selected category (or search results) -->
                                <ItemsControl x:Name="ProductsItemsControl" Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding ProductColumns, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         VerticalAlignment="Top" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:ProductTile Margin="0,0,12,12" TileClicked="OnProductTileClicked" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <controls:EmptyState x:Name="ProductsEmptyState"
                                             IconData="{StaticResource IconSearch}"
                                             Title="Taom topilmadi"
                                             Subtitle="Qidiruv soʻzini oʻzgartiring yoki boshqa kategoriyani tanlang."
                                             ActionLabel="Kategoriyalarga qaytish"
                                             ActionClicked="OnResetProductFilter"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- RIGHT COLUMN: CART PANEL -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 1. Context Header + Ghost Clear -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="CartTitleText"
                                           Text="Saboy"
                                           Style="{StaticResource TextTitle}" />
                                <TextBlock x:Name="CartSubtitleText"
                                           Text="Kassir: Jasur Rahimov"
                                           Style="{StaticResource TextCaption}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButton}"
                                    MinHeight="48"
                                    Padding="12,8"
                                    Click="OnClearCartClick"
                                    ToolTip="Savatchani tozalash">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource IconTrash}" Size="16" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Tozalash" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 2. Cart Lines (Scrollable) -->
                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="CartLinesScrollViewer" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CartLinesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:CartLine Margin="0,0,0,8"
                                                               IncrementClicked="OnCartLineIncrement"
                                                               DecrementClicked="OnCartLineDecrement"
                                                               EditNoteClicked="OnCartLineEditNote" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Quiet Empty Cart Placeholder -->
                            <StackPanel x:Name="CartEmptyHint"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource BrushBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <controls:Icon Data="{StaticResource IconQuickSale}" Size="24" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Savatcha boʻsh" Style="{StaticResource TextBodyBold}" HorizontalAlignment="Center" />
                                <TextBlock Text="Taom qoʻshish uchun chapdan tanlang" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- 3. Financial Summary -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource BrushBg}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="10,8"
                                Margin="0,6,0,8">
                            <StackPanel>
                                <!-- Taomlar summasi -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Taomlar summasi" Style="{StaticResource TextLabel}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CartSubtotalText" Text="0&#160;soʻm" Style="{StaticResource TextAmount}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Chegirma Pill (F4) -->
                                <Grid Margin="0,2,0,4">
                                    <Button x:Name="DiscountPillBtn"
                                            Style="{StaticResource SecondaryButton}"
                                            MinHeight="44" Height="44"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            Click="OnDiscountPillClick">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:Icon Data="{StaticResource IconTag}" Size="14" Foreground="{DynamicResource BrushAmberBright}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DiscountBtnLabelText" Text="Chegirma: 0%" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource KeycapBadge}" Margin="8,0,0,0">
                                                <TextBlock Text="F4" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="CartDiscountText"
                                               Text="-0&#160;soʻm"
                                               Style="{StaticResource TextAmount}"
                                               FontSize="14"
                                               Foreground="{DynamicResource BrushAmberBright}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- Xizmat haqi -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="ServiceFeeLabelText" Text="Xizmat haqi (10%)" Style="{StaticResource TextLabel}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CartServiceFeeText" Text="0&#160;soʻm" Style="{StaticResource TextAmount}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Hairline -->
                                <Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,2,0,6" />

                                <!-- Jami (28px restrained Bold) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Jami"
                                               Style="{StaticResource TextTitle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="CartTotalText"
                                                   Text="0&#160;soʻm"
                                                   Style="{StaticResource TextGrandTotal}" />
                                    </Viewbox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. Actions: Send + Hisob, then Full-Width 56px Primary Pay -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="0.85*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="46" Height="46"
                                        Padding="8,6"
                                        Click="OnSendToKitchenClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:Icon Data="{StaticResource IconSendToKitchen}" Size="15" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Boʻlimlarga yuborish" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="46" Height="46"
                                        Padding="8,6"
                                        Click="OnPrintPreChekClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:Icon Data="{StaticResource IconReceipt}" Size="15" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Hisob" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Button Grid.Row="2"
                                    Style="{StaticResource PrimaryButton}"
                                    MinHeight="56" Height="56"
                                    Padding="14,10"
                                    HorizontalContentAlignment="Stretch"
                                    Click="OnPayCartClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:Icon Data="{StaticResource IconCash}" Size="19" Foreground="{DynamicResource BrushTextOnPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="PayButtonText"
                                                       Text="Toʻlov · 0&#160;soʻm"
                                                       Style="{StaticResource TextAmount}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextOnPrimary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Viewbox>
                                    <Border Grid.Column="1" Style="{StaticResource KeycapBadge}" VerticalAlignment="Center">
                                        <TextBlock Text="F12" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- 3. TAB: STOP-LIST BOSHQARUVI                          -->
            <!-- ===================================================== -->
            <Grid x:Name="StopListTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Bar: Search + 3 Filter Chips (Hammasi / Mavjud / Stop-listda) -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="380" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:SearchBox x:Name="StopListSearchBox"
                                        Grid.Column="0"
                                        Placeholder="Taom nomi boʻyicha qidirish..."
                                        TextChanged="OnStopListSearchChanged" />

                    <Border Grid.Column="2"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="StopFilterAllBtn"
                                         GroupName="StopListFilter"
                                         Content="Hammasi (0)"
                                         Style="{StaticResource SegmentedItem}"
                                         IsChecked="True"
                                         Click="OnStopListFilterClick"
                                         Tag="all" />
                            <RadioButton x:Name="StopFilterAvailableBtn"
                                         GroupName="StopListFilter"
                                         Content="Mavjud (0)"
                                         Style="{StaticResource SegmentedItem}"
                                         Click="OnStopListFilterClick"
                                         Tag="available" />
                            <RadioButton x:Name="StopFilterStoppedBtn"
                                         GroupName="StopListFilter"
                                         Content="Stop-listda (0)"
                                         Style="{StaticResource SegmentedItem}"
                                         Click="OnStopListFilterClick"
                                         Tag="stopped" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Content: Grid / Loading Skeleton / EmptyState -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="StopListScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="StopListItemsControl" Margin="0,0,-12,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding StopListColumns, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="14,10"
                                            Margin="0,0,12,10">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStopListed}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushError}" />
                                                        <Setter Property="Background" Value="{DynamicResource BrushErrorTintSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource TextBodyBold}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryName}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                                                    <TextBlock Text=" · " Style="{StaticResource TextCaptionMuted}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PriceFormatted}" Style="{StaticResource TextCaption}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <CheckBox Grid.Column="2"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding IsAvailable, Mode=TwoWay}"
                                                      Click="OnStopListToggleClicked"
                                                      Tag="{Binding}"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <UniformGrid x:Name="StopListLoadingGrid" Columns="3" VerticalAlignment="Top" Margin="0,0,-12,0" Visibility="Collapsed">
                        <controls:SkeletonBox Height="84" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="84" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="84" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="84" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="84" Margin="0,0,12,12" />
                        <controls:SkeletonBox Height="84" Margin="0,0,12,12" />
                    </UniformGrid>

                    <controls:EmptyState x:Name="StopListEmptyState"
                                         IconData="{StaticResource IconStop}"
                                         Title="Taom topilmadi"
                                         Subtitle="Qidiruv yoki filtr shartini oʻzgartirib koʻring."
                                         ActionLabel="Filtrni tozalash"
                                         ActionClicked="OnResetStopListFilter"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- 4. TAB: ONLAYN BUYURTMALAR (TELEGRAM & MOBIL ILOVA)   -->
            <!-- ===================================================== -->
            <Grid x:Name="OnlineTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Telegram bot va mobil ilovadan kelgan buyurtmalar"
                                   Style="{StaticResource TextBody}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButton}"
                            MinHeight="48"
                            Padding="16,10"
                            Click="OnRefreshOnlineOrdersClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon Data="{StaticResource IconRefresh}" Size="16" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Yangilash" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource KeycapBadge}" Margin="8,0,0,0">
                                <TextBlock Text="F5" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Content: Order Cards / Loading / EmptyState -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="OnlineScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OnlineOrdersItemsControl" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:OnlineOrderCard Margin="0,0,0,12" AcceptClicked="OnAcceptOnlineOrderClicked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="OnlineLoadingStack" Visibility="Collapsed">
                        <controls:SkeletonBox Height="156" Margin="0,0,0,12" />
                        <controls:SkeletonBox Height="156" Margin="0,0,0,12" />
                        <controls:SkeletonBox Height="156" />
                    </StackPanel>

                    <controls:EmptyState x:Name="OnlineEmptyState"
                                         IconData="{StaticResource IconOnline}"
                                         Title="Onlayn buyurtmalar yoʻq"
                                         Subtitle="Telegram bot yoki ilovadan yangi buyurtma tushganda bu yerda koʻrinadi."
                                         ActionLabel="Yangilash"
                                         ActionClicked="OnRefreshOnlineOrdersEmptyAction"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- 5. TAB: SMENA VA Z-HISOBOT                           -->
            <!-- ===================================================== -->
            <Grid x:Name="ShiftReportTab" Visibility="Collapsed">
                <Grid x:Name="ShiftContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 1. Hero Card: Jami tushum + X-hisobot & Smenani yopish -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}"
                            Padding="24,22"
                            Margin="0,0,0,16">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="JAMI TUSHUM" Style="{StaticResource TextLabelCaps}" />
                                <TextBlock x:Name="ShiftTotalRevenueText"
                                           Text="0&#160;soʻm"
                                           Style="{StaticResource TextGrandTotal}"
                                           Margin="0,6,0,6" />
                                <TextBlock x:Name="ShiftHeaderInfoText"
                                           Text="Smena ochiq · 08:30 dan · Kassir: Jasur Rahimov"
                                           Style="{StaticResource TextCaption}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}"
                                        MinHeight="52"
                                        Padding="20,12"
                                        Click="OnPrintXReportDirect">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:Icon Data="{StaticResource IconPrinter}" Size="18" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="X-hisobot" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- >=16px gap around destructive action per §10 -->
                                <Button Style="{StaticResource DangerButton}"
                                        MinHeight="52"
                                        Padding="20,12"
                                        Margin="16,0,0,0"
                                        Click="OnCloseShiftDirect">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:Icon Data="{StaticResource IconLock}" Size="18" Foreground="{DynamicResource BrushTextOnError}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Smenani yopish" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextOnError}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. 3-Up Payment Breakdown Row (Neutral surfaces, icon color only) -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:KpiCard x:Name="KpiCashCard"
                                          Grid.Column="0"
                                          Label="Naqd pul"
                                          Value="0&#160;soʻm"
                                          Subtitle="Kassa qutisida"
                                          IconData="{StaticResource IconCash}"
                                          IconForeground="{DynamicResource BrushPrimaryBright}" />

                        <controls:KpiCard x:Name="KpiCardCard"
                                          Grid.Column="2"
                                          Label="Karta / Terminal"
                                          Value="0&#160;soʻm"
                                          Subtitle="Bank terminali orqali"
                                          IconData="{StaticResource IconCard}"
                                          IconForeground="{DynamicResource BrushInfo}" />

                        <controls:KpiCard x:Name="KpiOnlineCard"
                                          Grid.Column="4"
                                          Label="Onlayn toʻlovlar"
                                          Value="0&#160;soʻm"
                                          Subtitle="Bot va mobil ilova"
                                          IconData="{StaticResource IconOnline}"
                                          IconForeground="{DynamicResource BrushAmberBright}" />
                    </Grid>

                    <!-- 3. Compact Secondary Stats Row -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="20,16"
                            Margin="0,0,0,16">
                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Text="Cheklar soni" Style="{StaticResource TextCaption}" />
                                <TextBlock x:Name="ShiftOrdersCountText" Text="0 ta" Style="{StaticResource TextTitle}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Xizmat haqi" Style="{StaticResource TextCaption}" />
                                <TextBlock x:Name="ShiftServiceFeeText" Text="0&#160;soʻm" Style="{StaticResource TextTitle}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Chegirmalar" Style="{StaticResource TextCaption}" />
                                <TextBlock x:Name="ShiftDiscountsText" Text="0&#160;soʻm" Style="{StaticResource TextTitle}" Foreground="{DynamicResource BrushAmberBright}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Oʻrtacha chek" Style="{StaticResource TextCaption}" />
                                <TextBlock x:Name="ShiftAvgCheckText" Text="0&#160;soʻm" Style="{StaticResource TextTitle}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- 4. Proportional Payment Mix & Sales Channels -->
                    <Border Grid.Row="3"
                            VerticalAlignment="Top"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="20,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Toʻlov usullari ulushi" Style="{StaticResource TextBodyBold}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ShiftPaymentMixLabel"
                                           Text="Naqd 61% · Karta 29% · Onlayn 10%"
                                           Style="{StaticResource TextCaption}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Height="12" Margin="0,0,0,18" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ShiftCashShareCol" Width="61*" />
                                    <ColumnDefinition x:Name="ShiftCardShareCol" Width="29*" />
                                    <ColumnDefinition x:Name="ShiftOnlineShareCol" Width="10*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BrushPrimaryBright}" CornerRadius="6,0,0,6" />
                                <Border Grid.Column="1" Background="{DynamicResource BrushInfo}" Margin="2,0" />
                                <Border Grid.Column="2" Background="{DynamicResource BrushAmberBright}" CornerRadius="0,6,6,0" />
                            </Grid>

                            <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                <UniformGrid Columns="2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushPrimaryBright}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Zal ichida (Stollar):" Style="{StaticResource TextBody}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ShiftDineInText" Text="0&#160;soʻm" Style="{StaticResource TextBodyBold}" Typography.NumeralAlignment="Tabular" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushAmberBright}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Saboy va onlayn:" Style="{StaticResource TextBody}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ShiftTakeawayText" Text="0&#160;soʻm" Style="{StaticResource TextBodyBold}" Typography.NumeralAlignment="Tabular" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Shift Loading Skeleton -->
                <StackPanel x:Name="ShiftLoadingState" Visibility="Collapsed">
                    <controls:SkeletonBox Height="140" Margin="0,0,0,16" />
                    <UniformGrid Columns="3" Margin="0,0,-14,16">
                        <controls:SkeletonBox Height="124" Margin="0,0,14,0" />
                        <controls:SkeletonBox Height="124" Margin="0,0,14,0" />
                        <controls:SkeletonBox Height="124" Margin="0,0,14,0" />
                    </UniformGrid>
                    <controls:SkeletonBox Height="88" />
                </StackPanel>

                <!-- Shift Empty State (when 0 orders in shift) -->
                <controls:EmptyState x:Name="ShiftEmptyState"
                                     IconData="{StaticResource IconReport}"
                                     Title="Smenada hali savdo yoʻq"
                                     Subtitle="Birinchi toʻlov qabul qilingandan soʻng smena koʻrsatkichlari bu yerda koʻrinadi."
                                     ActionLabel="Tezkor savdoga oʻtish"
                                     ActionClicked="OnShiftEmptyAction"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Visibility="Collapsed" />
            </Grid>

            <!-- ===================================================== -->
            <!-- 5.5. TAB: BOSHQARUV (TAOM, GURUH, XODIM, STOL CRUD)    -->
            <!-- ===================================================== -->
            <Grid x:Name="ManageTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Bar: Sub-tabs + Search + + Qo'shish CTA -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MaxWidth="360" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ManageSubProductsBtn"
                                         GroupName="ManageSubTabs"
                                         Content="Taomlar"
                                         Style="{StaticResource SegmentedItem}"
                                         IsChecked="True"
                                         Tag="products"
                                         Click="OnManageSubTabClick" />
                            <RadioButton x:Name="ManageSubCategoriesBtn"
                                         GroupName="ManageSubTabs"
                                         Content="Guruhlar"
                                         Style="{StaticResource SegmentedItem}"
                                         Tag="categories"
                                         Click="OnManageSubTabClick" />
                            <RadioButton x:Name="ManageSubStaffBtn"
                                         GroupName="ManageSubTabs"
                                         Content="Xodimlar"
                                         Style="{StaticResource SegmentedItem}"
                                         Tag="staff"
                                         Click="OnManageSubTabClick" />
                            <RadioButton x:Name="ManageSubTablesBtn"
                                         GroupName="ManageSubTabs"
                                         Content="Stollar"
                                         Style="{StaticResource SegmentedItem}"
                                         Tag="tables"
                                         Click="OnManageSubTabClick" />
                            <RadioButton x:Name="ManageSubHallsBtn"
                                         GroupName="ManageSubTabs"
                                         Content="Zallar"
                                         Style="{StaticResource SegmentedItem}"
                                         Tag="halls"
                                         Click="OnManageSubTabClick" />
                            <RadioButton x:Name="ManageSubFeedbackBtn"
                                         GroupName="ManageSubTabs"
                                         Content="Sharhlar &amp; Baholar"
                                         Style="{StaticResource SegmentedItem}"
                                         Tag="feedback"
                                         Click="OnManageSubTabClick" />
                        </StackPanel>
                    </Border>

                    <controls:SearchBox x:Name="ManageSearchBox"
                                        Grid.Column="2"
                                        Placeholder="Qidirish..."
                                        VerticalAlignment="Center"
                                        TextChanged="OnManageSearchChanged" />

                    <Button x:Name="ManageAddBtn"
                            Grid.Column="4"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="46"
                            Padding="18,10"
                            Click="OnManageAddClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon Data="{StaticResource IconPlus}" Size="16" Foreground="{DynamicResource BrushTextOnPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ManageAddBtnText" Text="Taom qoʻshish" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Scrollable Management Rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,0,16">
                        <!-- 1. Taomlar -->
                        <ItemsControl x:Name="ManageProductsItemsControl" Visibility="Visible">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="2.1*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="48" Height="48"
                                                    CornerRadius="{StaticResource RadiusXs}"
                                                    Background="{DynamicResource BrushSurfaceElevated}"
                                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                    BorderThickness="1"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <controls:Icon Data="{StaticResource IconBowl}" Size="20" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextTitle}" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="8,4" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding CategoryAndDept}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding PriceFormatted}" Style="{StaticResource TextBodyBold}" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BrushPrimaryBright}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border Grid.Column="4" Background="{Binding StatusBg}" CornerRadius="{StaticResource RadiusFull}" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusFg}" />
                                            </Border>
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Tahrirlash" Style="{StaticResource SecondaryButton}" MinHeight="40" Padding="14,6" Margin="0,0,8,0" Tag="{Binding Model}" Click="OnManageEditProductClick" />
                                                <Button Content="Oʻchirish" Style="{StaticResource DangerButton}" MinHeight="40" Padding="12,6" Tag="{Binding Model}" Click="OnManageDeleteProductClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 2. Guruhlar (Kategoriyalar) -->
                        <ItemsControl x:Name="ManageCategoriesItemsControl" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource TextTitle}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="8,4" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding DepartmentLabel}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding ProductsCountText}" Style="{StaticResource TextBody}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource BrushSurfaceElevated}" CornerRadius="{StaticResource RadiusFull}" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Tahrirlash" Style="{StaticResource SecondaryButton}" MinHeight="40" Padding="14,6" Margin="0,0,8,0" Tag="{Binding Model}" Click="OnManageEditCategoryClick" />
                                                <Button Content="Oʻchirish" Style="{StaticResource DangerButton}" MinHeight="40" Padding="12,6" Tag="{Binding Model}" Click="OnManageDeleteCategoryClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 3. Xodimlar (Ofitsiantlar & Kuryerlar) -->
                        <ItemsControl x:Name="ManageStaffItemsControl" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextTitle}" />
                                                <TextBlock Text="{Binding DetailsText}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource BrushPrimaryTint}" BorderBrush="{DynamicResource BrushPrimary}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="8,4" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding RoleLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryBright}" />
                                                </Border>
                                                <TextBlock Text="{Binding StaffCode}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{Binding ToggleButtonText}" Style="{StaticResource SecondaryButton}" MinHeight="38" Padding="12,5" Tag="{Binding Model}" Click="OnManageToggleStaffClick" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Tahrirlash" Style="{StaticResource SecondaryButton}" MinHeight="40" Padding="14,6" Margin="0,0,8,0" Tag="{Binding Model}" Click="OnManageEditStaffClick" />
                                                <Button Content="Oʻchirish" Style="{StaticResource DangerButton}" MinHeight="40" Padding="12,6" Tag="{Binding Model}" Click="OnManageDeleteStaffClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 4. Stollar -->
                        <ItemsControl x:Name="ManageTablesItemsControl" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextTitle}" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="8,4" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Zone}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding CapacityText}" Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource BrushSurfaceElevated}" CornerRadius="{StaticResource RadiusFull}" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Tahrirlash" Style="{StaticResource SecondaryButton}" MinHeight="40" Padding="14,6" Margin="0,0,8,0" Tag="{Binding Model}" Click="OnManageEditTableClick" />
                                                <Button Content="Oʻchirish" Style="{StaticResource DangerButton}" MinHeight="40" Padding="12,6" Tag="{Binding Model}" Click="OnManageDeleteTableClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 5. Zallar -->
                        <ItemsControl x:Name="ManageHallsItemsControl" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextTitle}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="8,4" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding TablesCountText}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding SortOrderText}" Style="{StaticResource TextCaptionMuted}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource BrushSurfaceElevated}" CornerRadius="{StaticResource RadiusFull}" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Tahrirlash" Style="{StaticResource SecondaryButton}" MinHeight="40" Padding="14,6" Margin="0,0,8,0" Tag="{Binding Model}" Click="OnManageEditHallClick" />
                                                <Button Content="Oʻchirish" Style="{StaticResource DangerButton}" MinHeight="40" Padding="12,6" Tag="{Binding Model}" Click="OnManageDeleteHallClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 6. Sharhlar va Baholar (Ofitsiant & Taomlar) -->
                        <Grid x:Name="ManageFeedbackContainer" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- KPI Summary Cards -->
                            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                                <!-- KPI 1: O'rtacha xizmat bahosi -->
                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="16,14"
                                        Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Oʻrtacha xizmat bahosi" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock x:Name="FeedbackKpiAvgWaiterRatingText" Text="5.0 ★" Style="{StaticResource TextTitle}" Foreground="{DynamicResource BrushWarning}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                                        <TextBlock Text="Ofitsiantlar boʻyicha baho" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- KPI 2: Jami ofitsiant sharhlari -->
                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="16,14"
                                        Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Xizmat sharhlari soni" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock x:Name="FeedbackKpiTotalWaiterReviewsText" Text="0 ta" Style="{StaticResource TextTitle}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                                        <TextBlock Text="QR kod orqali qoldirilgan" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- KPI 3: O'rtacha taomlar bahosi -->
                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="16,14"
                                        Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Oʻrtacha taomlar bahosi" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock x:Name="FeedbackKpiAvgDishRatingText" Text="5.0 ★" Style="{StaticResource TextTitle}" Foreground="{DynamicResource BrushWarning}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                                        <TextBlock Text="Taomlar sifati va mazasi" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- KPI 4: Jami taom sharhlari -->
                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Taomlar sharhlari soni" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock x:Name="FeedbackKpiTotalDishReviewsText" Text="0 ta" Style="{StaticResource TextTitle}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                                        <TextBlock Text="Mijozlar bahosi" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Confidentiality Notice Bar -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource BrushSurfaceVariant}"
                                    BorderBrush="{DynamicResource BrushPrimary}"
                                    BorderThickness="2,0,0,0"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Padding="14,10"
                                    Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:Icon Data="{StaticResource IconLock}" Size="16" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Maxfiylik nazorati: Ushbu baholar ofitsiantlarning oʻz ilovasida KOʻRSATILMAYDI. Faqat kassa va boshqaruv uchun maxfiy tahliliy maʼlumot hisoblanadi."
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Sub-views: Waiter Feedbacks vs Dish Feedbacks -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Ofitsiantlar baholari -->
                                <Border Grid.Column="0"
                                        Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="16"
                                        Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                            <TextBlock Text="Ofitsiantlar xizmat bahosi" Style="{StaticResource TextSection}" FontSize="15" />
                                            <TextBlock Text="Stollardan kelgan anonim mijoz baholari" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="ManageWaiterFeedbacksItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BrushSurfaceVariant}"
                                                                BorderBrush="{DynamicResource BrushBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource RadiusSm}"
                                                                Padding="12,10"
                                                                Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding WaiterName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                        <TextBlock Text=" • Stol #" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="4,0,0,0" />
                                                                        <TextBlock Text="{Binding TableNumber}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushPrimary}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding StarsDisplay}" Foreground="{DynamicResource BrushWarning}" FontWeight="Bold" FontSize="14" />
                                                                        <TextBlock Text="{Binding CreatedAt}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding Comment}"
                                                                           FontSize="12"
                                                                           FontStyle="Italic"
                                                                           Foreground="{DynamicResource BrushTextSecondary}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,6,0,0" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Right Column: Taomlar baholari -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="16"
                                        Margin="8,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                            <TextBlock Text="Taomlar mazasi va bahosi" Style="{StaticResource TextSection}" FontSize="15" />
                                            <TextBlock Text="Mijozlar buyurtma qilgan taomlar reytingi" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="ManageDishFeedbacksItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BrushSurfaceVariant}"
                                                                BorderBrush="{DynamicResource BrushBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource RadiusSm}"
                                                                Padding="12,10"
                                                                Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                        <TextBlock Text=" • Stol #" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="4,0,0,0" />
                                                                        <TextBlock Text="{Binding TableNumber}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushPrimary}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding StarsDisplay}" Foreground="{DynamicResource BrushWarning}" FontWeight="Bold" FontSize="14" />
                                                                        <TextBlock Text="{Binding CreatedAt}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding Comment}"
                                                                           FontSize="12"
                                                                           FontStyle="Italic"
                                                                           Foreground="{DynamicResource BrushTextSecondary}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,6,0,0" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ===================================================== -->
            <!-- 7. TAB: OMBORXONA VA TEX-KARTA (INVENTORY & RECIPES)  -->
            <!-- ===================================================== -->
            <Grid x:Name="InventoryTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top KPI Summary Cards -->
                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,14">
                    <!-- KPI 1: Jami xomashyolar -->
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16,12"
                            Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Jami xomashyolar" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                <TextBlock x:Name="InventoryKpiTotalItemsText" Text="0 tur" Style="{StaticResource TextTitle}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                                <TextBlock Text="Ombor hisobidagi tovarlar" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceVariant}" CornerRadius="{StaticResource RadiusFull}" Width="38" Height="38" VerticalAlignment="Top">
                                <controls:Icon Data="{StaticResource IconBoxes}" Size="18" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- KPI 2: Ombor qiymati -->
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16,12"
                            Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ombor umumiy qiymati" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                <TextBlock x:Name="InventoryKpiTotalValuationText" Text="0 soʻm" Style="{StaticResource TextTitle}" Foreground="{DynamicResource BrushPrimaryBright}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                                <TextBlock Text="Tan narx boʻyicha qoldiq" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceVariant}" CornerRadius="{StaticResource RadiusFull}" Width="38" Height="38" VerticalAlignment="Top">
                                <controls:Icon Data="{StaticResource IconCash}" Size="18" Foreground="{DynamicResource BrushPrimaryBright}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- KPI 3: Kam qolganlar -->
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16,12"
                            Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Kam qolganlar" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                <TextBlock x:Name="InventoryKpiLowStockCountText" Text="0 ta" Style="{StaticResource TextTitle}" Foreground="{DynamicResource BrushError}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                                <TextBlock Text="Ogohlantirish chegarasida" FontSize="11" Foreground="{DynamicResource BrushError}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceVariant}" CornerRadius="{StaticResource RadiusFull}" Width="38" Height="38" VerticalAlignment="Top">
                                <controls:Icon Data="{StaticResource IconAlert}" Size="18" Foreground="{DynamicResource BrushError}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- KPI 4: Bugungi kirim -->
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bugungi kirim (Prihod)" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                <TextBlock x:Name="InventoryKpiTodaySuppliesText" Text="0 soʻm" Style="{StaticResource TextTitle}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                                <TextBlock Text="Keltirilgan yangi partiya" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceVariant}" CornerRadius="{StaticResource RadiusFull}" Width="38" Height="38" VerticalAlignment="Top">
                                <controls:Icon Data="{StaticResource IconWarehouse}" Size="18" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Sub-tabs + Search + Filter + Actions -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MaxWidth="320" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Segmented Sub-tabs -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="InventorySubStockBtn"
                                         GroupName="InventorySubTabs"
                                         Content="Qoldiqlar"
                                         Style="{StaticResource SegmentedItem}"
                                         IsChecked="True"
                                         Tag="stock"
                                         Click="OnInventorySubTabClick" />
                            <RadioButton x:Name="InventorySubSuppliesBtn"
                                         GroupName="InventorySubTabs"
                                         Content="Kirim"
                                         Style="{StaticResource SegmentedItem}"
                                         Tag="supplies"
                                         Click="OnInventorySubTabClick" />
                            <RadioButton x:Name="InventorySubWriteOffsBtn"
                                         GroupName="InventorySubTabs"
                                         Content="Chiqim"
                                         Style="{StaticResource SegmentedItem}"
                                         Tag="write_offs"
                                         Click="OnInventorySubTabClick" />
                            <RadioButton x:Name="InventorySubRecipesBtn"
                                         GroupName="InventorySubTabs"
                                         Content="Tex-karta"
                                         Style="{StaticResource SegmentedItem}"
                                         Tag="recipes"
                                         Click="OnInventorySubTabClick" />
                            <RadioButton x:Name="InventorySubSuppliersBtn"
                                         GroupName="InventorySubTabs"
                                         Content="Taʼminotchilar"
                                         Style="{StaticResource SegmentedItem}"
                                         Tag="suppliers"
                                         Click="OnInventorySubTabClick" />
                            <RadioButton x:Name="InventorySubMovementsBtn"
                                         GroupName="InventorySubTabs"
                                         Content="Harakatlar"
                                         Style="{StaticResource SegmentedItem}"
                                         Tag="movements"
                                         Click="OnInventorySubTabClick" />
                        </StackPanel>
                    </Border>

                    <!-- Search Box -->
                    <controls:SearchBox x:Name="InventorySearchBox"
                                        Grid.Column="2"
                                        Placeholder="Xomashyo yoki taom qidirish..."
                                        VerticalAlignment="Center"
                                        TextChanged="OnInventorySearchChanged" />

                    <!-- Low Stock Toggle Button -->
                    <ToggleButton x:Name="InventoryLowStockFilterBtn"
                                  Grid.Column="4"
                                  Style="{StaticResource ChipToggle}"
                                  VerticalAlignment="Center"
                                  Click="OnInventoryLowStockFilterClick">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconAlert}" Size="13" Foreground="{DynamicResource BrushError}" Margin="0,0,5,0" />
                            <TextBlock Text="Faqat kam qolganlar" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </ToggleButton>

                    <!-- Primary Action CTA -->
                    <Button x:Name="InventoryMainActionBtn"
                            Grid.Column="6"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="44"
                            Padding="16,8"
                            Click="OnInventoryMainActionClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon Data="{StaticResource IconPlus}" Size="16" Foreground="{DynamicResource BrushTextOnPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="InventoryMainActionBtnText" Text="Yangi xomashyo" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Scrollable Content Panels -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,0,16">
                        <!-- 1. Qoldiqlar (Stock) -->
                        <ItemsControl x:Name="InventoryStockItemsControl" Visibility="Visible">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Name & Category -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextBodyBold}" FontSize="14" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Border Background="{DynamicResource BrushSurfaceVariant}" CornerRadius="{StaticResource RadiusSm}" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding CategoryDisplay}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Current Stock & Badge -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Mavjud qoldiq" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding FormattedStock}" Style="{StaticResource TextBodyBold}" Typography.NumeralAlignment="Tabular" />
                                                    <Border Background="{Binding StatusBg}" CornerRadius="{StaticResource RadiusSm}" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusFg}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Unit Cost Price -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="Tan narxi (1 birlik)" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding FormattedCost}" Style="{StaticResource TextBodyBold}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Total Valuation -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="Umumiy qiymati" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding FormattedValuation}" Style="{StaticResource TextBodyBold}" Foreground="{DynamicResource BrushPrimaryBright}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Row Actions -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="0,0,4,0" Tag="{Binding}" Click="OnIngredientSupplyQuickClick">
                                                    <TextBlock Text="+ Kirim" Foreground="{DynamicResource BrushPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Padding="8,6" Margin="0,0,4,0" Tag="{Binding}" Click="OnEditIngredientClick">
                                                    <controls:Icon Data="{StaticResource IconEdit}" Size="15" Foreground="{DynamicResource BrushTextSecondary}" />
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Padding="8,6" Tag="{Binding}" Click="OnDeleteIngredientClick">
                                                    <controls:Icon Data="{StaticResource IconTrash}" Size="15" Foreground="{DynamicResource BrushError}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 2. Kirim (Supplies) -->
                        <ItemsControl x:Name="InventorySuppliesItemsControl" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DocNumber}" Style="{StaticResource TextBodyBold}" FontSize="14" />
                                                    <Border Background="{DynamicResource BrushSurfaceVariant}" CornerRadius="{StaticResource RadiusSm}" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SupplierAndNotes}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Mahsulotlar soni" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding ItemsSummary}" Style="{StaticResource TextBodyBold}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="Toʻlov holati" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding PaymentStatusDisplay}" Style="{StaticResource TextBodyBold}" Foreground="{Binding PaymentStatusColor}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Jami summa" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding FormattedTotal}" Style="{StaticResource TextTitle}" Foreground="{DynamicResource BrushPrimaryBright}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 3. Chiqim (WriteOffs) -->
                        <ItemsControl x:Name="InventoryWriteOffsItemsControl" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DocNumber}" Style="{StaticResource TextBodyBold}" FontSize="14" />
                                                    <Border Background="{DynamicResource BrushSurfaceVariant}" CornerRadius="{StaticResource RadiusSm}" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Chiqim sababi" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <Border Background="{DynamicResource BrushSurfaceVariant}" CornerRadius="{StaticResource RadiusSm}" Padding="6,2" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding ReasonDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushError}" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Hisoblangan zarar" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding FormattedTotal}" Style="{StaticResource TextTitle}" Foreground="{DynamicResource BrushError}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 4. Tex-karta (Recipes per Dish) -->
                        <ItemsControl x:Name="InventoryRecipesItemsControl" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Dish Name & Category -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextBodyBold}" FontSize="14" />
                                                <TextBlock Text="{Binding RecipeSummary}" FontSize="12" Foreground="{Binding RecipeSummaryColor}" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <!-- Selling Price -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Sotuv narxi" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding FormattedPrice}" Style="{StaticResource TextBodyBold}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Tech-card Cost -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="Xomashyo tannarxi" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding FormattedCost}" Style="{StaticResource TextBodyBold}" Foreground="{DynamicResource BrushAmberBright}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Profit Margin -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="Sof foyda" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding FormattedProfit}" Style="{StaticResource TextBodyBold}" Foreground="{DynamicResource BrushPrimaryBright}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Margin % -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <TextBlock Text="Rentabellik" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding FormattedMarginPercent}" Style="{StaticResource TextBodyBold}" Foreground="{DynamicResource BrushPrimaryBright}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Edit Recipe Button -->
                                            <Button Grid.Column="5"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="12,6"
                                                    Tag="{Binding}"
                                                    Click="OnEditRecipeClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:Icon Data="{StaticResource IconEdit}" Size="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Tex-karta" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 5. Ta'minotchilar (Suppliers) -->
                        <ItemsControl x:Name="InventorySuppliersItemsControl" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextBodyBold}" FontSize="14" />
                                                <TextBlock Text="{Binding ContactAndAddress}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Telefon" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding PhoneDisplay}" Style="{StaticResource TextBodyBold}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="Qarz balansi" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding FormattedBalance}" Style="{StaticResource TextBodyBold}" Foreground="{Binding BalanceColor}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButton}" Padding="8,6" Margin="0,0,4,0" Tag="{Binding}" Click="OnEditSupplierClick">
                                                    <controls:Icon Data="{StaticResource IconEdit}" Size="15" Foreground="{DynamicResource BrushTextSecondary}" />
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Padding="8,6" Tag="{Binding}" Click="OnDeleteSupplierClick">
                                                    <controls:Icon Data="{StaticResource IconTrash}" Size="15" Foreground="{DynamicResource BrushError}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 6. Harakatlar (Movements) -->
                        <ItemsControl x:Name="InventoryMovementsItemsControl" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CreatedAtDisplay}" Style="{StaticResource TextBodyBold}" FontSize="13" />
                                                <Border Background="{Binding MovementTypeBg}" CornerRadius="{StaticResource RadiusSm}" Padding="5,1" Margin="0,3,0,0" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding MovementTypeDisplay}" FontSize="10" FontWeight="Bold" Foreground="{Binding MovementTypeFg}" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IngredientName}" Style="{StaticResource TextBodyBold}" FontSize="14" />
                                                <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="Oʻzgarish" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding FormattedDelta}" Style="{StaticResource TextBodyBold}" Foreground="{Binding DeltaBrush}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="Qoldiq oʻzgarishi" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding StockTransitionDisplay}" Style="{StaticResource TextBodyBold}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="1 birlik qiymati" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding FormattedUnitCost}" Style="{StaticResource TextBodyBold}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ===================================================== -->
            <!-- 8. TAB: SOZLAMALAR (ALOHIDA BO'LIMLAR + KASSIR PROFILI)-->
            <!-- ===================================================== -->
            <Grid x:Name="SettingsTab" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Settings Section Navigation -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SOZLAMALAR BOʻLIMLARI"
                                       Style="{StaticResource TextLabelCaps}"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Margin="8,6,8,10" />

                            <RadioButton x:Name="SettingsNavProfileBtn"
                                         GroupName="SettingsSectionNav"
                                         Style="{StaticResource SettingsNavItem}"
                                         IsChecked="True"
                                         Tag="profile"
                                         Click="OnSettingsSectionClick">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:Icon Data="{StaticResource IconUser}" Size="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Kassir profili" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="SettingsNavPrintersBtn"
                                         GroupName="SettingsSectionNav"
                                         Style="{StaticResource SettingsNavItem}"
                                         Tag="printers"
                                         Click="OnSettingsSectionClick">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:Icon Data="{StaticResource IconPrinter}" Size="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Printerlar" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="SettingsNavHallsBtn"
                                         GroupName="SettingsSectionNav"
                                         Style="{StaticResource SettingsNavItem}"
                                         Tag="halls"
                                         Click="OnSettingsSectionClick">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:Icon Data="{StaticResource IconTables}" Size="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Zallar" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="SettingsNavServerBtn"
                                         GroupName="SettingsSectionNav"
                                         Style="{StaticResource SettingsNavItem}"
                                         Tag="server"
                                         Click="OnSettingsSectionClick">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:Icon Data="{StaticResource IconWifi}" Size="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Server va sinxron" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="SettingsNavPaymentsBtn"
                                         GroupName="SettingsSectionNav"
                                         Style="{StaticResource SettingsNavItem}"
                                         Tag="payments"
                                         Click="OnSettingsSectionClick">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:Icon Data="{StaticResource IconCard}" Size="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Xizmat va toʻlovlar" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="SettingsNavBotBtn"
                                         GroupName="SettingsSectionNav"
                                         Style="{StaticResource SettingsNavItem}"
                                         Tag="bot"
                                         Click="OnSettingsSectionClick">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:Icon Data="{StaticResource IconOnline}" Size="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Bot va yetkazib berish" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Settings Content Area + Sticky Dirty Bar -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,0,20">

                            <!-- 1. KASSIR PROFILI VA PROFIL SOZLAMALARI -->
                            <StackPanel x:Name="SettingsSectionProfile" Visibility="Visible">
                                <!-- Profile Hero Banner -->
                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="20"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="ProfileAvatarBorder"
                                                Grid.Column="0"
                                                Width="68" Height="68"
                                                CornerRadius="34"
                                                Background="{DynamicResource BrushPrimaryTint}"
                                                BorderBrush="{DynamicResource BrushPrimary}"
                                                BorderThickness="2"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="ProfileAvatarInitials"
                                                       Text="JR"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushPrimaryBright}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="ProfileHeaderNameText"
                                                           Text="Jasur Rahimov"
                                                           Style="{StaticResource TextSection}"
                                                           VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource BrushPrimaryTint}"
                                                        BorderBrush="{DynamicResource BrushPrimary}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource RadiusFull}"
                                                        Padding="10,3"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="ProfileHeaderRoleText"
                                                               Text="Bosh kassir"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushPrimaryBright}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="ProfileHeaderPhoneText"
                                                       Text="+998 90 111 22 33"
                                                       Style="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       Margin="0,3,0,2" />
                                            <TextBlock x:Name="ProfileShiftSummaryText"
                                                       Text="Joriy smena: 0 ta chek · 0 soʻm"
                                                       Style="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource BrushTextMuted}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    MinHeight="46"
                                                    Padding="14,8"
                                                    Margin="0,0,8,0"
                                                    Click="OnProfileOpenShiftClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:Icon Data="{StaticResource IconReport}" Size="16" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Smena" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    MinHeight="46"
                                                    Padding="14,8"
                                                    Click="OnLockAppClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:Icon Data="{StaticResource IconLock}" Size="16" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Qulflash" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Personal Identity & PIN -->
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="20">
                                        <StackPanel>
                                            <controls:SectionHeader Title="Profil maʻlumotlari"
                                                                    Subtitle="Kassir ismi, lavozimi va kirish PIN-kodi" />

                                            <controls:Field Label="Kassir toʻliq ismi" Margin="0,0,0,14">
                                                <TextBox x:Name="CashierNameBox" Text="Jasur Rahimov" TextChanged="OnSettingsTextChanged" />
                                            </controls:Field>

                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:Field Grid.Column="0" Label="Telefon raqami">
                                                    <TextBox x:Name="CashierPhoneBox" Text="+998901112233" Typography.NumeralAlignment="Tabular" TextChanged="OnSettingsTextChanged" />
                                                </controls:Field>
                                                <controls:Field Grid.Column="2" Label="Lavozim">
                                                    <TextBox x:Name="CashierRoleBox" Text="Bosh kassir" TextChanged="OnSettingsTextChanged" />
                                                </controls:Field>
                                            </Grid>

                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:Field Grid.Column="0" Label="Yangi PIN-kod (ixtiyoriy)" HelperText="Boʻsh qoldirilsa eskisi qoladi">
                                                    <PasswordBox x:Name="CashierPinBox" PasswordChanged="OnSettingsPasswordChanged" />
                                                </controls:Field>
                                                <controls:Field Grid.Column="2" Label="PIN-kodni tasdiqlash">
                                                    <PasswordBox x:Name="CashierPinConfirmBox" PasswordChanged="OnSettingsPasswordChanged" />
                                                </controls:Field>
                                            </Grid>

                                            <Button Content="Profilni saqlash"
                                                    Style="{StaticResource PrimaryButton}"
                                                    MinHeight="48"
                                                    HorizontalAlignment="Right"
                                                    Padding="22,10"
                                                    Click="OnSaveProfileQuickClick" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Right: Personal Preferences -->
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="20"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <controls:SectionHeader Title="Profil sozlamalari"
                                                                    Subtitle="Xavfsizlik, koʻrinish va bildirishnomalar" />

                                            <CheckBox x:Name="RequirePinOnUnlockCheck"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      Content="Qulfdan chiqishda PIN-kod soʻrash"
                                                      Margin="0,0,0,12"
                                                      Click="OnSettingsCheckChanged" />

                                            <CheckBox x:Name="NotificationSoundCheck"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      Content="Yangi buyurtmalarda ovozli signal"
                                                      IsChecked="True"
                                                      Margin="0,0,0,12"
                                                      Click="OnSettingsCheckChanged" />

                                            <CheckBox x:Name="ProfileThemeToggleCheck"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      Content="Tungi mavzu (Dark mode)"
                                                      Margin="0,0,0,16"
                                                      Click="OnProfileThemeToggleClick" />

                                            <TextBlock Text="Avatar rangi" Style="{StaticResource TextLabel}" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                <Button Style="{StaticResource GhostButton}" Width="40" Height="40" MinHeight="40" Padding="0" Margin="0,0,8,0" Tag="#10B981" Click="OnSelectAvatarColorClick">
                                                    <Border Width="32" Height="32" CornerRadius="16" Background="#10B981" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" />
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Width="40" Height="40" MinHeight="40" Padding="0" Margin="0,0,8,0" Tag="#F59E0B" Click="OnSelectAvatarColorClick">
                                                    <Border Width="32" Height="32" CornerRadius="16" Background="#F59E0B" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" />
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Width="40" Height="40" MinHeight="40" Padding="0" Margin="0,0,8,0" Tag="#3B82F6" Click="OnSelectAvatarColorClick">
                                                    <Border Width="32" Height="32" CornerRadius="16" Background="#3B82F6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" />
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Width="40" Height="40" MinHeight="40" Padding="0" Margin="0,0,8,0" Tag="#8B5CF6" Click="OnSelectAvatarColorClick">
                                                    <Border Width="32" Height="32" CornerRadius="16" Background="#8B5CF6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" />
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Width="40" Height="40" MinHeight="40" Padding="0" Tag="#EF4444" Click="OnSelectAvatarColorClick">
                                                    <Border Width="32" Height="32" CornerRadius="16" Background="#EF4444" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" />
                                                </Button>
                                            </StackPanel>

                                            <Button Content="Kiosk rejimi (Toʻliq ekran F11)"
                                                    Style="{StaticResource SecondaryButton}"
                                                    MinHeight="46"
                                                    Click="OnToggleKioskClick" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- 2. PRINTERLAR BO'LIMI (QO'SHISH / TAHRIRLASH / O'CHIRISH / SINOV) -->
                            <StackPanel x:Name="SettingsSectionPrinters" Visibility="Collapsed">
                                <Grid Margin="0,0,0,14">
                                    <controls:SectionHeader Title="Tarmoq printerlari (LAN 9100)"
                                                            Subtitle="Printer qoʻshish, tahrirlash, oʻchirish va sinov cheki"
                                                            VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource PrimaryButton}"
                                            MinHeight="46"
                                            Padding="18,10"
                                            Click="OnAddPrinterClick">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:Icon Data="{StaticResource IconPlus}" Size="16" Foreground="{DynamicResource BrushTextOnPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Printer qoʻshish" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ItemsControl x:Name="PrintersItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:PrinterCard Margin="0,0,0,10"
                                                                  TestPrintClicked="OnPrinterCardTestClick"
                                                                  EditClicked="OnPrinterCardEditClick"
                                                                  DeleteClicked="OnPrinterCardDeleteClick"
                                                                  IpChanged="OnSettingsInputChanged" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="16,12"
                                        Margin="0,6,0,0">
                                    <CheckBox x:Name="AutoPrintCheck"
                                              Style="{StaticResource ToggleSwitch}"
                                              Content="Buyurtmada boʻlim printerlariga avtomatik chek chiqarish"
                                              IsChecked="True"
                                              Click="OnSettingsCheckChanged" />
                                </Border>
                            </StackPanel>

                            <!-- 3. ZALLAR BO'LIMI (QO'SHISH / TAHRIRLASH / O'CHIRISH) -->
                            <StackPanel x:Name="SettingsSectionHalls" Visibility="Collapsed">
                                <Grid Margin="0,0,0,14">
                                    <controls:SectionHeader Title="Restoran zallari boshqaruvi"
                                                            Subtitle="Zallarni qoʻshish, tahrirlash va oʻchirish (stollar xaritasida koʻrinadi)"
                                                            VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource PrimaryButton}"
                                            MinHeight="46"
                                            Padding="18,10"
                                            Click="OnAddHallClick">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:Icon Data="{StaticResource IconPlus}" Size="16" Foreground="{DynamicResource BrushTextOnPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Zal qoʻshish" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ItemsControl x:Name="SettingsHallsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushSurface}"
                                                    BorderBrush="{DynamicResource BrushBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="16,12"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextTitle}" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource BrushSurfaceElevated}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusXs}" Padding="8,4" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding TablesCountText}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding SortOrderText}" Style="{StaticResource TextCaptionMuted}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{DynamicResource BrushSurfaceElevated}" CornerRadius="{StaticResource RadiusFull}" Padding="10,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                                    </Border>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Tahrirlash" Style="{StaticResource SecondaryButton}" MinHeight="40" Padding="14,6" Margin="0,0,8,0" Tag="{Binding Model}" Click="OnManageEditHallClick" />
                                                        <Button Content="Oʻchirish" Style="{StaticResource DangerButton}" MinHeight="40" Padding="12,6" Tag="{Binding Model}" Click="OnManageDeleteHallClick" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 4. SERVER VA SINXRONIZATSIYA BO'LIMI -->
                            <StackPanel x:Name="SettingsSectionServer" Visibility="Collapsed">
                                <controls:SectionHeader Title="Server va baza sinxronizatsiyasi"
                                                        Subtitle="Cloud Django, lokal Wi-Fi Hub va taom rasmlari keshi" />

                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="20"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <controls:Field Label="Cloud Django Server manzili" HelperText="Internet boʻlganda markaziy server bilan sinxronlash uchun" Margin="0,0,0,16">
                                            <TextBox x:Name="ServerUrlBox" Text="https://dilkash-django-production.up.railway.app" TextChanged="OnSettingsTextChanged" />
                                        </controls:Field>

                                        <controls:Field Label="Ofitsiantlar uchun Wi-Fi Hub manzili" HelperText="Lokal tarmoqdagi ofitsiant ilovalari shu manzilga ulanadi (avtomatik Wi-Fi qidiruv faol)">
                                            <TextBox x:Name="LocalHubInfoBox" IsReadOnly="True" Text="http://127.0.0.1:8088" />
                                        </controls:Field>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="20">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Taom rasmlari va maʼlumotlar bazasi sinxronizatsiyasi" Style="{StaticResource TextBodyBold}" />
                                            <TextBlock x:Name="SyncImagesStatusText"
                                                       Text="Rasmlar bazadan lokal keshga sinxronlanadi"
                                                       Style="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       Margin="0,4,0,2" />
                                            <TextBlock x:Name="SyncLastTimeText"
                                                       Text="Oxirgi sinxron: -"
                                                       Style="{StaticResource TextCaptionMuted}" />
                                        </StackPanel>

                                        <Button HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryButton}"
                                                MinHeight="46"
                                                Padding="16,8"
                                                Click="OnManualSyncNowClick">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="16" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Hozir sinxronlash" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 5. XIZMAT HAQI VA TO'LOVLAR BO'LIMI -->
                            <StackPanel x:Name="SettingsSectionPayments" Visibility="Collapsed">
                                <controls:SectionHeader Title="Xizmat haqi"
                                                        Subtitle="Zal stollari uchun xizmat haqi hisoblash usuli" />

                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="20"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:Field Grid.Column="0" Label="Xizmat haqi turi">
                                            <ComboBox x:Name="ServiceFeeTypeCombo" SelectionChanged="OnSettingsComboChanged">
                                                <ComboBoxItem Content="Foizli (%)" IsSelected="True" Tag="percent" />
                                                <ComboBoxItem Content="Odam boshiga (soʻm)" Tag="per_person" />
                                                <ComboBoxItem Content="Xizmat haqi yoʻq (0%)" Tag="none" />
                                            </ComboBox>
                                        </controls:Field>

                                        <controls:Field Grid.Column="2" Label="Xizmat haqi miqdori" HelperText="Foiz (%) yoki har bir mehmon uchun soʻm">
                                            <TextBox x:Name="ServiceFeeValueBox" Text="10" Typography.NumeralAlignment="Tabular" TextChanged="OnSettingsTextChanged" />
                                        </controls:Field>
                                    </Grid>
                                </Border>

                                <controls:SectionHeader Title="Click va Payme integratsiyasi"
                                                        Subtitle="Onlayn toʻlov tizimi parametrlari" />

                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:Field Grid.Column="0" Label="Click Service ID">
                                                <TextBox x:Name="ClickServiceIdBox" TextChanged="OnSettingsTextChanged" />
                                            </controls:Field>
                                            <controls:Field Grid.Column="2" Label="Click Merchant ID">
                                                <TextBox x:Name="ClickMerchantIdBox" TextChanged="OnSettingsTextChanged" />
                                            </controls:Field>
                                        </Grid>
                                        <controls:Field x:Name="ClickSecretField" Label="Click Secret Key" HelperText="Yangi kalit kiritilmasa eskisi saqlanadi" Margin="0,0,0,14">
                                            <TextBox x:Name="ClickSecretBox" TextChanged="OnSettingsTextChanged" />
                                        </controls:Field>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:Field Grid.Column="0" Label="Payme Merchant ID">
                                                <TextBox x:Name="PaymeMerchantIdBox" TextChanged="OnSettingsTextChanged" />
                                            </controls:Field>
                                            <controls:Field x:Name="PaymeSecretField" Grid.Column="2" Label="Payme Secret Key">
                                                <TextBox x:Name="PaymeSecretBox" TextChanged="OnSettingsTextChanged" />
                                            </controls:Field>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 6. TELEGRAM BOT VA YETKAZIB BERISH BO'LIMI -->
                            <StackPanel x:Name="SettingsSectionBot" Visibility="Collapsed">
                                <controls:SectionHeader Title="Telegram Bot va yetkazib berish"
                                                        Subtitle="Ish vaqti, yetkazish tariflari va bot eʼloni" />

                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:Field Grid.Column="0" Label="Ish boshlanishi (HH:MM)">
                                                <TextBox x:Name="ServiceStartTimeBox" Text="10:00" Typography.NumeralAlignment="Tabular" TextChanged="OnSettingsTextChanged" />
                                            </controls:Field>
                                            <controls:Field Grid.Column="2" Label="Ish tugashi (HH:MM)">
                                                <TextBox x:Name="ServiceEndTimeBox" Text="22:00" Typography.NumeralAlignment="Tabular" TextChanged="OnSettingsTextChanged" />
                                            </controls:Field>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="0.8*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:Field Grid.Column="0" Label="Boshlangʻich (soʻm)">
                                                <TextBox x:Name="DeliveryBaseCostBox" Text="5000" Typography.NumeralAlignment="Tabular" TextChanged="OnSettingsTextChanged" />
                                            </controls:Field>
                                            <controls:Field Grid.Column="2" Label="Har km (soʻm)">
                                                <TextBox x:Name="DeliveryExtraKmCostBox" Text="6000" Typography.NumeralAlignment="Tabular" TextChanged="OnSettingsTextChanged" />
                                            </controls:Field>
                                            <controls:Field Grid.Column="4" Label="Radius (km)">
                                                <TextBox x:Name="DeliveryMaxRadiusBox" Text="10" Typography.NumeralAlignment="Tabular" TextChanged="OnSettingsTextChanged" />
                                            </controls:Field>
                                        </Grid>

                                        <controls:Field Label="Bot eʼlon matni (ixtiyoriy)">
                                            <TextBox x:Name="BroadcastTextBox" Height="84" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,10" TextChanged="OnSettingsTextChanged" />
                                        </controls:Field>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Settings Loading Skeleton -->
                    <StackPanel x:Name="SettingsLoadingState" Grid.Row="0" Visibility="Collapsed">
                        <controls:SkeletonBox Height="96" Margin="0,0,0,12" />
                        <controls:SkeletonBox Height="180" Margin="0,0,0,12" />
                        <controls:SkeletonBox Height="120" />
                    </StackPanel>

                    <!-- Sticky Bottom Save Bar (Visible ONLY when dirty) -->
                    <Border x:Name="SettingsDirtyBar"
                            Grid.Row="1"
                            Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="20,12"
                            Margin="0,10,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:Icon Data="{StaticResource IconAlert}" Size="18" Foreground="{DynamicResource BrushAmberBright}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sozlamalarda saqlanmagan oʻzgarishlar bor" Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Bekor qilish"
                                        Style="{StaticResource GhostButton}"
                                        MinHeight="48"
                                        Margin="0,0,8,0"
                                        Click="OnDiscardSettingsClick" />
                                <Button Content="Saqlash"
                                        Style="{StaticResource PrimaryButton}"
                                        MinHeight="48"
                                        Padding="24,10"
                                        Click="OnSaveSettingsClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- MODAL BACKDROP SCRIM -->
        <Border x:Name="ModalScrim"
                Background="{DynamicResource BrushScrim}"
                Visibility="Collapsed"
                IsHitTestVisible="True" />

        <!-- LOCK SCREEN OVERLAY -->
        <Grid x:Name="LockOverlay"
              Background="{DynamicResource BrushScrim}"
              Visibility="Collapsed"
              IsHitTestVisible="True">
            <Rectangle Fill="{DynamicResource BrushGirihLattice}" IsHitTestVisible="False" />
            <Border Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusXl}"
                    Padding="48,40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="380">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource ColorShadow}" BlurRadius="28" ShadowDepth="6" Opacity="0.28" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Image Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Image.Source>
                            <DrawingImage Drawing="{StaticResource DrawingBrandMonogram}" />
                        </Image.Source>
                    </Image>

                    <Border Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusFull}"
                            Padding="14,6"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconUser}" Size="15" Foreground="{DynamicResource BrushPrimaryBright}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="LockCashierNameText" Text="Jasur Rahimov" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Ekran qulflangan"
                               Style="{StaticResource TextSection}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6" />
                    <TextBlock x:Name="LockSubtitleText"
                               Text="Ishni davom ettirish uchun Ochish tugmasini bosing"
                               Style="{StaticResource TextBody}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <StackPanel x:Name="LockPinPanel" Visibility="Collapsed" Width="240" Margin="0,0,0,18">
                        <PasswordBox x:Name="LockPinBox"
                                     HorizontalContentAlignment="Center"
                                     FontSize="18"
                                     KeyDown="OnLockPinKeyDown" />
                        <TextBlock x:Name="LockPinErrorText"
                                   Text="PIN-kod notoʻgʻri"
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource BrushErrorBright}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <Button Content="Ochish"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="56"
                            Width="220"
                            HorizontalAlignment="Center"
                            Click="OnUnlockAppClick" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- TOAST HOST (Bottom-Center) -->
        <controls:ToastHost x:Name="MainToastHost" />
    </Grid>
</Window>