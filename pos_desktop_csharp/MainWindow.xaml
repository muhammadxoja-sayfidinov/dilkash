                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kassir ismi:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="CashierNameBox" Grid.Column="1" Text="Jasur Rahimov" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="💾 BARCHA SOZLAMALARNI SAQLASH" Height="62" FontSize="18" FontWeight="Black"
                                Style="{StaticResource TouchButtonStyle}" Background="{StaticResource BrandPrimaryBrush}" Click="OnSaveSettingsClick" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- MODAL BACKDROP SCRIM -->
        <Border x:Name="ModalScrim"
                Background="{DynamicResource BrushScrim}"
                Visibility="Collapsed"
                IsHitTestVisible="True" />

        <!-- LOCK SCREEN OVERLAY -->
        <Grid x:Name="LockOverlay"
              Background="{DynamicResource BrushScrim}"
              Visibility="Collapsed"
              IsHitTestVisible="True">
            <Rectangle Fill="{DynamicResource BrushGirihLattice}" IsHitTestVisible="False" />
            <Border Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusXl}"
                    Padding="48,40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="380">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.6" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Image Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Image.Source>
                            <DrawingImage Drawing="{StaticResource DrawingBrandMonogram}" />
                        </Image.Source>
                    </Image>

                    <Border Background="{DynamicResource BrushSurfaceElevated}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusFull}"
                            Padding="14,6"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource IconUser}" Size="15" Foreground="{DynamicResource BrushPrimaryBright}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="LockCashierNameText" Text="Jasur Rahimov" Style="{StaticResource TextLabel}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Ekran qulflangan"
                               Style="{StaticResource TextSection}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Ishni davom ettirish uchun Ochish tugmasini bosing"
                               Style="{StaticResource TextBody}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28" />

                    <Button Content="Ochish"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="56"
                            Width="220"
                            HorizontalAlignment="Center"
                            Click="OnUnlockAppClick" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- TOAST HOST (Bottom-Center) -->
        <controls:ToastHost x:Name="MainToastHost" />
    </Grid>
</Window>