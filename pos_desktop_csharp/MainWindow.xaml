<Window x:Class="DilkashPos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dilkash Restaurant POS (Enterprise Edition)" Height="850" Width="1380"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BgDarkBrush}"
        Loaded="OnWindowLoaded"
        KeyDown="OnWindowKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- YUQORI HEADER PANELI (ENTERPRISE BRAND BAR) -->
        <Border Grid.Row="0" Background="{StaticResource BrandDarkBrush}" BorderBrush="#047857" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brend Logo va Nomi -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10B981" CornerRadius="10" Width="46" Height="46" Margin="0,0,12,0">
                        <TextBlock Text="🍵" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DILKASH POS" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
                        <TextBlock Text="RESTORAN VA KASSA TIZIMI" FontSize="11" Foreground="#A7F3D0" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <!-- Markaziy Asosiy Modullar Navigatsiyasi -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="NavTablesBtn" Content="🍽 STOLLAR XARITASI" Margin="4,0" Padding="18,10" Style="{StaticResource TouchButtonStyle}" Click="OnNavClicked" Tag="tables" />
                    <Button x:Name="NavQuickPosBtn" Content="⚡ TEZKOR SABOY" Margin="4,0" Padding="18,10" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNavClicked" Tag="quick_pos" />
                    <Button x:Name="NavStopListBtn" Content="🛑 STOP-LIST" Margin="4,0" Padding="18,10" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNavClicked" Tag="stop_list" />
                    <Button x:Name="NavOnlineBtn" Content="📲 ONLINE BUYURTMALAR" Margin="4,0" Padding="18,10" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNavClicked" Tag="online" />
                    <Button x:Name="NavSettingsBtn" Content="⚙ PRINTER &amp; SOZLAMALAR" Margin="4,0" Padding="18,10" Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" Click="OnNavClicked" Tag="settings" />
                </StackPanel>

                <!-- O'ng Tomon: Smena, Server Aloqasi, Soat va Kiosk -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Smena Tugmasi -->
                    <Button Content="📊 SMENA &amp; Z-HISOBOT" Margin="0,0,10,0" Padding="14,8" Height="42" FontSize="12" FontWeight="Bold" Style="{StaticResource TouchGoldButton}" Click="OnShiftReportClick" />

                    <!-- Server Aloqasi Indikatori -->
                    <Border x:Name="StatusBadgeBorder" Background="{StaticResource SuccessGreenBrush}" CornerRadius="20" Padding="12,6" Margin="0,0,10,0">
                        <TextBlock x:Name="StatusBadgeText" Text="● ONLINE (REST API)" FontSize="12" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <!-- Offline Navbat Indikatori -->
                    <Border x:Name="QueueBadgeBorder" Background="{StaticResource AccentGoldBrush}" CornerRadius="20" Padding="12,6" Margin="0,0,10,0" Visibility="Collapsed">
                        <TextBlock x:Name="QueueBadgeText" Text="⏳ Navbat: 0" FontSize="12" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <!-- Soat -->
                    <TextBlock x:Name="ClockText" Text="12:00:00" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0" />

                    <!-- Kiosk Rejimi -->
                    <Button Content="⛶ KIOSK" Width="84" Height="42" FontSize="12" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="#1E293B" Click="OnToggleKioskClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ASOSIY ISH MAYDONI (MAIN APPLICATION WORKSPACE) -->
        <Grid Grid.Row="1" Margin="16">
            <!-- ========================================== -->
            <!-- 1. TAB: STOLLAR XARITASI (TABLES MAP)      -->
            <!-- ========================================== -->
            <Grid x:Name="TablesTab" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Zallar Filtr Qatori va Statistikasi -->
                <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Zallarni tanlang:" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button x:Name="FilterAllBtn" Content="Barcha Zallar (12)" Style="{StaticResource TouchButtonStyle}" Height="40" Margin="0,0,8,0" Click="OnTableFilterAll" />
                            <Button x:Name="FilterZalBtn" Content="Asosiy Zal (6)" Style="{StaticResource TouchButtonStyle}" Background="#334155" Height="40" Margin="0,0,8,0" Click="OnTableFilterZal" />
                            <Button x:Name="FilterTerrasaBtn" Content="Ochiq Terrasa (3)" Style="{StaticResource TouchButtonStyle}" Background="#334155" Height="40" Margin="0,0,8,0" Click="OnTableFilterTerrasa" />
                            <Button x:Name="FilterVipBtn" Content="VIP Xonalar (3)" Style="{StaticResource TouchButtonStyle}" Background="#334155" Height="40" Margin="0,0,8,0" Click="OnTableFilterVip" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#10B981" CornerRadius="6" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="Bo'sh: " Foreground="#94A3B8" FontSize="13" />
                            <TextBlock x:Name="EmptyTablesCountText" Text="10" FontWeight="Bold" Foreground="White" FontSize="13" Margin="0,0,16,0" />

                            <Border Background="#EF4444" CornerRadius="6" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="Band: " Foreground="#94A3B8" FontSize="13" />
                            <TextBlock x:Name="OccupiedTablesCountText" Text="2" FontWeight="Bold" Foreground="White" FontSize="13" Margin="0,0,16,0" />

                            <Border Background="#F59E0B" CornerRadius="6" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="Hisob berildi: " Foreground="#94A3B8" FontSize="13" />
                            <TextBlock x:Name="BillPrintedCountText" Text="0" FontWeight="Bold" Foreground="White" FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Stollar Panjarasi -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="TablesWrapPanel" Margin="0,0,0,20">
                        <!-- Professional stol kartalari dinamik kiritiladi -->
                    </WrapPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================================== -->
            <!-- 2. TAB: TEZKOR SABOY VA STOL BUYURTMASI    -->
            <!-- ========================================== -->
            <Grid x:Name="QuickPosTab" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <!-- Chap: Kategoriyalar Paneli -->
                <Border Grid.Column="0" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="TOIFALAR" FontSize="14" FontWeight="Bold" Foreground="#94A3B8" Margin="8,4,0,10" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CategoriesStackPanel">
                                <!-- Kategoriya tugmalari -->
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- O'rta: Taomlar Panjarasi -->
                <Grid Grid.Column="1" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Qidiruv Qutisi -->
                    <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="8,4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="18" VerticalAlignment="Center" Margin="8,0,8,0" />
                            <TextBox x:Name="ProductSearchBox" Grid.Column="1" Height="44" Padding="4,10" FontSize="16" 
                                     Background="Transparent" Foreground="White" BorderThickness="0"
                                     TextChanged="OnProductSearchChanged" />
                            <Button Grid.Column="2" Content="✕" Width="36" Height="36" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Click="OnClearSearchClick" />
                        </Grid>
                    </Border>

                    <!-- Taomlar Panjarasi -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ProductsWrapPanel">
                            <!-- Taom kartochkalari -->
                        </WrapPanel>
                    </ScrollViewer>
                </Grid>

                <!-- O'ng: Buyurtma Cheki Savatchasi (Receipt Cart) -->
                <Border Grid.Column="2" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Chek Sarlavhasi va Konteksti -->
                        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="CartTitleText" Text="TEZKOR SABOY (OLIB KETISH)" FontSize="17" FontWeight="ExtraBold" Foreground="White" />
                                    <TextBlock x:Name="CartSubtitleText" Text="Kassir: Jasur | Sana: Bugun" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Content="🗑 Tozalash" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,6" Style="{StaticResource TouchDangerButton}" Height="34" FontSize="12" Click="OnClearCartClick" />
                            </Grid>
                        </Border>

                        <!-- Elementlar Ro'yxati -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CartItemsStackPanel">
                                <!-- Savatcha elementlari -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Hisob-kitob va Chegirma -->
                        <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="14,12" Margin="0,10,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Taomlar summasi:" FontSize="14" Foreground="#94A3B8" />
                                    <TextBlock x:Name="CartSubtotalText" Text="0 so'm" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Chegirma Qatori (Bosiladigan) -->
                                <Grid Margin="0,0,0,4">
                                    <Button x:Name="DiscountPillBtn" Content="🏷 Chegirma: 0%" Height="30" Padding="8,2" FontSize="12" FontWeight="Bold" Style="{StaticResource TouchGoldButton}" HorizontalAlignment="Left" Click="OnDiscountPillClick" />
                                    <TextBlock x:Name="CartDiscountText" Text="-0 so'm" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentGoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="ServiceFeeLabelText" Text="Xizmat haqi (10%):" FontSize="14" Foreground="#94A3B8" />
                                    <TextBlock x:Name="CartServiceFeeText" Text="0 so'm" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" />
                                </Grid>

                                <Border BorderBrush="#334155" BorderThickness="0,1,0,0" Margin="0,4,0,6" />

                                <Grid>
                                    <TextBlock Text="JAMI TO'LOV:" FontSize="18" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CartTotalText" Text="0 so'm" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Pastki Harakatlar Paneli -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Pre-chek va Oshxonaga yuborish -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🍳 OSHXONAGA YUBORISH" Height="46" FontSize="13" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnSendToKitchenClick" />
                                <Button Grid.Column="2" Content="📄 PRE-CHEK CHIQARISH" Height="46" FontSize="13" FontWeight="Bold" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnPrintPreChekClick" />
                            </Grid>

                            <!-- TO'LOV QABUL QILISH (Katta Tugma) -->
                            <Button Grid.Row="2" Content="💳 TO'LOV QABUL QILISH (F12)" Height="66" FontSize="20" FontWeight="ExtraBold"
                                    Style="{StaticResource TouchButtonStyle}" Background="{StaticResource SuccessGreenBrush}" Click="OnPayCartClick" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- 3. TAB: STOP-LIST BOSHQARUVI               -->
            <!-- ========================================== -->
            <Grid x:Name="StopListTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="🛑 OSHXONA STOP-LIST BOSHQARUVI" FontSize="20" FontWeight="ExtraBold" Foreground="White" />
                            <TextBlock Text="Tugagan taomni bitta bosish bilan o'chiring. Bot va mobil ilovalarda darhol sotuvdan olinadi." FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StopListSearchBox" Height="44" Padding="12,10" FontSize="15" 
                                     Background="#0F172A" Foreground="White" BorderBrush="#334155"
                                     TextChanged="OnStopListSearchChanged" />
                            <TextBlock x:Name="StopListSummaryText" Grid.Column="1" Text="Jami: 40 ta | Mavjud: 40 ta | Stop-listda: 0 ta" FontSize="15" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="StopListWrapPanel">
                        <!-- Stop-list kartochkalari -->
                    </WrapPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================================== -->
            <!-- 4. TAB: ONLINE BUYURTMALAR (TELEGRAM & APP)-->
            <!-- ========================================== -->
            <Grid x:Name="OnlineTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="📲 TELEGRAM BOT VA MOBIL ILOVA BUYURTMALARI" FontSize="20" FontWeight="ExtraBold" Foreground="White" />
                            <TextBlock Text="Yangi kelgan buyurtmalarni qabul qiling va oshxona printerlariga avtomatik chek chiqaring" FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Content="🔄 Yangilash" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnRefreshOnlineOrdersClick" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OnlineOrdersStackPanel">
                        <!-- Online buyurtmalar kartochkalari -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================================== -->
            <!-- 5. TAB: PRINTERLAR VA SOZLAMALAR           -->
            <!-- ========================================== -->
            <Grid x:Name="SettingsTab" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="960" HorizontalAlignment="Left">
                        <TextBlock Text="Tarmoq Printerlari Sozlamalari (LAN ESC/POS IP: 9100)" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" />
                        <TextBlock Text="Har bir bo'lim uchun tarmoq printeri IP manzilini kiriting va aloqani tekshirib ko'ring" FontSize="14" Foreground="#94A3B8" Margin="0,0,0,20" />

                        <!-- 6 ta Tarmoq Printerlari -->
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Kassa Printeri -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🧾 Kassa Printeri IP:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBox x:Name="IpKassaBox" Grid.Column="1" Text="192.168.1.100:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnTestPrintKassa" />
                                </Grid>

                                <!-- Shashlikxona -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🥩 Shashlikxona IP:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBox x:Name="IpShashlikBox" Grid.Column="1" Text="192.168.1.101:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnTestPrintShashlik" />
                                </Grid>

                                <!-- Somsaxona -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🥟 Somsaxona IP:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBox x:Name="IpSomsaBox" Grid.Column="1" Text="192.168.1.102:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnTestPrintSomsa" />
                                </Grid>

                                <!-- Issiq Oshxona -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🍲 Issiq Oshxona IP:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBox x:Name="IpKitchenBox" Grid.Column="1" Text="192.168.1.103:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnTestPrintKitchen" />
                                </Grid>

                                <!-- Fast-Food -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🍔 Fast-Food IP:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBox x:Name="IpFastfoodBox" Grid.Column="1" Text="192.168.1.104:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnTestPrintFastfood" />
                                </Grid>

                                <!-- Bar & Desert -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="☕ Bar &amp; Desert IP:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBox x:Name="IpBarBox" Grid.Column="1" Text="192.168.1.105:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchButtonStyle}" Background="#334155" Click="OnTestPrintBar" />
                                </Grid>

                                <!-- Avtomatik tarmoqqa yuborish checkbox -->
                                <CheckBox x:Name="AutoPrintCheck" Content="Buyurtma olinganda avtomatik barcha tegishli bo'lim printerlariga chek yuborish" 
                                          FontSize="14" FontWeight="SemiBold" Foreground="#10B981" Margin="0,10,0,0" IsChecked="True" />
                            </StackPanel>
                        </Border>

                        <!-- Server Manzili va Xizmat Haqini Sozlash -->
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Server va Xizmat Haqini Sozlash" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Django Server URL:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="ServerUrlBox" Grid.Column="1" Text="http://127.0.0.1:8000" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Xizmat haqi turi:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <ComboBox x:Name="ServiceFeeTypeCombo" Grid.Column="1" Height="42" Background="#0F172A" Foreground="White" BorderBrush="#334155" FontSize="14" Padding="8,4">
                                        <ComboBoxItem Content="Foizli (%)" IsSelected="True" Tag="percent" />
                                        <ComboBoxItem Content="Odam boshiga (soʻm)" Tag="per_person" />
                                        <ComboBoxItem Content="Xizmat haqi yoʻq (0%)" Tag="none" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
