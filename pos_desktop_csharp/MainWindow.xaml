<Window x:Class="DilkashPos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dilkash Restaurant POS — Professional Enterprise Edition (1920x1080 Full HD)" 
        Height="1080" Width="1920"
        MinWidth="1366" MinHeight="768"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BgDarkBrush}"
        Loaded="OnWindowLoaded"
        KeyDown="OnWindowKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 1. Chap Navigatsiya Paneli (Enterprise Sidebar Rail) - 280px -->
            <ColumnDefinition Width="280" />
            <!-- 2. Asosiy Ish Maydoni (Workspace Canvas) - 1640px -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- CHAP DILKASH NAVIGATSIYA SIDEBARI (WIDTH: 280PX)          -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Logo va Brend (100px) -->
                    <RowDefinition Height="100" />
                    <!-- Kassir Smena Kartochkasi (95px) -->
                    <RowDefinition Height="95" />
                    <!-- Navigatsiya Tugmalari (*) -->
                    <RowDefinition Height="*" />
                    <!-- Tizim Holati va Soat Deck (Auto) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Brend & Logo -->
                <Border Grid.Row="0" Background="#091E18" BorderBrush="#134E39" BorderThickness="0,0,0,1" Padding="16,14">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#10B981" CornerRadius="12" Width="52" Height="52" Margin="0,0,12,0">
                            <TextBlock Text="🍵" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="DILKASH POS" FontSize="22" FontWeight="Black" Foreground="White" />
                            <TextBlock Text="RESTAURANT &amp; LOUNGE" FontSize="10" FontWeight="Bold" Foreground="#10B981" Margin="0,1,0,0" />
                            <TextBlock Text="1920x1080 Enterprise Kassa" FontSize="10" Foreground="#64748B" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Kassir va Smena Kartochkasi -->
                <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Margin="14,12" Padding="12,10" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#0D6B4E" CornerRadius="20" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SidebarCashierNameText" Text="Jasur Rahimov" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Bosh Kassir • Kassa #01" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0" />
                            <TextBlock x:Name="SidebarShiftDurationText" Text="⏱ Smena: 08:30 dan beri" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Asosiy Sensorli Navigatsiya Tugmalari -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="10,4,10,10">
                    <StackPanel>
                        <!-- 1. Stollar Xaritasi -->
                        <Button x:Name="NavTablesBtn" Height="62" Margin="0,0,0,8" Padding="14,8"
                                Style="{StaticResource TouchButtonStyle}" Background="{StaticResource BrandPrimaryBrush}" 
                                Click="OnNavClicked" Tag="tables" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🍽" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Stollar Zali" FontSize="15" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="Zallar va ochiq hisoblar" FontSize="11" Foreground="#A7F3D0" />
                                </StackPanel>
                                <Border x:Name="NavTablesCountBorder" Grid.Column="2" Background="#064E3B" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavTablesCountBadge" Text="12" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- 2. Tezkor Kassa (Saboy) -->
                        <Button x:Name="NavQuickPosBtn" Height="62" Margin="0,0,0,8" Padding="14,8"
                                Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" 
                                Click="OnNavClicked" Tag="quick_pos" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚡" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Tezkor Kassa" FontSize="15" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="Saboy va tezkor to'lov" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="#334155" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="F2" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- 3. Stop-List Boshqaruvi -->
                        <Button x:Name="NavStopListBtn" Height="62" Margin="0,0,0,8" Padding="14,8"
                                Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" 
                                Click="OnNavClicked" Tag="stop_list" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🛑" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Stop-List" FontSize="15" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="Oshxona taomlar holati" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                                <Border x:Name="NavStopListBadgeBorder" Grid.Column="2" Background="#EF4444" CornerRadius="10" Padding="8,3" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="NavStopListCountBadge" Text="0" FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- 4. Online Buyurtmalar (Bot & Mobil) -->
                        <Button x:Name="NavOnlineBtn" Height="62" Margin="0,0,0,8" Padding="14,8"
                                Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" 
                                Click="OnNavClicked" Tag="online" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📲" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Online Buyurtma" FontSize="15" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="Telegram &amp; Mobil ilova" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                                <Border x:Name="NavOnlineBadgeBorder" Grid.Column="2" Background="#F59E0B" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavOnlineBadgeText" Text="0" FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- 5. Smena & Z-Hisobot -->
                        <Button x:Name="NavShiftBtn" Height="62" Margin="0,0,0,8" Padding="14,8"
                                Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" 
                                Click="OnNavClicked" Tag="shift" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📊" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Smena &amp; Hisobot" FontSize="15" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="X / Z Hisobot va kassa" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- 6. Printerlar va Sozlamalar -->
                        <Button x:Name="NavSettingsBtn" Height="62" Margin="0,0,0,8" Padding="14,8"
                                Style="{StaticResource TouchButtonStyle}" Background="{StaticResource CardDarkBrush}" 
                                Click="OnNavClicked" Tag="settings" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚙" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Printer &amp; Tarmoq" FontSize="15" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="6 ta LAN IP va sozlama" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. Pastki Tizim Holati, Soat va Kiosk Boshqaruvi -->
                <Border Grid.Row="3" Background="#091120" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="14,12">
                    <StackPanel>
                        <!-- Server Status Badge -->
                        <Border x:Name="StatusBadgeBorder" Background="{StaticResource SuccessGreenBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                            <TextBlock x:Name="StatusBadgeText" Text="● ONLINE (REST API)" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                        </Border>

                        <!-- Offline Navbat Indikatori -->
                        <Border x:Name="QueueBadgeBorder" Background="{StaticResource AccentGoldBrush}" CornerRadius="8" Padding="10,5" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock x:Name="QueueBadgeText" Text="⏳ Navbat: 0 ta" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                        </Border>

                        <!-- Katta Raqamli Soat va Sana -->
                        <Grid Margin="0,4,0,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="ClockText" Text="12:00:00" FontSize="24" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock x:Name="DateText" Text="Bugun" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Kiosk va Qulflash Tugmalari -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="⛶ Kiosk (F11)" Height="42" FontSize="12" FontWeight="Bold" Style="{StaticResource TouchSecondaryButton}" Click="OnToggleKioskClick" />
                            <Button Grid.Column="2" Content="🔒 Qulflash" Height="42" FontSize="12" FontWeight="Bold" Style="{StaticResource TouchSecondaryButton}" Click="OnLockAppClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- O'NG ASOSIY ISH MAYDONI (WIDTH: 1640PX X 1080PX)          -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1" Background="{StaticResource BgDarkBrush}" Margin="16,14,16,14">

            <!-- ===================================================== -->
            <!-- 1. TAB: STOLLAR XARITASI (TABLES MAP VIEW)            -->
            <!-- ===================================================== -->
            <Grid x:Name="TablesTab" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Top Zone & Status Filter Bar (72px) -->
                    <RowDefinition Height="72" />
                    <!-- Tables Grid (*) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Zallar Filtr Qatori va Statistikasi -->
                <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="16,10" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <!-- Chap: Zallar Bo'yicha Filtrlar -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Zalni tanlang:" FontSize="15" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button x:Name="FilterAllBtn" Content="🏛 Barcha Zallar (12)" Style="{StaticResource TouchButtonStyle}" Height="46" Padding="18,8" Margin="0,0,8,0" Click="OnTableFilterAll" />
                            <Button x:Name="FilterZalBtn" Content="🛋 Asosiy Zal (6)" Style="{StaticResource TouchSecondaryButton}" Height="46" Padding="18,8" Margin="0,0,8,0" Click="OnTableFilterZal" />
                            <Button x:Name="FilterTerrasaBtn" Content="🌿 Ochiq Terrasa (3)" Style="{StaticResource TouchSecondaryButton}" Height="46" Padding="18,8" Margin="0,0,8,0" Click="OnTableFilterTerrasa" />
                            <Button x:Name="FilterVipBtn" Content="👑 VIP Xonalar (3)" Style="{StaticResource TouchSecondaryButton}" Height="46" Padding="18,8" Margin="0,0,8,0" Click="OnTableFilterVip" />
                        </StackPanel>

                        <!-- O'ng: Jonli Holat Ko'rsatkichlari -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Bo'sh -->
                            <Border Background="#064E3B" CornerRadius="8" Padding="12,8" Margin="0,0,8,0" BorderBrush="#10B981" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#10B981" CornerRadius="6" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Bo'sh stollar: " Foreground="#A7F3D0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="EmptyTablesCountText" Text="10" FontWeight="Black" Foreground="White" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Band -->
                            <Border Background="#450A0A" CornerRadius="8" Padding="12,8" Margin="0,0,8,0" BorderBrush="#EF4444" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#EF4444" CornerRadius="6" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Band stollar: " Foreground="#FECACA" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OccupiedTablesCountText" Text="2" FontWeight="Black" Foreground="White" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Pre-chek -->
                            <Border Background="#451A03" CornerRadius="8" Padding="12,8" BorderBrush="#F59E0B" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#F59E0B" CornerRadius="6" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Hisob berildi: " Foreground="#FDE68A" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BillPrintedCountText" Text="0" FontWeight="Black" Foreground="White" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Keng Stollar Maydoni (Spacious 1920x1080 Grid) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="TablesWrapPanel" Margin="0,0,0,20">
                        <!-- Har bir stol kartasi 380x215px bo'lib, yuqori sifatda dinamik joylanadi -->
                    </WrapPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===================================================== -->
            <!-- 2. TAB: TEZKOR KASSA & SABOY (3-COLUMN POS WORKSPACE) -->
            <!-- ===================================================== -->
            <Grid x:Name="QuickPosTab" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <!-- Chap: Toifalar Tanlovi (260px) -->
                    <ColumnDefinition Width="260" />
                    <!-- O'rta: Taomlar Katalogi va Qidiruv (Keng) -->
                    <ColumnDefinition Width="*" />
                    <!-- O'ng: Buyurtma Cheki Savatchasi (460px) -->
                    <ColumnDefinition Width="460" />
                </Grid.ColumnDefinitions>

                <!-- 1. TOIFALAR USTUNI (WIDTH: 260PX) -->
                <Border Grid.Column="0" Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="12" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="MENYU TOIFALARI" FontSize="14" FontWeight="Black" Foreground="#94A3B8" Margin="8,4,0,12" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CategoriesStackPanel">
                                <!-- Kategoriya tugmalari (54px balandlikda) -->
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 2. TAOMLAR KATALOGI USTUNI (MARKAZIY) -->
                <Grid Grid.Column="1" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Qidiruv va Tezkor Filtrlash Qatori -->
                    <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="12,8" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="20" VerticalAlignment="Center" Margin="8,0,10,0" />
                            <TextBox x:Name="ProductSearchBox" Grid.Column="1" Height="46" Padding="6,10" FontSize="17" 
                                     Background="Transparent" Foreground="White" BorderThickness="0"
                                     TextChanged="OnProductSearchChanged" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="✕ Tozalash" Padding="12,6" Height="36" Style="{StaticResource TouchSecondaryButton}" Click="OnClearSearchClick" />
                        </Grid>
                    </Border>

                    <!-- Taomlar Katta Panjarasi -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ProductsWrapPanel" Margin="0,0,0,20">
                            <!-- Taom kartochkalari (220x165px) -->
                        </WrapPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 3. BUYURTMA CHEKI SAVATCHASI (RECEIPT CART - 460PX) -->
                <Border Grid.Column="2" Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="18" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Chek Sarlavhasi (Auto) -->
                            <RowDefinition Height="Auto" />
                            <!-- Elementlar Ro'yxati (*) -->
                            <RowDefinition Height="*" />
                            <!-- Summa va Hisob-kitob (Auto) -->
                            <RowDefinition Height="Auto" />
                            <!-- Katta To'lov va Chek Tugmalari (Auto) -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Chek Sarlavhasi va Konteksti -->
                        <Border Grid.Row="0" Background="#0B1323" CornerRadius="10" Padding="14,12" Margin="0,0,0,12" BorderBrush="#1E293B" BorderThickness="1">
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="CartTitleText" Text="⚡ TEZKOR SABOY (OLIB KETISH)" FontSize="18" FontWeight="Black" Foreground="White" />
                                    <TextBlock x:Name="CartSubtitleText" Text="Kassir: Jasur • Sana: Bugun" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Content="🗑 Tozalash" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,6" Style="{StaticResource TouchDangerButton}" Height="36" FontSize="12" Click="OnClearCartClick" />
                            </Grid>
                        </Border>

                        <!-- Elementlar Ro'yxati (Scrollable) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CartItemsStackPanel">
                                <!-- Savatcha elementlari -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Moliyaviy Xulosa Qutisi -->
                        <Border Grid.Row="2" Background="#0B1323" CornerRadius="10" Padding="16,14" Margin="0,10,0,10" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <!-- Taomlar summasi -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Taomlar summasi:" FontSize="15" Foreground="#94A3B8" />
                                    <TextBlock x:Name="CartSubtotalText" Text="0 so'm" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Chegirma Qatori (Bosiladigan F4) -->
                                <Grid Margin="0,0,0,6">
                                    <Button x:Name="DiscountPillBtn" Content="🏷 Chegirma: 0%" Height="32" Padding="10,2" FontSize="12" FontWeight="Bold" Style="{StaticResource TouchGoldButton}" HorizontalAlignment="Left" Click="OnDiscountPillClick" />
                                    <TextBlock x:Name="CartDiscountText" Text="-0 so'm" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentGoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Xizmat haqi -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="ServiceFeeLabelText" Text="Xizmat haqi (10%):" FontSize="15" Foreground="#94A3B8" />
                                    <TextBlock x:Name="CartServiceFeeText" Text="0 so'm" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" />
                                </Grid>

                                <Border BorderBrush="#1E293B" BorderThickness="0,1,0,0" Margin="0,4,0,8" />

                                <!-- JAMI TO'LOV -->
                                <Grid>
                                    <TextBlock Text="JAMI TO'LOV:" FontSize="19" FontWeight="Black" Foreground="White" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CartTotalText" Text="0 so'm" FontSize="30" FontWeight="Black" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Pastki Harakatlar Paneli -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Bo'limlarga Yuborish va Pre-chek -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🍳 BO'LIMLARGA YUBORISH" Height="50" FontSize="13" FontWeight="Bold" Style="{StaticResource TouchSecondaryButton}" Click="OnSendToKitchenClick" />
                                <Button Grid.Column="2" Content="📄 PRE-CHEK CHIQARISH" Height="50" FontSize="13" FontWeight="Bold" Style="{StaticResource TouchSecondaryButton}" Click="OnPrintPreChekClick" />
                            </Grid>

                            <!-- Katta To'lov Qabul Qilish Tugmasi -->
                            <Button Grid.Row="2" Content="💳 TO'LOV QABUL QILISH (F12)" Height="72" FontSize="21" FontWeight="Black"
                                    Style="{StaticResource TouchButtonStyle}" Background="{StaticResource SuccessGreenBrush}" Click="OnPayCartClick" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- 3. TAB: STOP-LIST BOSHQARUVI                          -->
            <!-- ===================================================== -->
            <Grid x:Name="StopListTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Sarlavha va Tavsif -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="🛑 OSHXONA STOP-LIST BOSHQARUVI" FontSize="22" FontWeight="Black" Foreground="White" />
                            <TextBlock Text="Tugagan taomni bitta bosish bilan to'xtating. Bot, ofitsiantlar va dasturda darhol sotuvdan olinadi." FontSize="14" Foreground="#94A3B8" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Qidiruv va Metrika Qatori -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0F172A" CornerRadius="10" Padding="10,4" BorderBrush="#334155" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="🔍" FontSize="18" VerticalAlignment="Center" Margin="6,0,8,0" />
                                    <TextBox x:Name="StopListSearchBox" Height="42" Padding="32,8,10,8" FontSize="16" 
                                             Background="Transparent" Foreground="White" BorderThickness="0"
                                             TextChanged="OnStopListSearchChanged" VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="StopListSummaryText" Grid.Column="1" Text="Jami: 40 ta | Mavjud: 40 ta | Stop-listda: 0 ta" FontSize="16" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Taomlar Stop-list Panjarasi (Keng 380x100px kartalar) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="StopListWrapPanel" Margin="0,0,0,20">
                        <!-- Stop-list kartochkalari -->
                    </WrapPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===================================================== -->
            <!-- 4. TAB: ONLINE BUYURTMALAR (TELEGRAM & MOBIL ILOVA)   -->
            <!-- ===================================================== -->
            <Grid x:Name="OnlineTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="📲 TELEGRAM BOT VA MOBIL ILOVA BUYURTMALARI" FontSize="22" FontWeight="Black" Foreground="White" />
                            <TextBlock Text="Mijozlardan kelgan yangi buyurtmalarni ko'rib chiqing, qabul qiling va oshxonaga chek chiqaring" FontSize="14" Foreground="#94A3B8" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="🔄 Yangilash (F5)" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="18,10" Height="48" Style="{StaticResource TouchSecondaryButton}" Click="OnRefreshOnlineOrdersClick" />
                    </Grid>
                </Border>

                <!-- Online Buyurtmalar Ro'yxati -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OnlineOrdersStackPanel" Margin="0,0,0,20">
                        <!-- Online buyurtmalar kartochkalari -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===================================================== -->
            <!-- 5. TAB: SMENA VA Z-HISOBOT (ANALYTICS & FINANCIAL)     -->
            <!-- ===================================================== -->
            <Grid x:Name="ShiftReportTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sarlavha -->
                <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="📊 KASSA SMENASI VA MOLIYAVIY Z-HISOBOT" FontSize="22" FontWeight="Black" Foreground="White" />
                            <TextBlock x:Name="ShiftHeaderInfoText" Text="Smena ochiq • Kassir: Jasur Rahimov • Boshlanish: Bugun 08:30" FontSize="14" Foreground="#94A3B8" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="🖨 X-Hisobot Chop Etish" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="18,10" Height="48" Style="{StaticResource TouchGoldButton}" Click="OnPrintXReportDirect" />
                    </Grid>
                </Border>

                <!-- 4 Katta KPI Ko'rsatkich Kartochkalari -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 1. Jami Savdo -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="18" BorderBrush="#10B981" BorderThickness="1.5">
                        <StackPanel>
                            <TextBlock Text="💰 JAMI SAVDO TUSHUMI" FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                            <TextBlock x:Name="ShiftTotalRevenueText" Text="0 so'm" FontSize="26" FontWeight="Black" Foreground="White" Margin="0,6,0,0" />
                            <TextBlock Text="Barcha to'lovlar bilan" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 2. Naqd Pul -->
                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="18" BorderBrush="#38BDF8" BorderThickness="1.5">
                        <StackPanel>
                            <TextBlock Text="💵 NAQD PUL TUSHUMI" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                            <TextBlock x:Name="ShiftCashRevenueText" Text="0 so'm" FontSize="26" FontWeight="Black" Foreground="White" Margin="0,6,0,0" />
                            <TextBlock Text="Kassada mavjud naqd pul" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 3. Terminal / Karta -->
                    <Border Grid.Column="4" Background="#1E293B" CornerRadius="12" Padding="18" BorderBrush="#A855F7" BorderThickness="1.5">
                        <StackPanel>
                            <TextBlock Text="💳 KARTA / TERMINAL" FontSize="12" FontWeight="Bold" Foreground="#A855F7" />
                            <TextBlock x:Name="ShiftCardRevenueText" Text="0 so'm" FontSize="26" FontWeight="Black" Foreground="White" Margin="0,6,0,0" />
                            <TextBlock Text="Bank terminali orqali" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 4. Cheklar Soni -->
                    <Border Grid.Column="6" Background="#1E293B" CornerRadius="12" Padding="18" BorderBrush="#F59E0B" BorderThickness="1.5">
                        <StackPanel>
                            <TextBlock Text="🧾 JAMI CHEKLAR SONI" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                            <TextBlock x:Name="ShiftOrdersCountText" Text="0 ta" FontSize="26" FontWeight="Black" Foreground="White" Margin="0,6,0,0" />
                            <TextBlock Text="Muvaffaqiyatli buyurtmalar" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tafsilotlar: Xizmat haqi va chegirmalar -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Moliyaviy Qo'shimchalar" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,14" />
                            
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Xizmat haqi tushumi:" FontSize="15" Foreground="#94A3B8" />
                                <TextBlock x:Name="ShiftServiceFeeText" Text="0 so'm" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" />
                            </Grid>
                            
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Mijozlarga berilgan chegirmalar:" FontSize="15" Foreground="#94A3B8" />
                                <TextBlock x:Name="ShiftDiscountsText" Text="0 so'm" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Smenani Yopish va Hisobotlarni Muhrlash" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />
                            <TextBlock Text="Z-Hisobot chiqarilganda kassa smenasi yopiladi, kassa hisoboti serverga uzatiladi va navbatdagi smena uchun nolga tushiriladi." FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,18" />
                            
                            <Button Content="🔒 SMENANI YOPISH VA Z-HISOBOT CHIQARISH" Height="58" FontSize="16" FontWeight="Black"
                                    Style="{StaticResource TouchDangerButton}" Click="OnCloseShiftDirect" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- 6. TAB: PRINTERLAR VA TIZIM SOZLAMALARI               -->
            <!-- ===================================================== -->
            <Grid x:Name="SettingsTab" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,30">
                        <!-- Sarlavha -->
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚙ TARMOQ PRINTERLARI VA TIZIM SOZLAMALARI" FontSize="22" FontWeight="Black" Foreground="White" />
                                <TextBlock Text="Har bir oshxona bo'limi uchun LAN ESC/POS printeri (Port 9100) va Django REST API parametrlarini sozlang" FontSize="14" Foreground="#94A3B8" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 6 ta Bo'lim LAN Printerlari Paneli -->
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="6 ta Bo'lim LAN Printerlari (Port 9100)" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Chap Ustun (Kassa, Shashlik, Somsa) -->
                                    <StackPanel Grid.Column="0">
                                        <!-- Kassa -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🧾 Kassa Printeri:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            <TextBox x:Name="IpKassaBox" Grid.Column="1" Text="192.168.1.100:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,10,0" />
                                            <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchSecondaryButton}" Click="OnTestPrintKassa" />
                                        </Grid>

                                        <!-- Shashlik -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🥩 Shashlikxona:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            <TextBox x:Name="IpShashlikBox" Grid.Column="1" Text="192.168.1.101:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,10,0" />
                                            <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchSecondaryButton}" Click="OnTestPrintShashlik" />
                                        </Grid>

                                        <!-- Somsa -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🥟 Somsaxona:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            <TextBox x:Name="IpSomsaBox" Grid.Column="1" Text="192.168.1.102:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,10,0" />
                                            <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchSecondaryButton}" Click="OnTestPrintSomsa" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- O'ng Ustun (Issiq oshxona, Fast-food, Bar) -->
                                    <StackPanel Grid.Column="2">
                                        <!-- Oshxona -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🍲 Issiq Oshxona:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            <TextBox x:Name="IpKitchenBox" Grid.Column="1" Text="192.168.1.103:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,10,0" />
                                            <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchSecondaryButton}" Click="OnTestPrintKitchen" />
                                        </Grid>

                                        <!-- Fast-Food -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🍔 Fast-Food:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            <TextBox x:Name="IpFastfoodBox" Grid.Column="1" Text="192.168.1.104:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,10,0" />
                                            <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchSecondaryButton}" Click="OnTestPrintFastfood" />
                                        </Grid>

                                        <!-- Bar -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="☕ Bar &amp; Desert:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            <TextBox x:Name="IpBarBox" Grid.Column="1" Text="192.168.1.105:9100" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" Margin="0,0,10,0" />
                                            <Button Grid.Column="2" Content="Sinov Cheki" Height="42" Style="{StaticResource TouchSecondaryButton}" Click="OnTestPrintBar" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Avtomatik tarmoqqa yuborish checkbox -->
                                <CheckBox x:Name="AutoPrintCheck" Content="Buyurtma olinganda avtomatik barcha tegishli bo'lim printerlariga chek yuborish" 
                                          FontSize="14" FontWeight="SemiBold" Foreground="#10B981" Margin="0,12,0,0" IsChecked="True" />
                            </StackPanel>
                        </Border>

                        <!-- Server Manzili va Xizmat Haqini Sozlash -->
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Django Server Manzili va Xizmat Haqini Sozlash" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Django REST API URL:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="ServerUrlBox" Grid.Column="1" Text="http://127.0.0.1:8000" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Xizmat haqi turi:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <ComboBox x:Name="ServiceFeeTypeCombo" Grid.Column="1" Height="42" Background="#0F172A" Foreground="White" BorderBrush="#334155" FontSize="14" Padding="8,4">
                                        <ComboBoxItem Content="Foizli (%)" IsSelected="True" Tag="percent" />
                                        <ComboBoxItem Content="Odam boshiga hisoblash (soʻm)" Tag="per_person" />
                                        <ComboBoxItem Content="Xizmat haqi yoʻq (0%)" Tag="none" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Xizmat haqi miqdori (% yoki soʻm):" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="ServiceFeeValueBox" Grid.Column="1" Text="10" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kassir ismi:" VerticalAlignment="Center" FontSize="15" Foreground="White" />
                                    <TextBox x:Name="CashierNameBox" Grid.Column="1" Text="Jasur Rahimov" Height="42" Padding="8,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="💾 BARCHA SOZLAMALARNI SAQLASH" Height="62" FontSize="18" FontWeight="Black"
                                Style="{StaticResource TouchButtonStyle}" Background="{StaticResource BrandPrimaryBrush}" Click="OnSaveSettingsClick" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>